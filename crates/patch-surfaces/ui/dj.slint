import { Knob } from "knob.slint";
import { StemControls } from "stems.slint";
import { Theme, Label, MockBadge, Tag, SectionHeading, ListRow, Scroll, Slider, Button, Pad, Icon, Meter, MeterScale, MeterKind, MeterStyle, HLine, EmptyState, SearchField, HeaderCell, Host, Panel } from "@patch-ui/patch-ui.slint";


export struct MissionEvent { label: string, stamp: string, progress: float, freeze-progress: float, status: int, preview: bool }


// One part of the track map: where it lies (0…1), its word ("intro",
// "break", …), its rank as a mix spot (0: none) and the characters its
// label needs (to hide a label its part has no room for).
export struct TrackPart { from: float, to: float, word: string, rank: int, chars: int }
// The pre-listen beside a set prep neighbour: who ("after no. 4 Night
// Ferry"), how (key, tempo, energy) and how well ("good", "ok", "far").
export struct PrepFit { label: string, detail: string, verdict: string }

// The favourite mark on a deck: a heart beside the waveform style switch, so
// faint it is nearly hidden until the pointer finds it. Framed like that
// switch on hover; a favourite stays a quiet filled heart.
export component DeckFavourite inherits Rectangle {
    in property <bool> on;
    callback clicked();
    background: touch.has-hover ? Theme.bg : transparent;
    border-width: touch.has-hover ? 1px : 0px;
    border-color: Theme.border-strong;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 10px;
        name: root.on ? "heart-on" : "heart";
        ink: root.on ? Theme.accent.with-alpha(0.7) : touch.has-hover ? Theme.text-bright : Theme.text-faint.with-alpha(0.45);
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export struct DeckItem {
    id: string,
    // Playing only while Cue is held.
    previewing: bool,
    name: string,
    loaded: bool,
    title: string,
    artist: string,
    // The file path. Drawn only when Show track path is on.
    source: string,
    // A favourite; whether it can be one (a file, not a stream).
    favourite: bool,
    can-favourite: bool,
    time: string,
    remaining: string,
    length: string,
    time-s: float,
    duration-s: float,
    progress: float,
    live: bool,
    playing: bool,
    gain-db: string,
    // Tempo and key (from the analysis; "—" until it is done)
    bpm: string,
    bpm-orig: string,
    bpm-sure: bool,
    tempo: float,
    tempo-text: string,
    range-text: string,
    keylock: bool,
    key: string,
    key-name: string,
    key-sure: bool,
    shift-text: string,
    analysing: bool,
    gain-trim: string,
    // The track overview: drawn once per track (Rust), unplayed and played.
    has-wave: bool,
    cue-progress: float,
    mission-bins: [float],
    mission-wave: image,
    mission-wave-compact: image,
    wave-rest: image,
    wave-played: image,
    phrases: [float],
    // The track map (setup `track_map`): its parts, the lane drawn under
    // the overview (solid where the kick plays, dotted where it is out, the
    // mix spots in accent) and one bar's seconds, for the countdown.
    has-map: bool,
    map-lane: image,
    parts: [TrackPart],
    bar-s: float,
    can-sync: bool,
    // DJ EQ knobs (−1 … 1; −1 = kill, 0 = flat) and filter, with readouts
    // Engine deck state (local files): loops, slip, quantize, sync
    native: bool,
    format: string,
    loop-on: bool,
    loop-beats: float,
    loop-text: string,
    loop-from: float,
    loop-to: float,
    slip: bool,
    quantize: bool,
    synced: bool,
    sync-text: string,
    // Hot cues: position 0…1 (−1 = empty) and time
    cues: [float],
    cue-texts: [string],
    eq-high: float,
    eq-mid: float,
    eq-low: float,
    filter: float,
    eq-high-text: string,
    eq-mid-text: string,
    eq-low-text: string,
    filter-text: string,
}

// A deck's levels, apart from its DeckItem: they change every frame, and
// only the meters read them (a change to DeckItem redrew every window
// showing a deck's title: Library, Light DJ, Crossfader).
// A deck's EQ knobs as the engine moves them, every frame (the AI DJ's
// sweeps and cuts show as the hands would make them).
export struct EqKnobs {
    high: float,
    mid: float,
    low: float,
    filter: float,
    high-text: string,
    mid-text: string,
    low-text: string,
    filter-text: string,
}

export struct DeckLevels {
    level-l: float,
    level-r: float,
    peak: float,
    vu: float,
}

export struct LibItem {
    favourite: bool,
    can-favourite: bool,
    played: string,
    played-at: string,
    title: string,
    kind: string,
    detail: string,
    // Where it sits, short (`Music · House/2024`) and as a line that leads
    // with the file name (`harbour.flac  ·  ~/Music/House/2024`).
    place: string,
    path-line: string,
    selected: bool,
    bpm: string,
    key: string,
    lufs: string,
    // Key-compatible and within reach of the playing deck's tempo.
    fits: bool,
    // Where it stands: "ready", "soft" (tempo confirmed, soft beat),
    // "check", "waiting", "failed"; why (soft, check, failed).
    state: string,
    why: string,
    // The measured beat grid: "straight" (long blends are safe), "loose",
    // or "" (not measured yet).
    grid: string,
    // The song's first release year, and this release's when it is later
    // (a re-release, a remix); "" unknown.
    year: string,
    year-re: string,
    // Its genre (the file's tag, else MusicBrainz's); "" unknown.
    genre: string,
}

// A folder or drive in the library, and where its tracks stand.
export struct LibSource {
    name: string,
    // The folder as shown (`~/Music`) and the real path, for browsing.
    place: string,
    path: string,
    connected: bool,
    tracks: int,
    ready: int,
    check: int,
    waiting: int,
    failed: int,
    // Its collection (click to browse it), -1 none yet.
    collection: int,
}

// A drive plugged in that isn't in the library yet.
export struct LibOffer {
    path: string,
    label: string,
}

// One queued track in Light DJ.
export struct QueueItem {
    title: string,
    detail: string,
}

export struct CollectionItem {
    id: int,
    name: string,
    count: int,
    // Active collections lead the list; inactive ones fold away below.
    active: bool,
    // The folder its tracks share (`Music · House`), or empty when they don't.
    place: string,
}

// A collection, and whether the highlighted track is in it.
export struct TrackCollection {
    id: int,
    name: string,
    member: bool,
    // The folder that collection's tracks share, when they share one.
    place: string,
}

// A folder one step inside the place being browsed.
export struct LibFolder {
    path: string,
    label: string,
    count: int,
    // 0 is a folder directly inside its source.
    depth: int,
    // Its own folders are in the list under it.
    expanded: bool,
    // It has folders under it, so the row can open and close.
    expandable: bool,
}

// A sample made from a deck's track, as its sample panel lists it.
export struct SampleRow { name: string, label: string, code: string }

export global DjState {
    // The deck sample maker (x on a deck): which deck shows its panel ("":
    // none), its choices (labels and the chosen index each), the name, a
    // line about what saving makes, the last message, what was made.
    in property <string> sample-deck;
    in property <[string]> sample-whats;
    in property <[string]> sample-whats-short;
    in property <int> sample-what;
    in property <[string]> sample-froms;
    in property <int> sample-from;
    in property <string> sample-from-note;
    in property <int> sample-slices;
    in-out property <string> sample-name;
    in property <string> sample-hint;
    in property <string> sample-length;
    in property <string> sample-message;
    in property <bool> sample-busy;
    in property <bool> sample-ready;
    in property <[SampleRow]> sample-made;
    callback sample-set(string, int);
    callback sample-named(string);
    callback sample-save();
    callback sample-close();
    callback sample-copy(int);
    // What the deck waveform shows (a hash): Rust redraws only on a change.
    in-out property <int> scope-key: -1;
    // A two-player window caches both rendered strips independently.
    in-out property <int> scope-key-b: -1;
    in-out property <int> scope-key-c: -1;
    in-out property <int> scope-key-d: -1;
    in property <bool> mission-available: false;
    in property <[MissionEvent]> mission-a;
    // The decks open on the AI phrase timeline while an AI DJ session runs (the
    // app raises these when a session starts) and on the performance waveform
    // otherwise. The deck's own toggle writes them, so a hand choice sticks.
    in-out property <bool> mission-view-a: false;
    in-out property <bool> mission-view-b: false;
    in property <[MissionEvent]> mission-b;
    in property <DeckItem> deck-a;
    in property <DeckItem> deck-b;
    in property <DeckItem> deck-c;
    in property <DeckItem> deck-d;
    public pure function item(id: string) -> DeckItem { return id == "b" ? self.deck-b : id == "c" ? self.deck-c : id == "d" ? self.deck-d : self.deck-a; }
    public pure function levels(id: string) -> DeckLevels { return id == "b" ? self.levels-b : id == "c" ? self.levels-c : id == "d" ? self.levels-d : self.levels-a; }
    public pure function knobs(id: string) -> EqKnobs { return id == "b" ? self.eq-b : id == "c" ? self.eq-c : id == "d" ? self.eq-d : self.eq-a; }
    public pure function gain(id: string) -> float { return id == "b" ? self.gain-b : id == "c" ? self.gain-c : id == "d" ? self.gain-d : self.gain-a; }
    public pure function pfl(id: string) -> bool { return id == "b" ? self.pfl-b : id == "c" ? self.pfl-c : id == "d" ? self.pfl-d : self.pfl-a; }
    public pure function scope(id: string) -> image { return id == "b" ? self.scope-b : id == "c" ? self.scope-c : id == "d" ? self.scope-d : self.scope-a; }
    public pure function shift(id: string) -> float { return id == "b" ? self.scope-b-shift : id == "c" ? self.scope-c-shift : id == "d" ? self.scope-d-shift : self.scope-a-shift; }
    public pure function scope-beat(id: string) -> float { return id == "b" ? self.scope-b-beat : id == "c" ? self.scope-c-beat : id == "d" ? self.scope-d-beat : self.scope-a-beat; }
    // The Mini Booth's records: beats turned, from the smoothed playhead
    // only (one writer, every frame: the beat phase has two, a wobble on a
    // turning record).
    in property <float> spin-a;
    in property <float> spin-b;
    in property <float> spin-c;
    in property <float> spin-d;
    public pure function spin(id: string) -> float { return id == "b" ? self.spin-b : id == "c" ? self.spin-c : id == "d" ? self.spin-d : self.spin-a; }
    public pure function phase(id: string) -> float { return id == "b" ? self.phase-b : id == "c" ? self.phase-c : id == "d" ? self.phase-d : self.phase-a; }
    public pure function index(id: string) -> int { return id == "b" ? 1 : id == "c" ? 2 : id == "d" ? 3 : 0; }
    public pure function number(id: string) -> int { return id == "b" ? 3 : id == "c" ? 1 : id == "d" ? 4 : 2; }

    // Decks show the file path under the title and artist. Off: title and
    // artist only. The setup switch `show_track_path`.
    in property <bool> show-track-path: false;
    in property <DeckLevels> levels-a;
    in property <DeckLevels> levels-b;
    in property <DeckLevels> levels-c;
    in property <DeckLevels> levels-d;
    // Engine program output, after the mix and master gain.
    in property <float> program-l;
    in property <float> program-r;
    in property <[LibItem]> library;
    // The library's sources, what the librarian does now, drives to add,
    // and the status filter ("all", "ready", "soft", "check", "waiting",
    // "failed").
    in property <[LibSource]> lib-sources;
    in property <string> lib-activity;
    in property <bool> lib-busy;
    in property <[LibOffer]> lib-offers;
    // "+ Collection": the library's own folders, one click each.
    in property <[LibOffer]> folder-offers;
    in property <bool> folder-picking;
    callback collection-choose(bool);
    callback collection-add-folder(string);
    in property <string> lib-state: "all";
    // All, ready, check, waiting, failed, soft (tempo confirmed, soft beat).
    in property <[int]> lib-state-counts: [0, 0, 0, 0, 0, 0];
    callback lib-set-state(string);
    // Smart filters, combinable with the analysis standing and with each other.
    in property <bool> lib-smart-fits;
    in property <bool> lib-smart-fav;
    in property <bool> lib-smart-straight;
    // "" or session, hour, earlier, unplayed.
    in property <string> lib-played;
    in property <bool> lib-fits-live;
    in property <int> lib-fits-n;
    in property <int> lib-fav-n;
    in property <int> lib-straight-n;
    in property <int> lib-unplayed-n;
    in property <int> lib-session-n;
    in property <int> lib-hour-n;
    in property <int> lib-earlier-n;
    // Every track in the library, and the line under the list (this view).
    in property <int> lib-total;
    in property <string> lib-view-line;
    callback lib-smart-toggle(string);
    // A row's heart; favourites to the top of the list (the column's heading).
    callback lib-favourite(int);
    in property <bool> lib-favourites-first;
    callback lib-favourites-first-toggle();
    // The library in one line.
    in property <string> lib-summary;
    // The list shows rows lib-first … of lib-count (the rest aren't built).
    in property <int> lib-count;
    in property <int> lib-first;
    callback lib-scrolled(int, int);
    // This window browses the library from now on (the Mini Booth's load
    // picker: only Library windows fill their rows from the start).
    callback lib-attach();
    callback lib-add-drive(string, string);
    // Browse the tracks under a folder ("" is the whole library).
    in property <string> lib-location;
    in property <string> lib-location-kind;
    in property <string> lib-location-label;
    in property <string> lib-location-name;
    in property <string> lib-location-note;
    in property <string> lib-location-up;
    in property <string> lib-location-up-label;
    // The source whose folders are open in the Where list.
    in property <string> lib-folder-root;
    in property <[LibFolder]> lib-folders;
    callback lib-browse(string);
    callback lib-remove-source(string);
    callback lib-collect-folder(string);
    // The highlighted track's place, the file name with its directory, and when it was played.
    in property <string> lib-cursor-place;
    in property <string> lib-cursor-path;
    in property <string> lib-cursor-played;
    in property <[CollectionItem]> collections;
    // Set preps: collections made while pre-listening, in the order added.
    in property <[CollectionItem]> prep-sets;
    // The set prep `s` adds to, how many tracks it holds, and whether the
    // highlighted track is in it; and whether the list shows a set prep.
    in property <string> prep-target;
    in property <int> prep-target-count;
    in property <bool> prep-has-cursor;
    in property <bool> prep-viewed;
    // The Library's pre-listen (the Player plays it).
    in property <string> prev-title;
    in property <bool> prev-playing;
    in property <float> prev-progress;
    in property <string> prev-time;
    // Where 1 start, 2 drop 1, 3 break, 4 drop 2 and 5 outro fall (0…1), -1 none.
    in property <[float]> prev-marks;
    // The moment playing, by those words ("drop 1").
    in property <string> prev-at;
    in property <string> prev-message;
    // Ask once whether release years may be looked up online.
    in property <bool> lookups-ask;
    // The pre-listen moved to AUX 1 (a deck or the Player plays): what to
    // say, once a run ("" hides it). keep = false: never again.
    in property <string> aux-notice;
    callback aux-notice-answer(/* keep */ bool);
    // Where the pre-listen plays when not on main: "AUX 1", "Headphones".
    in property <string> prev-route;
    // The HUD: artist · genre · years · BPM · key · LUFS; the waveform
    // (rest and played); the parts; the cue key used last (0…4, -1 none)
    // and its word; how it sits in the set prep.
    in property <string> prev-meta;
    in property <image> prev-wave-rest;
    in property <image> prev-wave-played;
    in property <[TrackPart]> prev-parts;
    in property <int> prev-cue: -1;
    in property <string> prev-cue-word;
    in property <string> prev-fit-title;
    in property <[PrepFit]> prev-fits;
    // The HUD (h): shows the pre-listen, or the highlighted track when
    // nothing is pre-listened to. Only shows; no controls of its own.
    in-out property <bool> hud-open;
    in property <string> hud-title;
    // "playing", "paused" or "" (the highlighted track, not playing).
    in property <string> hud-state;
    in property <float> hud-progress;
    // The track's length (seconds): the playhead moves on between pushes.
    in property <float> hud-span;
    // The HUD was opened or its track changed: push it now, not at the
    // next poll.
    callback hud-refresh();
    in property <string> hud-time;
    in property <[float]> hud-marks;
    callback lookups-answer(bool);
    callback preview-toggle();
    callback preview-cue(int);
    callback preview-part(int);
    callback preview-bars(int);
    callback preview-stop();
    callback prep-toggle();
    callback prep-new();
    callback prep-move(int);
    in property <int> collection-selected: -1;
    in property <int> collection-viewed: -1;
    // The collection shown (empty: all tracks), and how many are active.
    in property <string> collection-viewed-name;
    in property <string> collection-viewed-place;
    in property <int> collection-viewed-count;
    in property <bool> collection-viewed-active: true;
    // The AI DJ plays the collection shown in its listed order (else it
    // decides the order). o or the header's buttons change it.
    in property <bool> collection-viewed-in-order;
    callback collection-play-order(/* in order */ bool);
    in property <int> collections-active;
    // Mark a collection active (leads the list) or inactive (folds away).
    callback collection-activate(int, bool);
    in property <int> lib-cursor;
    in property <float> xfader: 0.5;
    in property <bool> mixer-four;
    callback mixer-decks-toggle();
    // The EQ knobs at frame rate from the engine (eq-live: they're set;
    // otherwise the deck items' values show).
    in property <bool> eq-live;
    in property <EqKnobs> eq-a;
    in property <EqKnobs> eq-b;
    in property <EqKnobs> eq-c;
    in property <EqKnobs> eq-d;
    // The crossfader law, drawn in Rust at physical resolution (law.rs),
    // and where it goes (logical size).
    in property <image> law;
    in-out property <length> law-w: 300px;
    in-out property <length> law-h: 120px;
    // What the law image shows (a hash), per window.
    in-out property <int> law-key: -1;
    in property <float> gain-a: 0.909;
    in property <float> gain-b: 0.909;
    in property <float> gain-c;
    in property <float> gain-d;
    in property <string> xfader-text: "A −3.0 · B −3.0 dB";
    in property <string> status;
    // The mixing engine (a separate process; assembly mixing kernel).
    in property <bool> engine-on;
    in property <string> engine-text: "stopped";
    callback power();
    callback toggle(string);
    callback cue(string);
    callback cue-release(string);
    callback seek-by(string, float);
    callback seek-to(string, float);
    /// The scrolling waveform dragged: deck, "start" | "move" | "end", and
    /// seconds from where the drag began.
    callback scrub(string, string, float);
    callback load(string, int);
    callback move-lib(int);
    callback set-filter(string);
    callback collection-create(string);
    callback collection-select(int);
    callback collection-view(int);
    callback collection-add();
    // A folder picker; the folder becomes a collection (named after it).
    callback collection-from-folder();
    // Look through every source again now (new, renamed, removed files).
    callback lib-rescan();
    callback collection-start-set(int);
    // Managing the collection shown: its name, or deleting it. A library
    // folder's own collection says where (deleting it takes the folder out).
    in property <string> collection-viewed-folder;
    callback collection-rename(int, string);
    callback collection-delete(int);
    // The highlighted track and every collection, ticked where it is in:
    // add it (true) or take it out (false), or start a new one with it.
    in property <string> lib-cursor-title;
    in-out property <bool> lib-edit-open;
    in-out property <string> lib-edit-path;
    in property <string> lib-edit-title;
    in property <string> lib-edit-artist;
    in property <string> lib-edit-year;
    in property <string> lib-edit-genre;
    callback lib-edit();
    callback lib-edit-save(string, string, string, string);
    in-out property <bool> lib-grid-editing;
    in-out property <float> lib-grid-bpm;
    in-out property <float> lib-grid-first-beat;
    in-out property <int> lib-grid-downbeat;
    callback lib-grid-edit();
    callback lib-grid-beat-here();
    callback lib-grid-reset();
    callback lib-grid-save(float, float, int);
    in property <[TrackCollection]> track-collections;
    callback track-collection(int, bool);
    callback track-new-collection(string);
    // Audio files picked in the desktop's chooser join the library where
    // they are (and the collection shown).
    callback lib-add-files();
    callback set-xfader(float);
    callback set-gain(string, float);
    callback set-input-trim(string, float);
    in property <[float]> input-trims: [0, 0, 0, 0];
    in property <[float]> input-levels: [0, 0, 0, 0];
    in property <[bool]> input-clips: [false, false, false, false];
    in property <bool> input-meter-live;
    // Tempo and key, per deck
    callback set-tempo(string, float);
    callback tempo-step(string, float);
    callback reset-tempo(string);
    callback cycle-range(string);
    callback toggle-keylock(string);
    callback shift-key(string, int);
    callback sync(string);
    callback nudge(string, float);
    // band: "high" | "mid" | "low"; value −1 … 1
    callback set-eq(string, string, float);
    // Headphones: per-deck CUE (PFL), cue ↔ master blend, level, device.
    in property <bool> pfl-a;
    in property <bool> pfl-b;
    in property <bool> pfl-c;
    in property <bool> pfl-d;
    in property <float> cue-mix: 0;
    in property <float> cue-level: 0;
    in property <string> cue-mix-text: "CUE";
    in property <string> cue-level-text: "0 dB";
    in property <string> phones: "no headphones output";
    in property <bool> phones-on;
    callback toggle-pfl(string);
    callback set-cue-mix(float);
    callback set-cue-level(float);
    callback cycle-phones();
    // Each channel's input selector (the DJM's USB / LINE switch): the
    // application on LINE ("" = the deck), and how many apps a LINE can
    // take now. Clicking the selector steps deck → each app → deck.
    in property <string> line-a;
    in property <string> line-b;
    in property <string> line-c;
    in property <string> line-d;
    in property <int> line-sources;
    callback cycle-line(string);
    // Each channel's crossfader side ("a", "thru", "b") and the curve
    // ("smooth", "mix", "cut"), as the engine has them.
    in property <string> xf-assign-a: "a";
    in property <string> xf-assign-b: "b";
    in property <string> xf-assign-c: "a";
    in property <string> xf-assign-d: "b";
    in property <string> xf-curve: "mix";
    callback set-xf-assign(string, string);
    callback set-xf-curve(string);
    public pure function xf-assign(id: string) -> string { return id == "b" ? self.xf-assign-b : id == "c" ? self.xf-assign-c : id == "d" ? self.xf-assign-d : self.xf-assign-a; }
    public pure function xf-curve-label() -> string { return self.xf-curve == "smooth" ? "Smooth" : self.xf-curve == "cut" ? "Cut" : "Mix"; }
    public pure function xf-curve-next() -> string { return self.xf-curve == "smooth" ? "mix" : self.xf-curve == "mix" ? "cut" : "smooth"; }
    public pure function line(id: string) -> string { return id == "b" ? self.line-b : id == "c" ? self.line-c : id == "d" ? self.line-d : self.line-a; }
    // Loops (beats; 0 = reloop / exit), halve/double, beat jump, slip, quantize
    callback loop(string, float);
    callback loop-scale(string, float);
    callback loop-in(string);
    callback loop-out(string);
    callback jump(string, float);
    callback toggle-slip(string);
    callback toggle-quantize(string);
    // Input: (context, key, shift, ctrl, alt, down) → bound? The keymap
    // (patch-core::input) decides what keys do; widgets don't.
    callback key(string, string, bool, bool, bool, bool) -> bool;
    // Key names the keymap uses for non-text keys.
    public pure function key-name(t: string) -> string {
        if (t == Key.LeftArrow) { return "left"; }
        if (t == Key.RightArrow) { return "right"; }
        if (t == Key.UpArrow) { return "up"; }
        if (t == Key.DownArrow) { return "down"; }
        if (t == Key.Return) { return "enter"; }
        if (t == " ") { return "space"; }
        return t;
    }
    // Hot cue n (0…3): jump, or set when empty; clear with the flag.
    callback hot-cue(string, int, bool);
    // Club Booth pads: pressed (held hot cues play while down) and let go.
    callback hot-cue-press(string, int, bool);
    callback hot-cue-release(string);
    // Beat position (beats since the grid's first beat; −1 = no grid),
    // updated every frame, and "bar.beat".
    in property <float> phase-a: -1;
    in property <float> phase-b: -1;
    in property <float> phase-c: -1;
    in property <float> phase-d: -1;
    in property <string> beat-a;
    in property <string> beat-b;
    in property <string> beat-c;
    in property <string> beat-d;
    public pure function beat-text(id: string) -> string { return id == "b" ? self.beat-b : id == "c" ? self.beat-c : id == "d" ? self.beat-d : self.beat-a; }
    // Scrolling waveforms (rendered in Rust at the heard playhead).
    in property <image> scope-a;
    in property <image> scope-b;
    in property <image> scope-c;
    in property <image> scope-d;
    // The strip (16 s) is shifted by this fraction of its width: the GPU
    // scrolls it between redraws.
    in property <float> scope-a-shift;
    in property <float> scope-b-shift;
    in property <float> scope-c-shift;
    in property <float> scope-d-shift;
    // How the waveforms are drawn ("steps", "smooth", "classic"), and the
    // next style (saved).
    in property <string> scope-style: "classic";
    callback scope-style-next();
    // The heart in the corner of a deck's waveform.
    callback deck-favourite(string);
    // A beat as a fraction of the visible waveform (0 without a grid).
    in property <float> scope-a-beat;
    in property <float> scope-b-beat;
    in property <float> scope-c-beat;
    in property <float> scope-d-beat;
    callback set-deck-filter(string, float);
    in property <bool> auto-gain: true;
    callback toggle-auto-gain();
    // Beat FX: a chain of up to three effects aimed at one deck, locked to
    // its beat grid, on one depth knob. fx-kind is the first; -2 and -3
    // the rest ("" when none); fx-label all of them ("echo+sweep").
    in property <string> fx-kind: "echo";
    in property <string> fx-kind-2;
    in property <string> fx-kind-3;
    in property <string> fx-label: "echo";
    in property <bool> fx-uses-beats: true;
    in property <float> fx-beats: 0.75;
    in property <float> fx-depth: 0.5;
    in property <string> fx-deck: "a";
    in property <bool> fx-on;
    in property <string> fx-text: "echo · ¾ beat · deck A";
    callback fx-kind-set(string);
    // Add an effect to the chain, or take it out.
    callback fx-chain-toggle(string);
    callback fx-beats-set(float);
    callback fx-depth-set(float);
    callback fx-deck-set(string);
    callback fx-toggle();
    // Hold-to-roll (beat repeat) on the FX deck: pressed / released.
    callback fx-roll(float, bool);
    // Light DJ: a view onto the same DJ session (queue, auto-mix, the
    // playing deck) that the Booth shows; it has no state of its own.
    in property <string> now-deck: "a";
    in property <[QueueItem]> queue;
    in property <bool> automix-on;
    in property <string> automix-dir: "hold";
    in property <string> automix-next;
    in property <string> automix-note;
    in property <string> plan-text;
    in property <float> master: 0.909;
    in property <string> master-text: "0.0 dB";
    callback light(string);
    // False while keys can't be a DJ's: just after a Patch window opened
    // (it may have taken the keyboard from what you were typing in), or
    // arriving at typing speed. Every one-key action asks first.
    callback key-guard(string) -> bool;
    callback automix-toggle();
    callback automix-direct(string);
    callback queue-remove(int);
    callback queue-selected();
    callback set-master(float);
    // The AI DJ's set: status line, the log (newest first), words to it.
    in property <bool> set-on;
    // NEXT MIX (an AI DJ set): the next track, its technique, beats to the
    // blend (-1: none planned) or the bar it's in while it runs.
    in property <string> mix-next;
    in property <string> mix-technique;
    in property <int> mix-beats: -1;
    in property <string> mix-bar;
    in property <string> set-text;
    in property <[QueueItem]> set-log;
    in property <string> say-reply;
    callback set-toggle();
    // The AI may play drum swaps in a set (rehearsed first; off by default).
    in property <bool> drum-swaps;
    callback drum-swaps-toggle();
    callback say(string);
    // AI DJ: suggests the next track and how to mix it; prepares the idle
    // deck on request. Only a human runs the mix.
    in property <bool> ai-on;
    in property <string> ai-state: "idle";
    in property <string> ai-title;
    in property <string> ai-detail;
    in property <string> ai-reasons;
    in property <string> ai-direction: "hold";
    // "suggest" | "prepare" | "run" | "off"
    callback ai(string);
    callback ai-direct(string);
    // Auto: prepare the idle deck 45 s before the mix-out point.
    in property <bool> ai-auto;
    callback ai-toggle-auto();
    // Transition timing adjustments: the user nudges the AI DJ to shift
    // the planned transition (sooner/later) or change its length
    // (longer/shorter); the AI decides how much.
    in property <bool> plan-adjustable: false;
    in property <bool> plan-adjusting: false;
    in property <string> plan-feedback: "Choose a small change or the earliest/latest suitable musical opportunity.";
    callback plan-shift(string);
    // Runner-up suggestions; picking one makes it the next track.
    in property <[string]> ai-alternates;
    callback ai-pick(int);
}

// Deck letter, lit while the deck plays.
component DeckBadge inherits Rectangle {
    in property <string> letter;
    in property <bool> lit;
    width: Theme.row-h + Theme.s3;
    height: self.width;
    background: lit ? Theme.accent : Theme.bg-deep;
    border-width: 1px;
    border-color: lit ? Theme.accent : Theme.border-strong;
    Text {
        text: root.letter;
        color: root.lit ? Theme.accent-ink : Theme.text-bright;
        font-family: Theme.font-display;
        font-size: Theme.fs-large;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Tape ruler: the track as a strip of tape with a tick every 15 s (tall at
// every minute, numbered when there is room), the played part shaded and the
// playhead in accent. Click anywhere to seek there.
component TapeRuler inherits Rectangle {
    in property <float> progress;
    in property <float> duration-s;
    in property <bool> labels: true;
    // Waveform overview (two images: unplayed, played) and phrase lines
    // (8 bars, 0…1).
    in property <bool> has-wave;
    in property <image> wave-rest;
    in property <image> wave-played;
    in property <[float]> phrases;
    // The track map: it takes the minute numbers' row (the ticks stay).
    in property <bool> has-map;
    in property <image> map-lane;
    in property <[TrackPart]> parts;
    in property <float> bar-s;
    in property <[float]> cues;
    in property <float> loop-from: -1;
    in property <float> loop-to: -1;
    in property <bool> loop-on;
    callback seek(float);
    property <int> ticks: duration-s > 0 ? Math.min(Math.floor(duration-s / 15), 480) : 0;
    property <length> per-minute: duration-s > 0 ? root.width * 60 / duration-s : 0px;
    // The tape's height when set (the deck: the AI timeline's, so both
    // views draw their waveform in the same band).
    in property <length> band: 0px;
    property <length> tape-h: band > 0 ? band : has-wave && labels ? Theme.row-h * 2 : Theme.row-h;
    property <bool> map-row: root.labels && root.has-map && root.parts.length > 0;
    height: !labels ? tape-h : map-row ? tape-h + 8px + Theme.fs-tiny : tape-h + Theme.fs-tiny + Theme.s2;
    // tape
    Rectangle {
        y: 0;
        height: root.tape-h;
        background: Theme.bg-deeper;
        border-width: 1px;
        border-color: Theme.border;
    }
    // played
    Rectangle {
        x: 0;
        y: 0;
        width: root.width * clamp(root.progress, 0, 1);
        height: root.tape-h;
        background: Theme.text-faint.with-alpha(0.22);
    }
    // waveform: played part brighter, symmetric around the centre line (two
    // images; per frame only the played part's width changes)
    if root.has-wave: Image {
        x: 0;
        y: 2px;
        width: root.width;
        height: root.tape-h - 4px;
        source: root.wave-rest;
        image-fit: fill;
        image-rendering: pixelated;
    }
    if root.has-wave: Rectangle {
        x: 0;
        y: 0;
        width: root.width * clamp(root.progress, 0, 1);
        height: root.tape-h;
        clip: true;
        Image {
            x: 0;
            y: 2px;
            width: root.width;
            height: root.tape-h - 4px;
            source: root.wave-played;
            image-fit: fill;
            image-rendering: pixelated;
        }
    }
    // loop region
    if root.loop-from >= 0 && root.loop-to > root.loop-from: Rectangle {
        x: root.width * root.loop-from;
        width: Math.max(2px, root.width * (root.loop-to - root.loop-from));
        y: 0;
        height: root.tape-h;
        background: root.loop-on ? Theme.accent.with-alpha(0.25) : Theme.accent.with-alpha(0.08);
        border-width: 1px;
        border-color: Theme.accent;
    }
    // hot cues: numbered flags
    for c[i] in root.cues: Rectangle {
        visible: c >= 0;
        x: clamp(root.width * c - 1px, 0px, root.width - 14px);
        y: 0;
        width: 2px;
        height: root.tape-h;
        background: Theme.accent;
        Rectangle {
            x: 0;
            y: 0;
            width: 12px;
            height: 12px;
            background: Theme.accent;
            Text { text: i + 1; color: Theme.bg; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // phrase lines every 8 bars
    for f in root.phrases: Rectangle {
        x: root.width * f;
        y: root.tape-h - 5px;
        width: 1px;
        height: 5px;
        background: Theme.accent.with-alpha(0.7);
    }
    // ticks, hanging from the top edge like a ruler
    for i in root.ticks + 1: Rectangle {
        property <bool> minute: Math.mod(i, 4) == 0;
        x: Math.min(root.width * i * 15 / root.duration-s, root.width - 1px);
        y: 0;
        width: 1px;
        height: minute ? root.tape-h * 0.5 : root.tape-h * 0.25;
        background: minute ? Theme.text-dim : Theme.border-strong;
    }
    // The track map, under the tape: a hairline per part (solid where the
    // kick plays, dotted where it is out, the mix spots in accent) and its
    // word; the part playing counts down its bars.
    if root.map-row: Image {
        x: 0;
        y: root.tape-h + 1px;
        width: root.width;
        height: 4px;
        source: root.map-lane;
        image-fit: fill;
        image-rendering: pixelated;
    }
    if root.map-row: Rectangle {
        y: root.tape-h + 7px;
        height: Theme.fs-tiny;
        // A mix spot's rank: an outlined numeral (hot cues are filled flags).
        for p in root.parts: Rectangle {
            property <bool> here: root.progress >= p.from && root.progress < p.to;
            property <int> left: root.bar-s > 0 ? Math.ceil((p.to - root.progress) * root.duration-s / root.bar-s) : 0;
            property <length> box: p.rank > 0 ? Theme.fs-tiny + 2px : 0px;
            x: root.width * p.from + 2px;
            y: -1px;
            width: Math.max(0px, root.width * (p.to - p.from) - 4px);
            height: Theme.fs-tiny + 2px;
            visible: self.width >= (p.chars + (self.here ? 4 : 0)) * Theme.fs-tiny * 0.62;
            clip: true;
            if p.rank > 0: Rectangle {
                x: 0;
                y: 0;
                width: parent.box;
                height: parent.box;
                border-width: 1px;
                border-color: Theme.accent;
                Text { text: p.rank; color: Theme.accent; font-family: Theme.font; font-size: Theme.fs-tiny * 0.85; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text {
                x: parent.box > 0 ? parent.box + 4px : 0;
                height: parent.height;
                vertical-alignment: center;
                text: parent.here && parent.left > 0 ? p.word + " · " + parent.left : p.word;
                color: parent.here ? Theme.text-bright : p.rank > 0 ? Theme.text-dim : Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.fs-tiny;
                letter-spacing: 1px;
            }
        }
    }
    // minute numbers under the tape
    if root.labels && !root.map-row && root.per-minute >= 26px: Rectangle {
        y: root.tape-h + Theme.s2;
        height: Theme.fs-tiny;
        for m in Math.floor(root.duration-s / 60) + 1: Text {
            x: Math.min(root.per-minute * m, root.width - self.width) - (m == 0 ? 0px : self.width / 2);
            text: m;
            color: Theme.text-faint;
            font-family: Theme.font;
            font-size: Theme.fs-tiny;
        }
    }
    // playhead
    Rectangle {
        x: clamp(root.width * root.progress - 1px, 0px, root.width - 2px);
        y: 0;
        width: 2px;
        height: root.tape-h;
        background: Theme.accent;
    }
    TouchArea {
        height: root.tape-h;
        y: 0;
        mouse-cursor: pointer;
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
    }
}

component MissionTape inherits Rectangle {
    in property <DeckItem> deck;
    in property <[MissionEvent]> events;
    callback seek(float);
    in property <bool> compact;
    in property <bool> mini;
    private property <color> hud-bg: Theme.bg;
    private property <color> hud-ink: Theme.text-bright;
    private property <color> hud-muted: Theme.text-dim;
    private property <bool> holding-playhead: root.events.length > 3 && root.events[3].freeze-progress >= 0;
    private property <float> playhead: self.holding-playhead ? root.events[3].freeze-progress : root.deck.progress;
    height: mini ? 20px : compact ? 56px : 64px;
    background: root.hud-bg;
    clip: true;
    property <length> wave-y: root.mini ? 10px : root.compact ? 46px : 54px;
    property <float> base: root.compact ? 34 : 42;
    property <float> rise: root.compact ? 14 : 20;
    property <string> trajectory: root.compact ? "M 0 34 Q 500 6 1000 34" : "M 0 42 Q 500 2 1000 42";
    // The track's loudness along the rail: faint ahead, lit where played.
    Image { x: 0px; y: 0px; width: root.width; height: root.height; source: root.compact ? root.deck.mission-wave-compact : root.deck.mission-wave; image-fit: fill; colorize: Theme.text-faint.with-alpha(0.4); }
    Rectangle {
        visible: !root.mini; x: 0px; y: 0px; width: root.width * root.playhead; height: root.height; clip: true;
        Image { x: 0px; y: 0px; width: root.width; height: root.height; source: root.compact ? root.deck.mission-wave-compact : root.deck.mission-wave; image-fit: fill; colorize: Theme.accent.with-alpha(0.6); }
    }
    // A broad mission trajectory, with a quieter second arc beneath it.
    Path { visible: !root.mini; y: 5px; width: root.width; height: root.height; viewbox-width: 1000; viewbox-height: root.height / 1px; fit: fill; commands: root.trajectory; stroke: root.hud-muted.with-alpha(0.23); stroke-width: 1px; }
    Path { visible: !root.mini; width: root.width; height: root.height; viewbox-width: 1000; viewbox-height: root.height / 1px; fit: fill; commands: root.trajectory; stroke: root.hud-ink.with-alpha(0.25); stroke-width: 0.8px; }
    Rectangle {
        visible: !root.mini; x: 0px; y: 0px; width: root.width * root.playhead; height: root.height; clip: true;
        Path { x: 0px; y: 0px; width: root.width; height: root.height; viewbox-width: 1000; viewbox-height: root.height / 1px; fit: fill; commands: root.trajectory; stroke: Theme.accent.with-alpha(0.65); stroke-width: 1.2px; }
    }
    // Single-character stage labels stay directly above their actual dots.
    for event[i] in root.events: Text {
        property <float> p: clamp(event.progress, 0, 1);
        visible: !root.mini && !event.preview && i != 0 && event.progress >= 0;
        // Whole pixels: a letter placed at a fraction of one is drawn
        // differently each time the estimate moves, and shimmered.
        x: Math.round(clamp(root.width * self.p - 5px, 0px, root.width - 10px) / 1px) * 1px;
        y: Math.round(Math.max(0px, (root.base - 4 * root.rise * self.p * (1 - self.p)) * 1px - 23px) / 1px) * 1px;
        width: 10px; height: 14px;
        text: i == 0 ? "P" : i == 1 ? "8" : i == 2 ? "M" : "C";
        horizontal-alignment: center; font-family: Theme.font; font-size: 12px;
        color: event.status == 2 ? Theme.warn : event.status == 1 ? Theme.accent : root.hud-muted;
    }
    Rectangle {
        visible: !root.mini && root.deck.loaded;
        x: clamp(root.width * root.deck.cue-progress - 5px, 0px, root.width - 10px);
        y: (root.base - 4 * root.rise * root.deck.cue-progress * (1 - root.deck.cue-progress)) * 1px - 5px;
        width: 10px; height: 10px; border-radius: 5px; border-width: 1.2px; border-color: root.events.length > 0 && root.events[0].status == 1 ? Theme.accent : root.hud-ink; background: root.events.length > 0 && root.events[0].status == 1 ? Theme.accent : root.hud-bg;
    }
    Text {
        visible: !root.mini && root.deck.loaded;
        x: clamp(root.width * root.deck.cue-progress - 5px, 0px, root.width - 10px);
        y: Math.max(0px, (root.base - 4 * root.rise * root.deck.cue-progress * (1 - root.deck.cue-progress)) * 1px - 21px);
        width: 10px; height: 14px; text: "P"; horizontal-alignment: center;
        color: root.events.length > 0 && root.events[0].status == 1 ? Theme.accent : root.hud-ink; font-family: Theme.font; font-size: 12px;
    }
    for event[i] in root.events: Rectangle {
        visible: !event.preview && i != 0 && event.progress >= 0;
        x: Math.round(clamp(root.width * event.progress - 6px, 0px, root.width - 12px) / 1px) * 1px;
        y: Math.round(((root.base - 4 * root.rise * event.progress * (1 - event.progress)) * 1px - 6px) / 1px) * 1px;
        width: 12px; height: 12px; border-radius: 6px; background: root.hud-bg;
    }
    for event[i] in root.events: Rectangle {
        property <float> p: clamp(event.progress, 0, 1);
        visible: !event.preview && i != 0 && event.progress >= 0;
        x: Math.round(clamp(root.width * self.p - 5px, 0px, root.width - 10px) / 1px) * 1px;
        y: root.mini ? 2px : Math.round(((root.base - 4 * root.rise * self.p * (1 - self.p)) * 1px - 5px) / 1px) * 1px;
        width: 10px; height: 10px; border-radius: 5px; border-width: 1.2px;
        border-color: event.status == 2 ? Theme.warn : event.status == 1 ? Theme.accent : root.hud-muted;
        background: event.status == 1 ? Theme.accent : root.hud-bg;
    }
    Rectangle {
        visible: !root.mini && (root.deck.playing || root.holding-playhead);
        x: root.width * root.playhead - 0.5px;
        y: (root.base - 4 * root.rise * root.playhead * (1 - root.playhead)) * 1px - 7px;
        width: 1px; height: 14px; background: Theme.accent;
    }
    Rectangle {
        visible: !root.mini && (root.deck.playing || root.holding-playhead);
        x: root.width * root.playhead - 4px;
        y: (root.base - 4 * root.rise * root.playhead * (1 - root.playhead)) * 1px - 4px;
        width: 8px; height: 8px; transform-rotation: 45deg;
        border-width: 2px; border-color: Theme.accent; background: root.hud-bg;
    }
    if root.events.length == 0: Text { x: Theme.s2; y: root.mini ? 0px : 15px; text: "Auto Mix · awaiting next plan"; color: root.hud-muted; font-family: Theme.font; font-size: Theme.fs-tiny; }

    Text {
        visible: !root.mini; x: 0px; y: root.height - 11px; width: root.width; height: 11px;
        text: "P prepared  ·  8 check  ·  M mix  ·  C complete";
        horizontal-alignment: center; font-family: Theme.font; font-size: 9px; color: root.hud-muted;
        overflow: elide;
    }
    // The canvas keeps its normal cursor; only visible waveform strokes accept seeking.
    TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        property <float> p: clamp(self.mouse-x / self.width, 0, 0.999999);
        property <float> cell: self.p * root.deck.mission-bins.length;
        // Matches overview::render_arc (ARC_STROKE, arc_reach).
        property <float> half: root.deck.mission-bins.length > 0 ? 1 + (root.compact ? 9 : 12) * root.deck.mission-bins[floor(self.cell)] : 0;
        property <bool> wave-hit: root.deck.mission-bins.length > 0 && abs(self.cell - floor(self.cell) - 0.5) <= 0.34 && abs(self.mouse-y / 1px - (root.base - 4 * root.rise * self.p * (1 - self.p))) <= self.half;
        mouse-cursor: self.wave-hit ? pointer : default;
        clicked => { if (self.wave-hit) { root.seek(self.p); } }
    }
    for event[i] in root.events: TouchArea {
        visible: !event.preview && i != 0 && event.progress >= 0;
        x: clamp(root.width * event.progress - 5px, 0px, root.width - 10px);
        y: (root.base - 4 * root.rise * event.progress * (1 - event.progress)) * 1px - 5px;
        width: 10px; height: 10px; mouse-cursor: pointer;
        clicked => { root.seek(event.progress); }
    }
    TouchArea {
        visible: !root.mini && (root.deck.playing || root.holding-playhead);
        x: clamp(root.width * root.playhead - 5px, 0px, root.width - 10px);
        y: (root.base - 4 * root.rise * root.playhead * (1 - root.playhead)) * 1px - 5px;
        width: 10px; height: 10px; mouse-cursor: pointer;
        clicked => { root.seek(root.playhead); }
    }
    TouchArea {
        visible: !root.mini && root.deck.loaded;
        x: clamp(root.width * root.deck.cue-progress - 5px, 0px, root.width - 10px);
        y: (root.base - 4 * root.rise * root.deck.cue-progress * (1 - root.deck.cue-progress)) * 1px - 5px;
        width: 10px; height: 10px; mouse-cursor: pointer;
        clicked => { root.seek(root.deck.cue-progress); }
    }

}

// Tempo fader, vertical like a turntable's: centre detent (0 %), up = faster.
// Drag; double-click resets to 0 %.
component TempoFader inherits Rectangle {
    in property <float> value; // −1 … 1 of the range
    in property <string> range-text;
    callback moved(float);
    callback reset();
    width: 44px;
    property <length> cap-h: 12px;
    property <length> track-y: Theme.fs-tiny + Theme.s2;
    property <length> track-h: root.height - 2 * self.track-y;
    Text { y: 0; width: root.width; text: "+"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: center; }
    Text { y: root.height - Theme.fs-tiny; width: root.width; text: "−"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: center; }
    // groove
    Rectangle { x: (root.width - 4px) / 2; y: root.track-y; width: 4px; height: root.track-h; background: Theme.bg-deeper; border-width: 1px; border-color: Theme.border; }
    // centre detent and quarter marks
    for m in [0.0, 0.25, 0.5, 0.75, 1.0]: Rectangle {
        x: m == 0.5 ? 6px : 12px;
        width: root.width - 2 * self.x;
        y: root.track-y + root.track-h * m;
        height: 1px;
        background: m == 0.5 ? Theme.text-dim : Theme.border-strong;
    }
    // cap
    Rectangle {
        x: 4px;
        width: root.width - 8px;
        height: root.cap-h;
        y: root.track-y + root.track-h * (0.5 - clamp(root.value, -1, 1) / 2) - root.cap-h / 2;
        background: ta.pressed ? Theme.accent : Theme.raised;
        border-width: 1px;
        border-color: ta.pressed || root.value != 0 ? Theme.accent : Theme.text-dim;
        Rectangle { width: parent.width - 8px; height: 1px; background: ta.pressed ? Theme.bg : Theme.text; }
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        moved => {
            if (self.pressed) {
                root.moved(clamp((0.5 - (self.mouse-y - root.track-y) / root.track-h) * 2, -1, 1));
            }
        }
        double-clicked => { root.reset(); }
    }
}

// A deck's sample maker: what to cut (the loop or the beats just played),
// from the mix or a stem, whole or sliced, under what name; enter saves.
// What was made from the track is listed with Tidal code to copy.
component SampleChoice inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> options;
    in property <int> chosen;
    in property <string> note;
    in property <length> label-w: 96px;
    callback picked(int);
    spacing: Theme.s2;
    Label { text: root.label; tone: "dim"; small: true; caps: true; width: root.label-w; }
    for o[i] in root.options: Button {
        compact: true;
        text: o;
        lit: i == root.chosen;
        clicked => { root.picked(i); }
    }
    if root.note != "": Label { text: root.note; tone: "faint"; small: true; horizontal-stretch: 1; }
    if root.note == "": Rectangle { horizontal-stretch: 1; }
}

export component SamplePanel inherits Rectangle {
    in property <string> deck;
    in property <length> deck-width;
    property <bool> narrow: root.deck-width < 720px;
    // Three rows in the waveform's place (a deck window under ~1000 px):
    // the transport and loops stay in view.
    in property <bool> compact;
    property <bool> tight: root.deck-width < 460px;
    property <length> label-w: root.tight ? 36px : root.narrow || root.compact ? 52px : 96px;
    // Narrow: the shorter choices, so no row runs off the edge.
    property <[string]> whats: root.tight ? ["Loop", "1b", "1 bar", "2", "4", "8"]
        : root.narrow ? DjState.sample-whats-short : DjState.sample-whats;
    property <[string]> slices: root.narrow ? ["1", "4", "8", "16"] : ["1 file", "4 slices", "8 slices", "16 slices"];
    property <bool> one-row: root.compact && root.deck-width >= 1500px;
    property <bool> combine-source-and-cut: root.compact && root.deck-width >= 600px;
    background: Theme.bg-deeper;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: root.compact || root.narrow ? Theme.s2 : Theme.s4;
        spacing: root.compact ? Theme.s2 : Theme.s3;
        if !root.compact: HorizontalLayout {
            alignment: root.tight ? start : stretch;
            spacing: Theme.s3;
            Label { text: "SAMPLE · " + root.deck.to-uppercase(); tone: "bright"; small: true; caps: true; horizontal-stretch: 0; }
            if !root.narrow: Label { text: "a sound for Tidal from this deck"; tone: "dim"; small: true; horizontal-stretch: 1; }
            if root.narrow && !root.tight: Rectangle { horizontal-stretch: 1; }
            Button { compact: true; text: "close"; key: "esc"; clicked => { DjState.sample-close(); } }
        }
        HorizontalLayout {
            spacing: Theme.s4;
            SampleChoice {
                label: "What";
                label-w: root.label-w;
                options: root.whats;
                chosen: DjState.sample-what;
                note: "";
                picked(i) => { DjState.sample-set("what", i); }
            }
            if root.one-row: SampleChoice {
                label: "From";
                label-w: 44px;
                options: DjState.sample-froms;
                chosen: DjState.sample-from;
                note: "";
                picked(i) => { DjState.sample-set("from", i); }
            }
            if root.one-row: SampleChoice {
                label: "Cut";
                label-w: 36px;
                options: root.slices;
                chosen: DjState.sample-slices;
                note: "";
                picked(i) => { DjState.sample-set("slices", i); }
            }
        }
        if !root.one-row: HorizontalLayout {
            spacing: Theme.s4;
            SampleChoice {
                label: "From";
                label-w: root.label-w;
                options: DjState.sample-froms;
                chosen: DjState.sample-from;
                note: root.narrow || root.compact ? "" : DjState.sample-from-note;
                picked(i) => { DjState.sample-set("from", i); }
            }
            if root.combine-source-and-cut: SampleChoice {
                label: "Cut";
                label-w: 36px;
                options: root.slices;
                chosen: DjState.sample-slices;
                note: "";
                picked(i) => { DjState.sample-set("slices", i); }
            }
        }
        if !root.combine-source-and-cut: SampleChoice {
            label: "Cut";
            label-w: root.label-w;
            options: root.slices;
            chosen: DjState.sample-slices;
            note: root.narrow ? "" : "slices: a file each, played by n";
            picked(i) => { DjState.sample-set("slices", i); }
        }
        HorizontalLayout {
            alignment: root.tight ? start : stretch;
            spacing: Theme.s3;
            if !root.compact: Label { text: "Name"; tone: "dim"; small: true; caps: true; width: root.label-w; }
            SearchField {
                prompt: root.compact ? "name" : "";
                placeholder: "a name for the sound";
                width: root.tight ? 104px : root.narrow ? 150px : 240px;
                text <=> DjState.sample-name;
                edited(t) => { DjState.sample-named(t); }
                accepted => { DjState.sample-save(); }
                cancelled => { DjState.sample-close(); }
            }
            Button {
                primary: true;
                text: DjState.sample-busy ? "Saving …" : root.narrow ? "Save" : "Save sample";
                key: root.tight ? "" : "enter";
                enabled: DjState.sample-ready && !DjState.sample-busy;
                clicked => { DjState.sample-save(); }
            }
            if !root.tight: Label {
                text: DjState.sample-message != "" ? DjState.sample-message : DjState.sample-hint;
                tone: DjState.sample-message != "" ? "accent" : "dim";
                small: true;
                horizontal-stretch: 1;
            }
            if root.compact: Button { compact: true; text: root.tight ? "" : "close"; key: "esc"; clicked => { DjState.sample-close(); } }
        }
        if root.tight && DjState.sample-message != "": Label { text: DjState.sample-message; tone: "accent"; small: true; }
        if !root.compact: Label { text: DjState.sample-length; tone: "faint"; small: true; }
        // What was made from the track: as much as the room allows.
        if !root.compact && DjState.sample-made.length > 0: HLine {}
        if !root.compact && DjState.sample-made.length > 0: Label { text: "MADE FROM THIS TRACK"; tone: "dim"; small: true; caps: true; }
        if !root.compact && DjState.sample-made.length > 0: Scroll {
            vertical-stretch: 1;
            min-height: Theme.row-h;
            for r[i] in DjState.sample-made: HorizontalLayout {
                padding-right: Theme.s2;
                spacing: Theme.s3;
                height: Theme.row-h;
                Label { text: r.name; width: root.narrow ? 110px : 170px; }
                if !root.narrow: Label { text: r.label; tone: "dim"; small: true; width: 230px; }
                Label { text: r.code; color: Theme.code-word; small: true; horizontal-stretch: 1; }
                Button { compact: true; text: "Copy"; clicked => { DjState.sample-copy(i); } }
            }
        }
        if !root.compact && DjState.sample-made.length == 0: Rectangle { vertical-stretch: 1; }
    }
}

export component DeckSurface inherits Rectangle {
    // The performance waveform is the deck's default view; an AI DJ session
    // raises the phrase timeline (the app sets the flag this is bound to). The
    // toggle below flips the same flag, so a hand choice outlives the session.
    private property <bool> mission-view: deck == "a" ? DjState.mission-view-a : deck == "b" ? DjState.mission-view-b : false;
    in property <string> deck; // "a" | "b"
    property <DeckItem> d: DjState.item(deck);
    property <DeckLevels> lv: DjState.levels(deck);
    property <bool> narrow: self.width < 480px;
    // Compact below the height the full layout needs (big time, title,
    // artist and format, ruler labels, loops, cues and pads).
    property <bool> sample-open: DjState.sample-deck == root.deck;
    property <bool> compact-sample: root.sample-open && root.height < 760px;
    property <bool> short: self.height < (root.compact-sample ? 640px : 560px);
    // Rows that join the compact layout as height allows.
    property <bool> show-loops: root.d.native && self.height >= 340px;
    property <bool> show-cues: !root.d.live && self.height >= 380px;
    property <length> pad-h: short ? Theme.row-h + Theme.s3 : Theme.row-h * 2;
    // Under 620 px the button rows fold (cues 4 + 4, loops over their
    // controls), the pads show icons, the key name goes: nothing runs off.
    property <bool> fold: self.width < 620px;
    init => { keys.focus(); }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (DjState.sample-deck == root.deck && e.text == Key.Escape) { DjState.sample-close(); return accept; }
            if (DjState.sample-deck == root.deck && e.text == Key.Return) { DjState.sample-save(); return accept; }
            // A loop exit must work immediately, even after another deck key.
            if (e.text == "o" && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.repeat) { return accept; }
            } else if (!DjState.key-guard(e.text)) { return reject; }
            if (DjState.key("deck-" + root.deck, DjState.key-name(e.text), e.modifiers.shift, e.modifiers.control, e.modifiers.alt, true)) { return accept; }
            return reject;
        }
        key-released(e) => {
            if (DjState.key("deck-" + root.deck, DjState.key-name(e.text), e.modifiers.shift, e.modifiers.control, e.modifiers.alt, false)) { return accept; }
            return reject;
        }
        if !root.d.loaded: EmptyState {
            title: root.d.name + " is empty";
            detail: "Load a track or station from the Library (a / b), or click Load A / Load B there.";
        }
        // Everything fits from the default height up; a window smaller
        // than the deck needs scrolls (wheel or drag), never clips, and
        // says there is more below.
        if root.d.loaded: Rectangle {
          deck-fl := Flickable {
            // The wheel scrolls; a drag belongs to the knobs (stems turn
            // with a vertical drag, which the Flickable took to scroll).
            interactive: false;
            content-height: Math.max(self.height, body.min-height);
          body := HorizontalLayout {
            height: deck-fl.content-height;
          VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.narrow ? Theme.s4 : Theme.s5;
            padding-right: self.padding-left;
            padding-top: self.padding-left;
            padding-bottom: self.padding-top;
            spacing: root.short ? Theme.s3 : Theme.s4;
            // Everything but the transport, top-aligned; the pads dock at the
            // bottom, so spare height sits between the two.
            VerticalLayout {
                vertical-stretch: 1;
                alignment: stretch;
                spacing: root.short ? Theme.s3 : Theme.s4;
                // 1 · Identity: deck letter, title and artist, state. The file
                // path is a setup switch (off: title and artist only).
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.s4;
                    VerticalLayout { alignment: start; DeckBadge { letter: root.deck.to-uppercase(); lit: root.d.playing; } }
                    if !root.short: VerticalLayout {
                        alignment: center;
                        spacing: Theme.s1;
                        horizontal-stretch: 1;
                        Label { text: root.d.title; tone: "bright"; font-family: Theme.font-display; font-weight: 700; font-size: root.narrow || root.height < 820px ? Theme.fs-large * 1.2 : Theme.fs-title; overflow: elide; }
                        // Always there (a space without an artist): a line that came and went
                        // with each track moved the waveform under it.
                        Label { text: root.d.artist != "" ? root.d.artist : " "; tone: "dim"; small: true; overflow: elide; }
                        if DjState.show-track-path && root.d.source != "": Label { text: root.d.source; tone: "faint"; small: true; overflow: elide; }
                        if root.d.native: Label { text: root.d.format + " · engine" + (root.d.loop-text != "" ? " · " + root.d.loop-text : ""); tone: "dim"; small: true; overflow: elide; }
                    }
                    // Short: title and artist share one line, level with the badge.
                    if root.short: HorizontalLayout {
                        spacing: Theme.s4;
                        horizontal-stretch: 1;
                        Label { text: root.d.title; tone: "bright"; font-family: Theme.font-display; font-weight: 700; font-size: Theme.fs-large; overflow: elide; horizontal-stretch: 2; }
                        if root.d.artist != "": Label { text: root.d.artist; tone: "dim"; small: true; overflow: elide; horizontal-stretch: 1; }
                        if DjState.show-track-path && root.d.source != "": Label { text: root.d.source; tone: "faint"; small: true; overflow: elide; horizontal-stretch: 1; }
                    }
                    VerticalLayout {
                        alignment: start;
                        if !root.d.live: MockBadge { text: root.d.playing ? "PLAYING" : "PAUSED"; subtle: !root.d.playing; }
                    }
                }
                // The deck's stems, under what it plays
                StemControls { deck: root.deck; one-row: root.width >= 720px; }
                // Patch style: time, tempo and key on one panel.
                Panel {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        padding-top: Theme.s2;
                        padding-bottom: Theme.s2;
                        spacing: Theme.s2;
                        // 2 · Time: elapsed large, length, remaining
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.s3;
                            alignment: stretch;
                            Text {
                                text: root.d.time;
                                color: Theme.text-bright;
                                // Monospaced: the running time must not jitter.
                                font-family: Theme.font;
                                font-weight: 700;
                                letter-spacing: root.short ? 0px : -2px;
                                // Full size only where the deck has height to spare.
                                font-size: root.short ? Theme.fs-title : root.height >= 820px ? Theme.fs-hero : Theme.fs-title * 1.4;
                                vertical-alignment: bottom;
                                horizontal-stretch: 0;
                            }
                            if !root.d.live: Text {
                                text: "/ " + root.d.length;
                                color: Theme.text-faint;
                                font-family: Theme.font;
                                font-size: Theme.fs;
                                vertical-alignment: bottom;
                                horizontal-stretch: 0;
                            }
                            if !root.d.live && DjState.beat-text(root.deck) != "": Text {
                                text: "bar " + DjState.beat-text(root.deck);
                                color: Theme.text-dim;
                                font-family: Theme.font;
                                font-size: Theme.fs;
                                vertical-alignment: bottom;
                                horizontal-stretch: 0;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if !root.d.live: Text {
                                text: "−" + root.d.remaining;
                                color: Theme.text-dim;
                                font-family: Theme.font;
                                font-size: root.short ? Theme.fs : Theme.fs-large;
                                vertical-alignment: bottom;
                                horizontal-stretch: 0;
                            }
                        }
                        // 2b · Tempo and key
                        if !root.d.live: HorizontalLayout {
                            vertical-stretch: 0;
                            // Under 720 px the row tightens and drops the key's −/+ ([ ] still
                            // shift it), so it never pushes the deck past its window.
                            spacing: root.width < 720px ? Theme.s3 : Theme.s5;
                            alignment: start;
                            // BPM: effective large, original small
                            HorizontalLayout {
                                spacing: Theme.s2;
                                Text {
                                    min-width: Math.max(bpm-wide0.preferred-width, bpm-wide8.preferred-width);
                                    horizontal-alignment: right;
                                    text: root.d.bpm;
                                    color: root.d.bpm-sure ? Theme.text-bright : Theme.text-dim;
                                    font-family: Theme.font-data;
                                    font-weight: Theme.data-weight;
                                    font-size: root.short ? Theme.fs-large : Theme.fs-title;
                                    vertical-alignment: bottom;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    min-width: root.fold ? 0px : orig-wide.preferred-width;
                                    Label { text: root.d.analysing ? "analysing…" : "BPM"; tone: "faint"; small: true; }
                                    if !root.short && !root.fold: Label { text: root.d.bpm-orig; tone: "faint"; small: true; }
                                }
                            }
                            // Tempo: percent, range, keylock
                            VerticalLayout {
                                alignment: end;
                                spacing: Theme.s1;
                                min-width: tempo-wide.preferred-width;
                                Label { text: root.d.tempo-text; tone: root.d.tempo == 0 ? "dim" : "accent"; }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    Button { text: root.d.range-text; compact: true; clicked => { DjState.cycle-range(root.deck); } }
                                    Button { text: "KEYLOCK"; compact: true; lit: root.d.keylock; clicked => { DjState.toggle-keylock(root.deck); } }
                                }
                            }
                            // Key: Camelot large, name and shift small, transpose
                            HorizontalLayout {
                                spacing: Theme.s2;
                                Text {
                                    min-width: Math.max(key-wide0.preferred-width, key-wide8.preferred-width);
                                    text: root.d.key;
                                    color: root.d.key-sure ? Theme.text-bright : Theme.text-dim;
                                    font-family: Theme.font-data;
                                    font-weight: Theme.data-weight;
                                    font-size: root.short ? Theme.fs-large : Theme.fs-title;
                                    vertical-alignment: bottom;
                                }
                                VerticalLayout {
                                    alignment: end;
                                    min-width: key-name-wide.preferred-width;
                                    Label { text: root.d.shift-text; tone: root.d.shift-text == "" ? "faint" : "accent"; small: true; }
                                    if !root.short && !root.fold: Label { text: root.d.key-name; tone: "faint"; small: true; }
                                }
                                if root.width >= 720px: VerticalLayout {
                                    alignment: end;
                                    HorizontalLayout {
                                        spacing: Theme.s1;
                                        Button { text: "−"; compact: true; clicked => { DjState.shift-key(root.deck, -1); } }
                                        Button { text: "+"; compact: true; clicked => { DjState.shift-key(root.deck, 1); } }
                                    }
                                }
                            }
                            // The widest each value above can read, measured here out
                            // of the layout: its column keeps that width, so a BPM,
                            // pitch or key changing width never moves the row.
                            Rectangle {
                                horizontal-stretch: 1;
                                bpm-wide0 := Text { visible: false; text: "000.00"; font-family: Theme.font-data; font-weight: Theme.data-weight; font-size: root.short ? Theme.fs-large : Theme.fs-title; }
                                bpm-wide8 := Text { visible: false; text: "888.88"; font-family: Theme.font-data; font-weight: Theme.data-weight; font-size: root.short ? Theme.fs-large : Theme.fs-title; }
                                orig-wide := Text { visible: false; text: "orig 000.00"; font-family: Theme.font; font-size: Theme.fs-small; }
                                tempo-wide := Text { visible: false; text: "+00.00 % nudge"; font-family: Theme.font; font-size: Theme.fs; }
                                key-wide0 := Text { visible: false; text: "10B"; font-family: Theme.font-data; font-weight: Theme.data-weight; font-size: root.short ? Theme.fs-large : Theme.fs-title; }
                                key-wide8 := Text { visible: false; text: "12B"; font-family: Theme.font-data; font-weight: Theme.data-weight; font-size: root.short ? Theme.fs-large : Theme.fs-title; }
                                key-name-wide := Text { visible: false; text: "E♭ minor"; font-family: Theme.font; font-size: Theme.fs-small; }
                            }
                            VerticalLayout {
                                alignment: end;
                                Button { text: root.d.synced ? "SYNC ON" : "SYNC"; key: "s"; primary: root.d.synced; enabled: root.d.can-sync; clicked => { DjState.sync(root.deck); } }
                                // Kept when empty: the AI syncs each incoming deck, and the line
                                // appearing pushed the waveform down.
                                Label { text: root.d.sync-text != "" ? root.d.sync-text : " "; tone: "accent"; small: true; }
                            }
                        }
                    }
                }
                // Patch style: the waveform, the overview and the level on one panel.
                Panel {
                    vertical-stretch: 100;
                    VerticalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        padding-top: Theme.s2;
                        padding-bottom: Theme.s2;
                        spacing: Theme.s2;
                        // 3a · Scrolling waveform around the playhead (8 s)
                        // Elastic: it takes spare height up to a modest cap (a
                        // third of the deck, never past 184 px: taller only blew
                        // up the strip) and gives it back first, so the controls
                        // below never clip.
                        if root.compact-sample: SamplePanel {
                            deck: root.deck;
                            compact: true;
                            deck-width: root.width;
                        }
                        if !root.d.live && !root.compact-sample: Rectangle {
                            // Never gone: below this the deck scrolls instead.
                            min-height: root.short ? 44px : 74px;
                            preferred-height: 118px;
                            max-height: Math.min(184px, Math.max(118px, root.height * 0.276));
                            // Far ahead of the spacer below: spare height fills the
                            // waveform up to its cap before anything else grows.
                            vertical-stretch: 100;
                            clip: true;
                            Image {
                                source: DjState.scope(root.deck);
                                image-fit: fill;
                                width: parent.width * 2;
                                height: parent.height;
                                x: -parent.width / 2 + (DjState.shift(root.deck)) * parent.width * 2;
                                // Not quite 1: the renderer snaps an unscaled image
                                // to whole pixels, so the strip moved 3, 4, 4, 3 …
                                // pixels a frame (a fine stutter). Scaled, it is
                                // drawn where it is (the stretch is a third of a
                                // pixel across the strip).
                                transform-scale-x: 1.0001;
                            }
                            // What played, veiled up to the playhead: moves with it
                            // every frame (dimmed in the strip, it changed only when
                            // the strip was redrawn, every few seconds).
                            Rectangle { x: 0; width: parent.width / 2; height: parent.height; background: Theme.bg-deeper; opacity: 0.55; }
                            // The beat being heard, lit on its downbeat and fading
                            // until the next (not in the classic style).
                            property <float> phase: DjState.phase(root.deck);
                            property <float> beat-w: (DjState.scope-beat(root.deck)) * self.width / 1px;
                            property <float> into: self.phase - Math.floor(self.phase);
                            if DjState.scope-style != "classic" && self.beat-w > 0 && self.phase >= 0: Rectangle {
                                x: parent.width / 2 - parent.into * parent.beat-w * 1px;
                                width: parent.beat-w * 1px;
                                height: parent.height;
                                background: Theme.accent;
                                opacity: root.d.playing ? 0.14 * (1 - parent.into) : 0.06;
                            }
                            if DjState.scope-style != "classic" && self.beat-w > 0 && self.phase >= 0: Rectangle {
                                x: parent.width / 2 - parent.into * parent.beat-w * 1px;
                                y: parent.height - 3px;
                                width: parent.beat-w * 1px;
                                height: 3px;
                                background: Theme.accent;
                                opacity: root.d.playing ? 0.35 + 0.65 * (1 - parent.into) : 0.5;
                            }
                            // The playhead: fixed in the middle, over the moving strip.
                            Rectangle { x: parent.width / 2 - 1px; width: 2px; height: parent.height; background: Theme.accent; }
                            // Drag the music like a platter (the strip shows 8 s
                            // across): left moves forward. Rests where released when
                            // paused, so a cue can be set exactly there.
                            TouchArea {
                                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                        DjState.scrub(root.deck, "start", 0);
                                    }
                                    if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                        DjState.scrub(root.deck, "end", 0);
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        DjState.scrub(root.deck, "move", (self.pressed-x - self.mouse-x) / self.width * 8.0);
                                    }
                                }
                            }
                            // The style switch, in the corner.
                            style-switch := Rectangle {
                                x: parent.width - self.width - Theme.s2;
                                y: Theme.s2;
                                width: style-label.preferred-width + 3 * Theme.s2;
                                height: style-label.preferred-height + Theme.s1;
                                background: style-touch.has-hover ? Theme.bg : transparent;
                                border-width: 1px;
                                border-color: style-touch.has-hover ? Theme.border-strong : Theme.border;
                                style-label := Text { x: Theme.s2; y: (parent.height - self.height) / 2; text: DjState.scope-style; color: style-touch.has-hover ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; }
                                style-touch := TouchArea { mouse-cursor: pointer; clicked => { DjState.scope-style-next(); } }
                            }
                            if root.d.can-favourite: DeckFavourite {
                                x: style-switch.x - self.width - Theme.s1;
                                y: style-switch.y;
                                width: self.height;
                                height: style-switch.height;
                                on: root.d.favourite;
                                clicked => { DjState.deck-favourite(root.deck); }
                            }
                        }
                        // 3 · Position
                        // Its row is kept while no session offers the timeline, so a
                        // session starting or ending never moves the waveform.
                        if !root.d.live: Rectangle {
                            height: Theme.fs-tiny + Theme.s2;
                            Text {
                                visible: (root.deck == "a" || root.deck == "b") && DjState.mission-available; text: root.mission-view ? ((root.deck == "a" ? DjState.mission-a : DjState.mission-b)[0].preview ? "AI TIMELINE · PREVIEW ↔ WAVEFORM" : "AI TIMELINE ↔ WAVEFORM") : "WAVEFORM ↔ AI TIMELINE"; color: toggle.has-hover ? Theme.accent : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; }
                            toggle := TouchArea { enabled: (root.deck == "a" || root.deck == "b") && DjState.mission-available; mouse-cursor: pointer; clicked => { if (root.deck == "a") { DjState.mission-view-a = !DjState.mission-view-a; } else { DjState.mission-view-b = !DjState.mission-view-b; } } }
                        }
                        // One slot for the overview and the AI timeline: the
                        // overview's tape is the timeline's height, both drawn from
                        // the top, so switching views (by hand, or when a session
                        // raises the timeline) moves and resizes nothing.
                        if !root.d.live: slot := Rectangle {
                            vertical-stretch: 0;
                            property <bool> mission: DjState.mission-available && root.mission-view;
                            // A tall deck gives its spare height to the overview, modestly
                            // (the scrolling strip keeps its own cap).
                            property <length> mission-h: root.height < 340px ? 20px : root.short ? 56px : clamp(64px + (root.height - 760px) * 0.3, 64px, 120px);
                            height: ruler.height;
                            ruler := TapeRuler {
                                visible: !slot.mission;
                                y: 0;
                                band: slot.mission-h;
                                width: slot.width;
                                has-wave: root.d.has-wave;
                                wave-rest: root.d.wave-rest;
                                wave-played: root.d.wave-played;
                                phrases: root.d.phrases;
                                has-map: root.d.has-map;
                                map-lane: root.d.map-lane;
                                parts: root.d.parts;
                                bar-s: root.d.bar-s;
                                cues: root.d.cues;
                                loop-from: root.d.loop-from;
                                loop-to: root.d.loop-to;
                                loop-on: root.d.loop-on;
                                progress: root.d.progress;
                                duration-s: root.d.duration-s;
                                labels: !root.short;
                                seek(f) => { DjState.seek-to(root.deck, f); }
                            }
                            if slot.mission: MissionTape {
                                y: 0;
                                width: slot.width;
                                compact: root.short;
                                mini: root.height < 340px;
                                deck: root.d;
                                events: root.deck == "a" ? DjState.mission-a : DjState.mission-b;
                                seek(f) => { DjState.seek-to(root.deck, f); }
                            }
                        }
                        if root.d.live: Rectangle {
                            height: Theme.row-h;
                            background: Theme.bg-deeper;
                            border-width: 1px;
                            border-color: Theme.border;
                            Label { text: "live stream · plays in real time, no cue or seek"; tone: "faint"; small: true; }
                        }
                        // 4 · Level: the deck's own stream, same meter as everywhere
                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.s3;
                            // Click the meters to switch their styling (Classic / Banded).
                            Rectangle {
                              horizontal-stretch: 1;
                              VerticalLayout {
                                spacing: Theme.s1;
                                for ch in [{ n: "L", v: root.lv.level-l }, { n: "R", v: root.lv.level-r }]: HorizontalLayout {
                                    spacing: Theme.s3;
                                    height: Theme.fs-tiny + 2px;
                                    Text { text: ch.n; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; width: Theme.fs-tiny; }
                                    VerticalLayout { alignment: center; Meter { kind: MeterKind.System; vertical: false; height: 6px; value: ch.v; peak: root.lv.peak; avg: root.lv.vu; } }
                                }
                              }
                              TouchArea { mouse-cursor: pointer; clicked => { MeterStyle.toggle(); } }
                            }
                            // Auto gain (both decks): its trim when on; click to switch.
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: DjState.auto-gain ? (root.d.gain-trim != "" ? root.d.gain-trim : "auto gain") : "auto gain off";
                                    compact: true;
                                    clicked => { DjState.toggle-auto-gain(); }
                                }
                            }
                            Label { text: root.d.gain-db; tone: "dim"; small: true; vertical-alignment: center; horizontal-alignment: right; width: 64px; }
                        }
                    }
                }
                // Height beyond the waveform's cap stays here, above the
                // pads (the waveform takes spare height first); the sample
                // maker's panel takes it when open (x).
                if !root.sample-open || root.compact-sample: Rectangle { min-height: 0; vertical-stretch: 1; }
                if root.sample-open && !root.compact-sample: SamplePanel {
                    deck: root.deck;
                    deck-width: root.width;
                    min-height: 250px;
                    vertical-stretch: 1;
                }
            }
            // 5b · Loops, beat jump, slip, quantize (engine decks)
            if root.show-loops && root.fold: HorizontalLayout {
                spacing: Theme.s2;
                for b in [0.5, 1, 2, 4, 8, 16]: Button {
                    horizontal-stretch: 1;
                    compact: true;
                    text: b < 1 ? "½" : b;
                    lit: root.d.loop-on && abs(root.d.loop-beats - b) < 0.01;
                    clicked => { DjState.loop(root.deck, b); }
                }
            }
            if root.show-loops && root.fold: HorizontalLayout {
                spacing: Theme.s2;
                Button { horizontal-stretch: 1; compact: true; text: "÷2"; key: "-"; clicked => { DjState.loop-scale(root.deck, 0.5); } }
                Button { horizontal-stretch: 1; compact: true; text: "×2"; key: "="; clicked => { DjState.loop-scale(root.deck, 2.0); } }
                Button { horizontal-stretch: 1; compact: true; text: "SLIP"; key: "z"; lit: root.d.slip; clicked => { DjState.toggle-slip(root.deck); } }
                Button { horizontal-stretch: 1; compact: true; text: "Q"; key: "q"; lit: root.d.quantize; clicked => { DjState.toggle-quantize(root.deck); } }
            }
            if root.show-loops && !root.fold: HorizontalLayout {
                spacing: Theme.s2;
                for b in [0.5, 1, 2, 4, 8, 16]: Button {
                    horizontal-stretch: 1;
                    compact: true;
                    text: b < 1 ? "½" : b;
                    lit: root.d.loop-on && abs(root.d.loop-beats - b) < 0.01;
                    clicked => { DjState.loop(root.deck, b); }
                }
                Button { compact: true; text: "÷2"; key: "-"; clicked => { DjState.loop-scale(root.deck, 0.5); } }
                Button { compact: true; text: "×2"; key: "="; clicked => { DjState.loop-scale(root.deck, 2.0); } }
                // The 4-beat jumps repeat the transport pads below: under
                // 720 px they give the row back its width.
                if root.width >= 720px: Rectangle { width: Theme.s3; }
                if root.width >= 720px: Button { compact: true; text: "◀ 4"; clicked => { DjState.jump(root.deck, -4); } }
                if root.width >= 720px: Button { compact: true; text: "4 ▶"; clicked => { DjState.jump(root.deck, 4); } }
                Rectangle { width: Theme.s3; }
                Button { compact: true; text: "SLIP"; key: "z"; lit: root.d.slip; clicked => { DjState.toggle-slip(root.deck); } }
                Button { compact: true; text: "Q"; key: "q"; lit: root.d.quantize; clicked => { DjState.toggle-quantize(root.deck); } }
            }
            // 5a · Hot cues
            if root.show-cues && !root.fold: HorizontalLayout {
                spacing: Theme.s2;
                for c[i] in root.d.cues: Button {
                    horizontal-stretch: 1;
                    compact: true;
                    key: i + 1;
                    lit: c >= 0;
                    // Eight "set cue" pads alone are 640 px wide: shorter under 760.
                    text: c >= 0 ? root.d.cue-texts[i] : root.width >= 760px ? "set cue" : "set";
                    clicked => { DjState.hot-cue(root.deck, i, false); }
                }
            }
            // Folded: two rows of four.
            for half in (root.show-cues && root.fold ? [0, 4] : []): HorizontalLayout {
                spacing: Theme.s2;
                for k in 4: Button {
                    horizontal-stretch: 1;
                    compact: true;
                    key: half + k + 1;
                    lit: root.d.cues[half + k] >= 0;
                    text: root.d.cues[half + k] >= 0 ? root.d.cue-texts[half + k] : "set";
                    clicked => { DjState.hot-cue(root.deck, half + k, false); }
                }
            }
            // 5 · Transport: equal pads across the full width
            HorizontalLayout {
                spacing: Theme.s2;
                Pad {
                    height: root.pad-h;
                    text: root.d.playing ? "Pause" : "Play";
                    icon: root.d.playing ? "pause" : "play";
                    key: "space";
                    active: root.d.playing;
                    show-label: !root.fold;
                    horizontal-stretch: 2;
                    clicked => { DjState.toggle(root.deck); }
                }
                // Hold on the cue point to preview; release returns (CDJ).
                Pad { height: root.pad-h; text: "Cue"; icon: "cue"; key: "c"; enabled: !root.d.live; show-label: !root.fold; active: root.d.previewing; down => { DjState.cue(root.deck); } up => { DjState.cue-release(root.deck); } }
                // Engine decks jump 4 beats (phase kept); streams seek 10 s.
                Pad { height: root.pad-h; text: root.d.native ? "4 beats" : "10 s"; icon: "back"; key: "←"; enabled: !root.d.live; show-label: !root.fold; clicked => { DjState.jump(root.deck, -4); } }
                Pad { height: root.pad-h; text: root.d.native ? "4 beats" : "10 s"; icon: "fwd"; key: "→"; enabled: !root.d.live; show-label: !root.fold; clicked => { DjState.jump(root.deck, 4); } }
            }
          }
          // 6 · Tempo fader along the right edge, as on a deck
          if !root.d.live: VerticalLayout {
            padding-top: root.narrow ? Theme.s4 : Theme.s5;
            padding-bottom: self.padding-top;
            padding-right: Theme.s3;
            spacing: Theme.s2;
            TempoFader {
                vertical-stretch: 1;
                value: root.d.tempo;
                range-text: root.d.range-text;
                moved(v) => { DjState.set-tempo(root.deck, v); }
                reset => { DjState.reset-tempo(root.deck); }
            }
            Text { text: root.d.range-text; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: center; width: 44px; }
          }
        }
          }
          if deck-fl.content-height > deck-fl.height + 1px
              && deck-fl.content-y > deck-fl.height - deck-fl.content-height + 4px: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Theme.s2;
            width: more-label.preferred-width + 2 * Theme.s3;
            height: more-label.preferred-height + Theme.s2;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: 4px;
            more-label := Text { text: "▾ scroll for more · or enlarge the window"; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-tiny; }
          }
        }
    }
}

// Long-throw channel fader: a recessed groove with unity (0 dB) marked, and
// a cap with a centre line, like a console fader. Drag, or double-click for
// unity.
component FaderTrack inherits Rectangle {
    in property <float> value;
    callback moved(float);
    width: 32px;
    property <length> cap-h: 16px;
    property <length> travel: self.height - cap-h;
    // groove
    Rectangle { x: (parent.width - 4px) / 2; width: 4px; background: Theme.bg-deeper; border-width: 1px; border-color: Theme.border; }
    // unity mark
    Rectangle { x: 0; y: root.cap-h / 2 + root.travel * (1 - 60 / 66); width: 6px; height: 1px; background: Theme.text-faint; }
    Rectangle { x: parent.width - 6px; y: root.cap-h / 2 + root.travel * (1 - 60 / 66); width: 6px; height: 1px; background: Theme.text-faint; }
    // cap: a jump slides (under the hand it follows at once)
    Rectangle {
        y: root.travel * (1 - clamp(root.value, 0, 1));
        animate y { duration: ta.pressed ? 0ms : 90ms; easing: ease-out; }
        height: root.cap-h;
        // Patch style: a solid Paper cap with a dark centre line.
        border-radius: 2px;
        background: ta.pressed ? Theme.accent : ta.has-hover ? Theme.text-bright : Theme.text;
        Rectangle { y: (parent.height - 2px) / 2; height: 2px; background: Theme.bg-deeper; }
    }
    ta := TouchArea {
        mouse-cursor: ns-resize;
        moved => { if (self.pressed) { root.moved(clamp(1 - (self.mouse-y - root.cap-h / 2) / root.travel, 0, 1)); } }
        double-clicked => { root.moved(60 / 66); }
    }
}

// One deck's position in the bar: four beat cells, the current one lit,
// and a marker moving through it. Two lanes, one above the other, show at
// a glance whether the decks are in phase.
component PhaseLane inherits HorizontalLayout {
    in property <string> letter;
    in property <float> phase; // beats; −1 = no grid
    spacing: Theme.s2;
    height: 10px;
    Text { text: root.letter; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; width: 12px; vertical-alignment: center; }
    Rectangle {
        horizontal-stretch: 1;
        property <int> beat: root.phase < 0 ? -1 : Math.mod(Math.floor(root.phase), 4);
        property <float> frac: root.phase < 0 ? 0 : root.phase - Math.floor(root.phase);
        for i in 4: Rectangle {
            x: parent.width * i / 4 + 1px;
            width: parent.width / 4 - 2px;
            height: parent.height;
            background: i == parent.beat ? (i == 0 ? Theme.accent : Theme.text-dim) : Theme.bg-deeper;
            border-width: 1px;
            border-color: Theme.border;
        }
        if root.phase >= 0: Rectangle {
            x: parent.width * (parent.beat + parent.frac) / 4 - 1px;
            width: 2px;
            height: parent.height;
            background: Theme.text-bright;
        }
    }
}

// Rotary knob: drag up/down, double-click resets. Bipolar: the arc runs from
// 12 o'clock to the pointer, lit when away from the centre.
// The deck's EQ column: HIGH, MID, LOW and the filter.
// The deck's input trim (the GAIN knob of a club mixer): ±24 dB before
// the EQ, the same control as the Club Booth's. Double-click: 0 dB.
component TrimKnob inherits Knob {
    in property <string> deck;
    property <float> db: DjState.input-trims[DjState.index(root.deck)];
    label: "TRIM";
    value: root.db / 24;
    readout: (round(root.db * 10) > 0 ? "+" : "") + (round(root.db * 10) / 10 + 0) + " dB";
    moved(v) => { DjState.set-input-trim(root.deck, v); }
}

// The crossfader law, drawn: deck A's gain (falling) and deck B's (rising)
// across the throw, with the current position and the two gains it gives.
component LawView inherits Rectangle {
    in property <float> pos;
    background: Theme.bg-deep;
    border-width: 1px;
    border-color: Theme.border;
    // The plot is inset so the A and B labels sit clear of the curves.
    property <length> inset: Theme.s5;
    property <length> plot-w: self.width - 2 * inset;
    property <length> px: inset + plot-w * clamp(pos, 0, 1);
    // Curves and the −3 dB line: an anti-aliased image of the engine's law.
    init => { DjState.law-w = self.width; DjState.law-h = self.height; }
    changed width => { DjState.law-w = self.width; }
    changed height => { DjState.law-h = self.height; }
    Image { source: DjState.law; width: parent.width; height: parent.height; image-fit: fill; }
    // Position and the two gains are drawn in the image (law.rs).
    Text { x: (root.inset - self.width) / 2; y: (parent.height - self.height) / 2; text: "A"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; }
    Text { x: parent.width - (root.inset + self.width) / 2; y: (parent.height - self.height) / 2; text: "B"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; }
}

// Hardware-style crossfader: a wide slot with a centre detent and a tall cap.
// Click or drag to move, double-click to centre.
component XFader inherits Rectangle {
    in property <float> value;
    // The throw starts and ends this far in (the law's plot inset: the cap
    // centre then sits on the law's position line).
    in property <length> inset: self.cap-w / 2;
    callback moved(float);
    height: Theme.row-h + Theme.s3;
    in property <length> cap-w: 14px;
    // Over the law: a hairline slot within the plot, the curve showing.
    in property <bool> light;
    property <length> travel: self.width - 2 * inset;
    // Under the hand the cap follows the mouse at once, not the engine's
    // echo of it.
    property <float> drag;
    property <float> shown: ta.pressed ? root.drag : root.value;
    // slot
    Rectangle {
        x: root.light ? root.inset : 0;
        width: root.light ? root.travel : parent.width;
        y: (parent.height - self.height) / 2;
        height: root.light ? 2px : 6px;
        background: root.light ? Theme.border-strong : Theme.bg-deeper;
        border-width: root.light ? 0 : 1px;
        border-color: Theme.border;
    }
    // centre detent
    Rectangle { x: (parent.width - 1px) / 2; width: 1px; y: 0; height: parent.height; background: Theme.border-strong; }
    // cap
    Rectangle {
        x: root.inset + root.travel * clamp(root.shown, 0, 1) - root.cap-w / 2;
        // A jump slides, quick enough that a tease's stabs still read.
        animate x { duration: ta.pressed ? 0ms : 60ms; easing: ease-out; }
        width: root.cap-w;
        background: ta.pressed ? Theme.accent : ta.has-hover ? Theme.text-bright : Theme.text;
        Rectangle { x: (parent.width - 2px) / 2; width: 2px; y: 5px; height: parent.height - 10px; background: Theme.bg-deeper; }
    }
    ta := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag = clamp((self.mouse-x - root.inset) / root.travel, 0, 1);
                root.moved(root.drag);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = clamp((self.mouse-x - root.inset) / root.travel, 0, 1);
                root.moved(root.drag);
            }
        }
        double-clicked => { root.moved(0.5); }
    }
}

// ── The console: a two-channel club mixer ─────────────────────────────
// Mirrored channels around a centre spine (row names once, each deck's
// value beside them; the meter bridge, master and phones between the
// faders), the crossfader with its law behind the slot, Beat FX as one
// strip.

// A segmented meter (LED ladder): lit up to the level, the hot top in
// accent, the peak held as one bright segment.
component LedMeter inherits Rectangle {
    in property <float> value;
    in property <float> peak: -1;
    in property <MeterKind> kind: MeterKind.Performance;
    /// Classic style: where the accent segments start (−1 dBFS). Patch style:
    /// where Amber starts, −6 dB.
    in property <float> hot: MeterStyle.patch-style ? (root.kind == MeterKind.Performance ? 0.6 : 0.68) : 0.9;
    in property <bool> vertical: true;
    property <length> span: root.vertical ? self.height : self.width;
    // LED style: whole-pixel segments, 5 px lit and 5 px dark — 8 and 16 device
    // pixels at a 1.6 display scale, which is what makes the ladder even (3 px
    // on a 6 px pitch was 4.8 and 9.6, so one segment in five covered four rows
    // and the blocks looked like different heights). Same unit as the shared
    // Meter, so the deck and crossfader ladders match; the others keep their
    // ladder.
    // Classic and Banded: the same 10 px pitch, on whole physical pixels
    // with a 2 px gap (a fractional pitch with a 1 px gap blurred every
    // edge, and the ladder shimmered as it moved).
    property <int> n: Math.max(4, Math.floor(self.span / 10px));
    property <length> seg: MeterStyle.led ? 10px : Math.floor(self.span / self.n / 1phx) * 1phx;
    property <length> gap: Math.max(1, Math.round(2px / 1phx)) * 1phx;
    // No hold segment for silence.
    property <int> peak-i: root.peak <= 0.02 ? -1 : Math.min(root.n - 1, Math.floor(root.peak * root.n));
    // Classic, upright: two images Rust renders once per size and colour
    // (unlit, lit), the lit one clipped to the level, and the held peak as
    // one bright segment. A few items a meter, not one bound rectangle a segment
    // (those cost the shared UI thread most of a core).
    property <bool> imaged: !MeterStyle.led && !MeterStyle.banded && root.vertical;
    property <int> lit-n: Math.max(0, Math.min(root.n, Math.floor(root.value * root.n + 0.5)));
    property <int> wp: Math.max(1, Math.round(root.width / 1phx));
    property <int> hp: Math.max(1, Math.floor(root.height / 1phx));
    property <int> pp: Math.round(root.seg / 1phx);
    property <int> gp: Math.round(root.gap / 1phx);
    property <length> base: Math.floor(root.height / 1phx) * 1phx;
    if root.imaged: Image {
        width: root.wp * 1phx;
        height: root.hp * 1phx;
        image-fit: fill;
        image-rendering: pixelated;
        source: MeterStyle.ladder(root.wp, root.hp, root.n, root.pp, root.gp, root.hot, MeterStyle.patch-style ? Theme.level.with-alpha(0.07) : Theme.raised, MeterStyle.patch-style ? Theme.level-warn.with-alpha(0.07) : Theme.accent.with-alpha(0.12));
    }
    if root.imaged: Rectangle {
        y: root.base - root.lit-n * root.seg;
        width: root.width;
        height: root.lit-n * root.seg;
        clip: true;
        Image {
            y: -parent.y;
            width: root.wp * 1phx;
            height: root.hp * 1phx;
            image-fit: fill;
            image-rendering: pixelated;
            source: MeterStyle.ladder(root.wp, root.hp, root.n, root.pp, root.gp, root.hot, MeterStyle.patch-style ? Theme.level : Theme.text-dim, MeterStyle.patch-style ? Theme.level-warn : Theme.accent);
        }
    }
    if root.imaged && root.peak-i >= 0: Rectangle {
        y: root.base - (root.peak-i + 1) * root.seg;
        width: root.width;
        height: root.seg - root.gap;
        background: Theme.text-bright;
    }
    if !root.imaged: Rectangle {
      width: root.width;
      height: root.height;
      for i in root.n: Rectangle {
        property <bool> on: (i + 0.5) / root.n <= root.value;
        property <float> p: (i + 0.5) / root.n;
        property <bool> hot-seg: self.p > root.hot;
        property <float> b1: root.kind == MeterKind.Performance ? 0.4 : 0.44;
        property <float> b2: root.kind == MeterKind.Performance ? 0.7 : 0.68;
        property <float> b3: root.kind == MeterKind.Performance ? 0.8 : 0.95;
        property <float> b4: root.kind == MeterKind.Performance ? 0.9 : 1.0;
        x: root.vertical ? 0 : i * root.seg;
        y: root.vertical ? Math.floor(root.height / 1phx) * 1phx - (i + 1) * root.seg : 0;
        height: root.vertical ? (MeterStyle.led ? 5px : Math.max(1phx, root.seg - root.gap)) : root.height;
        width: root.vertical ? root.width : (MeterStyle.led ? 5px : Math.max(1phx, root.seg - root.gap));
        background: i == root.peak-i ? Theme.text-bright
            : MeterStyle.led ? (self.p >= (root.kind == MeterKind.Performance ? 0.9 : 0.95) ? MeterStyle.led-red : self.p >= self.b2 ? MeterStyle.led-amber : MeterStyle.led-green).with-alpha(self.on ? 1.0 : 0.13)
            : !MeterStyle.banded && MeterStyle.patch-style ? (self.on ? (self.hot-seg ? Theme.level-warn : Theme.level) : (self.hot-seg ? Theme.level-warn.with-alpha(0.07) : Theme.level.with-alpha(0.07)))
            : !MeterStyle.banded ? (self.on ? (self.hot-seg ? Theme.accent : Theme.text-dim) : (self.hot-seg ? Theme.accent.with-alpha(0.12) : Theme.raised))
            : self.on ? (self.p < self.b1 ? Theme.text-faint : self.p < self.b2 ? Theme.text-dim : self.p < self.b3 ? (root.kind == MeterKind.Performance ? Theme.text : Theme.warn) : self.p < self.b4 ? (root.kind == MeterKind.Performance ? Theme.warn : Theme.error) : Theme.error)
            : Theme.raised;
      }
    }
    Rectangle { visible: MeterStyle.banded && root.kind == MeterKind.Performance; x: 0; y: root.height * 0.2; width: root.width; height: 1px; background: Theme.text-bright.with-alpha(0.75); }
}

// The crossfader curve: click for the next (Smooth, Mix, Cut).
export component XfCurveButton inherits Button {
    text: "Curve " + DjState.xf-curve-label();
    compact: true;
    clicked => { DjState.set-xf-curve(DjState.xf-curve-next()); }
}

component MixerDeckMode inherits Button {
    text: DjState.mixer-four ? "4 decks" : "2 decks";
    key: "4";
    compact: true;
    clicked => { DjState.mixer-decks-toggle(); }
}

// ── The Crossfader (Patch style, after the reference designs) ─────────
// MASTER, BEAT and NEXT MIX across the top; one panel per deck (C A B D):
// the track, TRIM, HI MID LOW, FILTER and CUE, the fader with its scale
// and meters, and the crossfader side it plays on; BEAT FX, PFL and BOOTH
// beside the decks when the window is wide, else under them; the
// crossfader closes the unit. Narrow or short: each deck is a row.

// The booth output's volume on a knob centred on unity (0 dB at 12
// o'clock, the arc shows cut or boost): drawn from the bottom, 0 dB at 91 %
// of the throw read as a meter stuck at full.
export global BoothKnob {
    out property <float> unity: 60 / 66;
    public pure function to-knob(m: float) -> float {
        return m >= self.unity ? (m - self.unity) / (1 - self.unity) : (m - self.unity) / self.unity;
    }
    public pure function from-knob(v: float) -> float {
        return clamp(v >= 0 ? self.unity + v * (1 - self.unity) : self.unity + v * self.unity, 0, 1);
    }
}

// A panel's heading: "— BEAT FX — echo+sweep", tracked caps, then any
// controls it is given.
component PanelHead inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    min-height: 20px;
    spacing: Theme.s2;
    Text { text: "—"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; horizontal-stretch: 0; }
    Text { text: root.text; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-tiny; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 0; }
    if root.detail != "": Text { text: "— " + root.detail; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
    if root.detail == "": Rectangle { horizontal-stretch: 1; }
    @children
}

// A deck's letter in a box; filled while the deck plays.
// A channel's input selector: DECK or LINE (an application). Shown while
// an application could be taken, or one is.
export component SourceChip inherits Rectangle {
    in property <string> deck;
    property <bool> on: DjState.line(root.deck) != "";
    visible: root.on || DjState.line-sources > 0;
    horizontal-stretch: 0;
    width: self.visible ? chip-t.preferred-width + 2 * Theme.s2 : 0px;
    height: 18px;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: chip-ta.has-hover ? Theme.text-faint : root.on ? Theme.text-dim : Theme.border-strong;
    chip-t := Text {
        x: Theme.s2;
        text: root.on ? "LINE" : "DECK";
        color: root.on ? Theme.text-bright : Theme.text-dim;
        font-family: Theme.font;
        font-size: Theme.fs-tiny;
        font-weight: root.on ? 700 : 400;
        letter-spacing: 1px;
        vertical-alignment: center;
    }
    chip-ta := TouchArea { mouse-cursor: pointer; clicked => { DjState.cycle-line(root.deck); } }
}

// A channel's crossfader assign (a club mixer's switch): A, THRU or B.
component XfAssignSwitch inherits HorizontalLayout {
    in property <string> deck;
    property <string> now: DjState.xf-assign(root.deck);
    spacing: 2px;
    horizontal-stretch: 0;
    for side in [{ id: "a", t: "A" }, { id: "thru", t: "THRU" }, { id: "b", t: "B" }]: Rectangle {
        property <bool> on: root.now == side.id;
        width: seg-t.preferred-width + 2 * Theme.s2;
        height: 16px;
        border-radius: Theme.r-control;
        background: self.on ? Theme.text-bright : transparent;
        border-width: 1px;
        border-color: self.on ? Theme.text-bright : seg-ta.has-hover ? Theme.text-faint : Theme.border-strong;
        seg-t := Text {
            text: side.t;
            color: parent.on ? Theme.bg : Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.fs-tiny;
            font-weight: parent.on ? 700 : 400;
            letter-spacing: 1px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea { mouse-cursor: pointer; clicked => { DjState.set-xf-assign(root.deck, side.id); } }
    }
}

component LetterBox inherits Rectangle {
    in property <string> letter;
    in property <bool> lit;
    width: 20px;
    height: 20px;
    border-radius: 2px;
    background: root.lit ? Theme.accent : transparent;
    border-width: 1px;
    border-color: root.lit ? Theme.accent : Theme.border-strong;
    Text {
        text: root.letter;
        color: root.lit ? Theme.accent-ink : Theme.text-bright;
        font-family: Theme.font;
        font-size: Theme.fs-small;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A knob on one line: its name, the dial, its value.
export component KnobInline inherits HorizontalLayout {
    in property <string> label;
    in property <string> readout;
    in property <float> value;
    in property <bool> unipolar;
    in property <float> reset-value: 0;
    in property <bool> live: true;
    callback moved(float);
    spacing: Theme.s2;
    Text { text: root.label; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; letter-spacing: 1.5px; vertical-alignment: center; horizontal-stretch: 0; }
    Knob { bare: true; size: 24px; value: root.value; unipolar: root.unipolar; reset-value: root.reset-value; live: root.live; moved(v) => { root.moved(v); } }
    // A fixed width: a changing value never moves what follows it.
    Text { text: root.readout; color: Theme.text; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; width: 56px; overflow: elide; horizontal-stretch: 0; }
}

// One deck's channel, upright.
component XStrip inherits Panel {
    in property <string> deck;
    in property <length> knob: 28px;
    // The knobs' column: wide enough for their values ("−12.0 dB").
    in property <length> knob-col: 54px;
    // Room for the dB scale beside the meters.
    in property <bool> scale: true;
    // Tall windows: the club mixer's channel (Pioneer DJM-style): the meter
    // beside TRIM, HI, MID and LOW, a larger FILTER (COLOR) under them,
    // CUE, then the fader centred at the bottom.
    in property <bool> tall;
    property <DeckItem> d: DjState.item(root.deck);
    property <DeckLevels> lv: DjState.levels(root.deck);
    property <EqKnobs> k: !DjState.eq-live ? { high: root.d.eq-high, mid: root.d.eq-mid, low: root.d.eq-low, filter: root.d.filter, high-text: root.d.eq-high-text, mid-text: root.d.eq-mid-text, low-text: root.d.eq-low-text, filter-text: root.d.filter-text } : DjState.knobs(root.deck);
    property <bool> left: root.deck == "a" || root.deck == "c";
    // One scale whatever the meter style (it switched ranges with Banded).
    property <MeterKind> mk: MeterKind.Performance;
    VerticalLayout {
        Rectangle {
            height: 26px;
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s2;
                VerticalLayout { alignment: center; LetterBox { letter: root.deck.to-uppercase(); lit: root.d.playing; } }
                Text { text: DjState.line(root.deck) != "" ? DjState.line(root.deck) : root.d.loaded ? root.d.title : DjState.line-sources > 0 ? "" : "empty"; color: DjState.line(root.deck) != "" || root.d.loaded ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                VerticalLayout { alignment: center; SourceChip { deck: root.deck; } }
                Text { text: root.d.gain-db; color: Theme.text; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; horizontal-stretch: 0; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.s3;
            spacing: Theme.s2;
            if !root.tall: Button { text: "CUE"; compact: true; vertical-stretch: 0; primary: DjState.pfl(root.deck); clicked => { DjState.toggle-pfl(root.deck); } }
            // TRIM, HI, MID, LOW and FILTER in one column beside the fader,
            // which runs the strip's full height: the fader on the outer
            // edge (C and A left, B and D right), the knobs towards the
            // middle.
            if !root.tall: HorizontalLayout {
                vertical-stretch: 1;
                spacing: Theme.s2;
                if root.left: FaderTrack { value: DjState.gain(root.deck); moved(v) => { DjState.set-gain(root.deck, v); } }
                if root.left: LedMeter { kind: root.mk; width: 6px; value: root.lv.level-l; peak: root.lv.peak; }
                if root.left: LedMeter { kind: root.mk; width: 6px; value: root.lv.level-r; peak: root.lv.peak; }
                if root.left && root.scale: MeterScale { width: 24px; kind: root.mk; }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    width: root.knob-col;
                    alignment: space-between;
                    TrimKnob { deck: root.deck; titled: true; size: root.knob; }
                    Knob { titled: true; size: root.knob; label: "HI"; value: root.k.high; readout: root.k.high-text; moved(v) => { DjState.set-eq(root.deck, "high", v); } }
                    Knob { titled: true; size: root.knob; label: "MID"; value: root.k.mid; readout: root.k.mid-text; moved(v) => { DjState.set-eq(root.deck, "mid", v); } }
                    Knob { titled: true; size: root.knob; label: "LOW"; value: root.k.low; readout: root.k.low-text; moved(v) => { DjState.set-eq(root.deck, "low", v); } }
                    Knob { titled: true; size: root.knob; label: "FILTER"; filter: true; value: root.k.filter; readout: root.k.filter-text; moved(v) => { DjState.set-deck-filter(root.deck, v); } }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.left && root.scale: MeterScale { width: 24px; kind: root.mk; }
                if !root.left: LedMeter { kind: root.mk; width: 6px; value: root.lv.level-l; peak: root.lv.peak; }
                if !root.left: LedMeter { kind: root.mk; width: 6px; value: root.lv.level-r; peak: root.lv.peak; }
                if !root.left: FaderTrack { value: DjState.gain(root.deck); moved(v) => { DjState.set-gain(root.deck, v); } }
            }
                    if root.tall: HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.s2;
                alignment: center;
                LedMeter { kind: root.mk; width: 6px; value: root.lv.level-l; peak: root.lv.peak; }
                LedMeter { kind: root.mk; width: 6px; value: root.lv.level-r; peak: root.lv.peak; }
                Rectangle { width: Theme.s2; }
                VerticalLayout {
                    width: root.knob-col;
                    spacing: Theme.s2;
                    TrimKnob { deck: root.deck; titled: true; size: root.knob; }
                    Knob { titled: true; size: root.knob; label: "HI"; value: root.k.high; readout: root.k.high-text; moved(v) => { DjState.set-eq(root.deck, "high", v); } }
                    Knob { titled: true; size: root.knob; label: "MID"; value: root.k.mid; readout: root.k.mid-text; moved(v) => { DjState.set-eq(root.deck, "mid", v); } }
                    Knob { titled: true; size: root.knob; label: "LOW"; value: root.k.low; readout: root.k.low-text; moved(v) => { DjState.set-eq(root.deck, "low", v); } }
                }
                if root.scale: MeterScale { width: 24px; kind: root.mk; }
            }
            if root.tall: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
            if root.tall: HorizontalLayout {
                vertical-stretch: 0;
                alignment: center;
                Knob { titled: true; size: root.knob + 8px; label: "FILTER"; filter: true; value: root.k.filter; readout: root.k.filter-text; moved(v) => { DjState.set-deck-filter(root.deck, v); } }
            }
            if root.tall: Button { text: "CUE"; compact: true; vertical-stretch: 0; primary: DjState.pfl(root.deck); clicked => { DjState.toggle-pfl(root.deck); } }
            if root.tall: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
            if root.tall: HorizontalLayout {
                vertical-stretch: 1;
                alignment: center;
                FaderTrack { value: DjState.gain(root.deck); moved(v) => { DjState.set-gain(root.deck, v); } }
            }
        }
        Rectangle {
            height: 22px;
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                Text { text: "XF"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; letter-spacing: 1.5px; vertical-alignment: center; horizontal-stretch: 1; }
                // The crossfader side this channel plays on.
                VerticalLayout { alignment: center; XfAssignSwitch { deck: root.deck; } }
            }
        }
    }
}

// One deck's channel as a row: the track, its level and fader, CUE; with
// room, its five knobs.
component XRow inherits Panel {
    in property <string> deck;
    in property <bool> knobs;
    // Very short windows: the fader on the title line.
    in property <bool> slim;
    // Too narrow for the title beside the fader: the letter names it.
    in property <bool> tiny;
    property <DeckItem> d: DjState.item(root.deck);
    property <DeckLevels> lv: DjState.levels(root.deck);
    property <EqKnobs> k: !DjState.eq-live ? { high: root.d.eq-high, mid: root.d.eq-mid, low: root.d.eq-low, filter: root.d.filter, high-text: root.d.eq-high-text, mid-text: root.d.eq-mid-text, low-text: root.d.eq-low-text, filter-text: root.d.filter-text } : DjState.knobs(root.deck);
    property <bool> left: root.deck == "a" || root.deck == "c";
    // One scale whatever the meter style (it switched ranges with Banded).
    property <MeterKind> mk: MeterKind.Performance;
    VerticalLayout {
        padding: root.slim ? Theme.s2 : Theme.s3;
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s2;
            VerticalLayout { alignment: center; LetterBox { letter: root.deck.to-uppercase(); lit: root.d.playing; } }
            if !(root.slim && root.tiny): Text { text: DjState.line(root.deck) != "" ? DjState.line(root.deck) : root.d.loaded ? root.d.title : DjState.line-sources > 0 ? "" : "empty"; color: DjState.line(root.deck) != "" || root.d.loaded ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
            if !(root.slim && root.tiny): VerticalLayout { alignment: center; SourceChip { deck: root.deck; } }
            // The crossfader side: click for the next (A, THRU, B).
            if !(root.slim && root.tiny): Text {
                property <string> side: DjState.xf-assign(root.deck);
                text: self.side == "a" ? "◀A" : self.side == "b" ? "B▶" : "THRU";
                color: side-ta.has-hover ? Theme.text : Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.fs-tiny;
                vertical-alignment: center;
                horizontal-stretch: 0;
                side-ta := TouchArea { mouse-cursor: pointer; clicked => { DjState.set-xf-assign(root.deck, parent.side == "a" ? "thru" : parent.side == "thru" ? "b" : "a"); } }
            }
            if root.slim: VerticalLayout { alignment: center; horizontal-stretch: 1; Slider { value: DjState.gain(root.deck); changed(v) => { DjState.set-gain(root.deck, v); } } }
            Text { text: root.d.gain-db; color: Theme.text; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; horizontal-alignment: right; width: 64px; }
            VerticalLayout { alignment: center; Button { text: "CUE"; compact: true; primary: DjState.pfl(root.deck); clicked => { DjState.toggle-pfl(root.deck); } } }
        }
        if root.knobs: HorizontalLayout {
            alignment: space-between;
            TrimKnob { deck: root.deck; titled: true; size: 22px; }
            Knob { titled: true; size: 22px; label: "HI"; value: root.k.high; readout: root.k.high-text; moved(v) => { DjState.set-eq(root.deck, "high", v); } }
            Knob { titled: true; size: 22px; label: "MID"; value: root.k.mid; readout: root.k.mid-text; moved(v) => { DjState.set-eq(root.deck, "mid", v); } }
            Knob { titled: true; size: 22px; label: "LOW"; value: root.k.low; readout: root.k.low-text; moved(v) => { DjState.set-eq(root.deck, "low", v); } }
            Knob { titled: true; size: 22px; label: "FILTER"; filter: true; value: root.k.filter; readout: root.k.filter-text; moved(v) => { DjState.set-deck-filter(root.deck, v); } }
        }
        VerticalLayout {
            spacing: 2px;
            Meter { kind: MeterKind.System; vertical: false; height: 3px; value: root.lv.level-l; peak: root.lv.peak; avg: root.lv.vu; }
            Meter { kind: MeterKind.System; vertical: false; height: 3px; value: root.lv.level-r; peak: root.lv.peak; avg: root.lv.vu; }
        }
        if !root.slim: Slider { value: DjState.gain(root.deck); changed(v) => { DjState.set-gain(root.deck, v); } }
    }
}

// The program level.
component MasterPanel inherits Panel {
    // One scale whatever the meter style (it switched ranges with Banded).
    property <MeterKind> mk: MeterKind.Performance;
    // The booth output's volume with the master, as on a club mixer (the
    // user, 2026-11-14, then 2026-11-16: in the smaller layouts it still
    // sat in PFL).
    in property <bool> booth;
    HorizontalLayout {
        padding: Theme.s3;
        spacing: Theme.s3;
        VerticalLayout {
            spacing: Theme.s2;
            horizontal-stretch: 1;
            PanelHead { text: "MASTER"; }
            for ch in [{ n: "L", v: DjState.program-l }, { n: "R", v: DjState.program-r }]: HorizontalLayout {
                spacing: Theme.s2;
                height: 14px;
                Text { text: ch.n; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; width: 10px; vertical-alignment: center; }
                VerticalLayout { alignment: center; horizontal-stretch: 1; LedMeter { vertical: false; height: 6px; kind: root.mk; value: ch.v; } }
            }
        }
        if root.booth: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            spacing: 2px;
            Text { text: "BOOTH OUT"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-tiny; letter-spacing: 1.5px; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; Knob { bare: true; size: 22px; value: BoothKnob.to-knob(DjState.master); moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } } }
            Text { text: DjState.master-text; color: Theme.text; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: center; }
        }
    }
}

// The program level, upright: the centre section's master meter, which
// takes the height the centre has left (its bottom meets the strips').
component MasterColumn inherits Panel {
    in property <bool> booth;
    VerticalLayout {
        padding: Theme.s3;
        spacing: Theme.s2;
        PanelHead { text: "MASTER"; }
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 48px;
            alignment: center;
            spacing: Theme.s2;
            MeterScale { width: 24px; kind: MeterKind.Performance; }
            LedMeter { kind: MeterKind.Performance; width: 8px; value: DjState.program-l; }
            LedMeter { kind: MeterKind.Performance; width: 8px; value: DjState.program-r; }
            Rectangle { width: 24px; }
        }
        if root.booth: Knob { titled: true; size: 26px; label: "BOOTH OUT"; value: BoothKnob.to-knob(DjState.master); readout: DjState.master-text; moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } }
    }
}

// Each deck's place in the bar and its tempo (accent when synced).
component BeatCell inherits HorizontalLayout {
    in property <string> deck;
    property <DeckItem> d: DjState.item(root.deck);
    spacing: Theme.s2;
    height: 14px;
    PhaseLane { horizontal-stretch: 1; letter: root.deck.to-uppercase(); phase: DjState.phase(root.deck); }
    Text { text: root.d.bpm == "" ? "—" : root.d.bpm; color: root.d.synced ? Theme.accent : Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
}

component BeatPanel inherits Panel {
    in property <bool> four;
    // The centre section: one deck a line.
    in property <bool> stacked;
    VerticalLayout {
        padding: Theme.s3;
        spacing: Theme.s2;
        PanelHead { text: "BEAT"; }
        if !root.stacked: HorizontalLayout { spacing: Theme.s4; BeatCell { deck: "a"; } BeatCell { deck: "b"; } }
        if !root.stacked && root.four: HorizontalLayout { spacing: Theme.s4; BeatCell { deck: "c"; } BeatCell { deck: "d"; } }
        if root.stacked && root.four: BeatCell { deck: "c"; }
        if root.stacked: BeatCell { deck: "a"; }
        if root.stacked: BeatCell { deck: "b"; }
        if root.stacked && root.four: BeatCell { deck: "d"; }
    }
}

// The next transition while an AI DJ set plays, with a count to the blend.
component NextPanel inherits Panel {
    VerticalLayout {
        padding: Theme.s3;
        spacing: Theme.s1;
        PanelHead { text: "NEXT MIX"; }
        Text { text: !DjState.set-on ? "no Auto Mix set playing" : DjState.mix-next != "" ? DjState.mix-next : "choosing the next track"; color: DjState.set-on && DjState.mix-next != "" ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-small; overflow: elide; }
        HorizontalLayout {
            spacing: Theme.s3;
            Text { text: DjState.mix-technique; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-tiny; overflow: elide; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; }
            Text {
                text: DjState.mix-bar != "" ? "MIXING " + DjState.mix-bar
                    : DjState.mix-beats >= 0 ? Math.ceil(DjState.mix-beats / 4) + " BARS · " + DjState.mix-beats + " BEATS" : "";
                color: DjState.mix-bar != "" || (DjState.mix-beats >= 0 && DjState.mix-beats <= 16) ? Theme.accent : Theme.text;
                font-family: Theme.font;
                font-size: Theme.fs-tiny;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
    }
}

// Beat FX: the effect (or a chain of up to three, from the picker), its
// length and deck, depth, hold-to-roll and on.
component FxPanel inherits Panel {
    property <bool> chaining;
    // The length steppers beside the display (the surface knows its width).
    in property <bool> one-row;
    // The shortest windows: everything on one line.
    in property <bool> line;
    pure function lit(k: string) -> bool {
        return DjState.fx-kind == k || DjState.fx-kind-2 == k || DjState.fx-kind-3 == k;
    }
    function pick(k: string) {
        if (root.chaining) { DjState.fx-chain-toggle(k); } else { DjState.fx-kind-set(k); picker.close(); }
    }
    pure function beat-text(b: float) -> string {
        return b == 0.125 ? "⅛" : b == 0.25 ? "¼" : b == 0.5 ? "½" : b == 0.75 ? "¾" : b;
    }
    pure function step-beats(b: float, up: bool) -> float {
        return up ? (b < 0.125 ? 0.125 : b < 0.25 ? 0.25 : b < 0.5 ? 0.5 : b < 0.75 ? 0.75 : b < 1 ? 1 : b < 16 ? b * 2 : 16)
                  : (b > 16 ? 16 : b > 1 ? b / 2 : b > 0.75 ? 0.75 : b > 0.5 ? 0.5 : b > 0.25 ? 0.25 : 0.125);
    }
    pure function kind-name(k: string) -> string {
        return k == "pingpong" ? "Ping-pong" : k == "trans" ? "Trans" : k == "echo" ? "Echo" : k == "reverb" ? "Reverb" : k == "flanger" ? "Flanger" : k == "phaser" ? "Phaser" : k == "roll" ? "Roll" : k == "brake" ? "Brake" : k == "crush" ? "Crush" : k == "noise" ? "Noise" : k == "sweep" ? "Sweep" : k == "tremolo" ? "Tremolo" : k == "pan" ? "Pan" : k == "drive" ? "Drive" : k;
    }
    VerticalLayout {
        if root.line: HorizontalLayout {
            padding: Theme.s2;
            spacing: Theme.s2;
            Text { text: "FX"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-tiny; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 0; }
            Button { text: root.kind-name(DjState.fx-kind) + " ▾"; compact: true; horizontal-stretch: 1; clicked => { picker.show(); } }
            Button { text: "‹"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, false)); } }
            Text { text: root.beat-text(DjState.fx-beats); color: DjState.fx-uses-beats ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-small; width: 20px; horizontal-alignment: center; vertical-alignment: center; }
            Button { text: "›"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, true)); } }
            Button { text: DjState.fx-deck.to-uppercase(); compact: true; clicked => { DjState.fx-deck-set(DjState.fx-deck == "a" ? "b" : DjState.fx-deck == "b" ? "c" : DjState.fx-deck == "c" ? "d" : "a"); } }
            Pad { width: 52px; height: 28px; horizontal-stretch: 0; text: "Roll"; icon: ""; show-label: true; down => { DjState.fx-roll(DjState.fx-beats, true); } up => { DjState.fx-roll(DjState.fx-beats, false); } }
            Pad { width: 76px; height: 28px; horizontal-stretch: 0; text: DjState.fx-on ? "ON" : "OFF"; icon: ""; show-label: true; key: "f"; active: DjState.fx-on; clicked => { DjState.fx-toggle(); } }
        }
        if !root.line: VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            PanelHead {
                text: "BEAT FX";
                detail: DjState.fx-label != DjState.fx-kind ? DjState.fx-label : "";
                Button { text: root.chaining ? "Chain: adding" : "+ Chain"; compact: true; lit: root.chaining; clicked => { root.chaining = !root.chaining; if (root.chaining) { picker.show(); } } }
            }
            HorizontalLayout {
                spacing: Theme.s2;
                // The display: the effect (click for every one), its length, its deck.
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 120px;
                    height: 32px;
                    background: Theme.bg-deeper;
                    border-radius: Theme.r-control;
                    border-width: 1px;
                    border-color: DjState.fx-on ? Theme.accent : (disp-ta.has-hover ? Theme.border-strong : Theme.border);
                    HorizontalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        spacing: Theme.s2;
                        Text { text: root.kind-name(DjState.fx-kind); color: DjState.fx-on ? Theme.accent : Theme.text-bright; font-family: Theme.font-ui; font-size: Theme.fs-large; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                        Text { text: (DjState.fx-uses-beats ? root.beat-text(DjState.fx-beats) + " beat · " : "") + "deck " + DjState.fx-deck.to-uppercase(); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                        Text { text: "▾"; color: Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; }
                    }
                    disp-ta := TouchArea { mouse-cursor: pointer; clicked => { picker.show(); } }
                }
                if root.one-row: Button { text: "‹"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, false)); } }
                if root.one-row: Text { text: root.beat-text(DjState.fx-beats); color: DjState.fx-uses-beats ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-large; width: 28px; horizontal-alignment: center; vertical-alignment: center; }
                if root.one-row: Button { text: "›"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, true)); } }
            }
            HorizontalLayout {
                spacing: Theme.s2;
                if !root.one-row: Button { text: "‹"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, false)); } }
                if !root.one-row: Text { text: root.beat-text(DjState.fx-beats); color: DjState.fx-uses-beats ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.fs-large; width: 28px; horizontal-alignment: center; vertical-alignment: center; }
                if !root.one-row: Button { text: "›"; compact: true; enabled: DjState.fx-uses-beats; clicked => { DjState.fx-beats-set(root.step-beats(DjState.fx-beats, true)); } }
                if !root.one-row: Rectangle { horizontal-stretch: 1; }
                for id in ["a", "b", "c", "d"]: Button { text: id.to-uppercase(); compact: true; lit: DjState.fx-deck == id; horizontal-stretch: root.one-row ? 1 : 0; clicked => { DjState.fx-deck-set(id); } }
            }
            HorizontalLayout {
                spacing: Theme.s3;
                KnobInline { label: "DEPTH"; unipolar: true; value: DjState.fx-depth * 2 - 1; readout: Math.round(DjState.fx-depth * 100) + "%"; moved(v) => { DjState.fx-depth-set((v + 1) / 2); } }
                Pad {
                    horizontal-stretch: 1;
                    min-width: 56px;
                    height: 32px;
                    text: "Roll";
                    icon: "";
                    show-label: true;
                    down => { DjState.fx-roll(DjState.fx-beats, true); }
                    up => { DjState.fx-roll(DjState.fx-beats, false); }
                }
                Pad {
                    horizontal-stretch: 1;
                    min-width: 76px;
                    height: 32px;
                    text: DjState.fx-on ? "ON" : "OFF";
                    icon: "";
                    show-label: true;
                    key: "f";
                    active: DjState.fx-on;
                    clicked => { DjState.fx-toggle(); }
                }
            }
        }
    }
    picker := PopupWindow {
        x: 0;
        y: 64px;
        width: Math.max(root.width, 360px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.border-strong;
            VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s2;
                for row in [["echo", "pingpong", "reverb"], ["flanger", "phaser", "trans"], ["roll", "brake", "crush"], ["noise", "sweep", "tremolo"], ["pan", "drive"]]: HorizontalLayout {
                    spacing: Theme.s2;
                    for k in row: Button { text: root.kind-name(k); compact: true; horizontal-stretch: 1; lit: root.lit(k); clicked => { root.pick(k); } }
                }
                HorizontalLayout {
                    spacing: Theme.s2;
                    Button { text: root.chaining ? "Chain: adding" : "+ Chain"; compact: true; lit: root.chaining; clicked => { root.chaining = !root.chaining; } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Done"; compact: true; clicked => { root.chaining = false; picker.close(); } }
                }
            }
        }
    }
}

// Headphones: where they play (click for the next output), cue ↔ master,
// level; with `booth`, the booth output's volume on the same line.
component PflPanel inherits Panel {
    in property <bool> booth;
    // Beside Beat FX in a mid-width window: the three as upright knobs.
    in property <bool> stacked;
    // The shortest windows: one line.
    in property <bool> line;
    VerticalLayout {
        if root.line: HorizontalLayout {
            padding: Theme.s2;
            spacing: Theme.s3;
            Text { text: "PFL"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-tiny; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle {
            horizontal-stretch: 1;
            min-width: 40px;
            max-width: 180px;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: chip-ta.has-hover ? Theme.text-faint : Theme.border-strong;
            Text { x: Theme.s2; width: parent.width - 2 * Theme.s2; text: DjState.phones + " ›"; color: DjState.phones-on ? Theme.text-bright : Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-tiny; vertical-alignment: center; overflow: elide; }
            chip-ta := TouchArea { mouse-cursor: pointer; clicked => { DjState.cycle-phones(); } }
        }
            KnobInline { label: "MIX"; live: DjState.phones-on; value: DjState.cue-mix; readout: DjState.cue-mix-text; moved(v) => { DjState.set-cue-mix(v); } }
            KnobInline { label: "LVL"; value: DjState.cue-level; readout: DjState.cue-level-text; moved(v) => { DjState.set-cue-level(v); } }
            if root.booth: KnobInline { label: "BOOTH"; value: BoothKnob.to-knob(DjState.master); readout: DjState.master-text; moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } }
        }
        if !root.line: VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            PanelHead {
                text: "PFL";
                Rectangle {
                    horizontal-stretch: 0;
                    height: 22px;
                    max-width: 200px;
                    min-width: 60px;
                    preferred-width: phones-t.preferred-width + 2 * Theme.s3;
                    border-radius: Theme.r-control;
                    border-width: 1px;
                    border-color: phones-ta.has-hover ? Theme.text-faint : Theme.border-strong;
                    phones-t := Text {
                        x: Theme.s3;
                        width: parent.width - 2 * Theme.s3;
                        text: DjState.phones + " ›";
                        color: DjState.phones-on ? Theme.text-bright : Theme.text-dim;
                        font-family: Theme.font;
                        font-size: Theme.fs-tiny;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    phones-ta := TouchArea { mouse-cursor: pointer; clicked => { DjState.cycle-phones(); } }
                }
            }
            if root.stacked: HorizontalLayout {
                alignment: space-around;
                Knob { titled: true; size: 26px; label: "CUE/MIX"; live: DjState.phones-on; value: DjState.cue-mix; readout: DjState.cue-mix-text; moved(v) => { DjState.set-cue-mix(v); } }
                Knob { titled: true; size: 26px; label: "LEVEL"; value: DjState.cue-level; readout: DjState.cue-level-text; moved(v) => { DjState.set-cue-level(v); } }
                if root.booth: Knob { titled: true; size: 26px; label: "BOOTH"; value: BoothKnob.to-knob(DjState.master); readout: DjState.master-text; moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } }
            }
            if !root.stacked: HorizontalLayout {
                spacing: Theme.s4;
                alignment: start;
                KnobInline { label: "CUE/MIX"; live: DjState.phones-on; value: DjState.cue-mix; readout: DjState.cue-mix-text; moved(v) => { DjState.set-cue-mix(v); } }
                KnobInline { label: "LEVEL"; value: DjState.cue-level; readout: DjState.cue-level-text; moved(v) => { DjState.set-cue-level(v); } }
                if root.booth: Rectangle { width: 1px; background: Theme.border; }
                if root.booth: KnobInline { label: "BOOTH"; value: BoothKnob.to-knob(DjState.master); readout: DjState.master-text; moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } }
            }
        }
    }
}

// The booth output's volume (the Mixer's DJ Booth strip).
component BoothPanel inherits Panel {
    VerticalLayout {
        padding: Theme.s3;
        spacing: Theme.s2;
        PanelHead { text: "BOOTH"; }
        HorizontalLayout {
            alignment: center;
            Knob { titled: true; size: 28px; label: "VOLUME"; value: BoothKnob.to-knob(DjState.master); readout: DjState.master-text; moved(v) => { DjState.set-master(BoothKnob.from-knob(v)); } }
        }
    }
}

// The crossfader: two or four decks, the gains it gives, and (with room)
// its law drawn on the same throw as the cap.
component XfPanel inherits Panel {
    in property <length> law-h;
    // Short windows: one line.
    in property <bool> compact;
    VerticalLayout {
        if root.compact: HorizontalLayout {
            padding: Theme.s3;
            spacing: Theme.s3;
            Text { text: "XF"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-tiny; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 0; }
            MixerDeckMode { }
            XfCurveButton { }
            Text { text: DjState.mixer-four ? "A C" : "A"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; font-weight: 700; vertical-alignment: center; horizontal-stretch: 0; }
            XFader { horizontal-stretch: 1; height: 28px; cap-w: 22px; inset: Theme.s4; value: DjState.xfader; moved(v) => { DjState.set-xfader(v); } }
            Text { text: DjState.mixer-four ? "B D" : "B"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; font-weight: 700; vertical-alignment: center; horizontal-stretch: 0; }
        }
        if !root.compact: VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            HorizontalLayout {
                spacing: Theme.s3;
                min-height: 20px;
                Text { text: "CROSSFADER"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-tiny; font-weight: 700; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 0; }
                MixerDeckMode { }
                XfCurveButton { }
                Text { text: DjState.xfader-text; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-tiny; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
            }
            HorizontalLayout {
                spacing: Theme.s3;
                Text { text: DjState.mixer-four ? "A C" : "A"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; font-weight: 700; width: 28px; vertical-alignment: center; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.s1;
                    if root.law-h > 0: LawView { height: root.law-h; pos: DjState.xfader; }
                    XFader { height: 32px; cap-w: 26px; inset: Theme.s5; value: DjState.xfader; moved(v) => { DjState.set-xfader(v); } }
                }
                Text { text: DjState.mixer-four ? "B D" : "B"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; font-weight: 700; width: 28px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
}

export component DjMixerSurface inherits Rectangle {
    property <bool> four: DjState.mixer-four;
    property <int> n: root.four ? 4 : 2;
    property <length> pad: self.width < 480px ? Theme.s3 : Theme.s4;
    property <length> gap: Theme.s3;
    property <length> avail-w: self.width - 2 * root.pad;
    property <length> avail-h: self.height - 2 * root.pad;
    // The blocks' heights (measured on the fixtures). The top row is
    // MASTER's height (its heading and the L and R lines, 72 px): BEAT
    // gives each deck a line beside them (two decks), or two a line
    // (four). At 58 px MASTER's R line ran into the decks.
    property <length> top-h: 72px;
    property <length> xf-h: 72px;
    property <length> fx-h: 130px;
    property <length> pfl-h: 74px;
    // The centre section (a club mixer's): the decks on both sides at one
    // width (C A left, B D right), BEAT, NEXT MIX, Beat FX, PFL and the
    // master meter between them; the crossfader under all of it.
    property <length> c-strip-w: clamp((root.avail-w - 320px - root.n * root.gap) / root.n, 0px, 168px);
    property <length> c-centre-w: root.avail-w - root.n * (root.c-strip-w + root.gap);
    property <length> c-body-h: root.avail-h - root.xf-short - root.gap;
    property <length> c-knob: clamp(Math.round(((root.c-body-h - root.strip-chrome) / 5 - root.knob-row - 4px) / 1px) * 1px, 22px, 30px);
    property <bool> c-tall: root.c-body-h >= root.tall-need;
    property <length> c-strip-need: root.strip-chrome + 5 * (root.c-knob + root.knob-row) + 4 * 4px;
    property <length> c-centre-need: (root.four ? 112px : 76px) + 70px + 130px + 104px + 90px + 4 * root.gap;
    property <bool> centre: root.c-strip-w >= 126px && root.c-centre-w >= 300px && root.c-body-h >= Math.max(root.c-strip-need, root.c-centre-need);
    property <bool> side: false;
    // Under the decks: one row (Beat FX, PFL, Booth) when wide; Beat FX
    // beside a compact PFL (its knobs upright, the booth with them) at mid
    // widths; narrow, Beat FX over PFL.
    property <bool> fx-wide: root.avail-w >= 680px;
    property <bool> fx-mid: !root.fx-wide && root.avail-w >= 500px;
    property <length> under-row: root.fx-wide || root.fx-mid ? root.fx-h + root.gap : root.fx-h + root.gap + root.pfl-h + root.gap;
    property <length> under-h: root.side ? 0px : root.under-row;
    property <length> strips-w: root.avail-w;
    property <length> strip-w: (root.strips-w - (root.n - 1) * root.gap) / root.n;
    // The strip: header, CUE, the knob column beside the fader, the XF
    // foot. Knobs as large as the height allows (22–30 px); a knob row is
    // its name, the dial and its value.
    property <length> strip-chrome: 26px + 22px + 2 * Theme.s3 + Theme.row-h + Theme.s2;
    property <length> knob-row: 2 * Theme.fs-tiny + 10px;
    property <length> fixed-h: root.top-h + root.gap + root.gap + root.under-h + root.xf-short;
    property <length> knob-hh: Math.round(((root.avail-h - root.fixed-h - root.strip-chrome) / 5 - root.knob-row - 4px) / 1px) * 1px;
    property <length> knob: clamp(root.knob-hh, 22px, 30px);
    // The column, the fader (32), two meters (12), the scale (24), gaps.
    property <bool> strip-scale: root.strip-w >= 54px + 32px + 12px + 24px + 5 * Theme.s2 + 2 * Theme.s3;
    property <length> strip-need: root.strip-chrome + 5 * (root.knob + root.knob-row) + 4 * 4px;
    // Tall: the DJM-style channel (four knobs by the meter, a larger
    // FILTER, CUE) with at least 180 px of fader under it. Its knob size is
    // the column's at most 28 px, so the choice does not depend on itself.
    property <length> tall-need: root.strip-chrome + 4 * (28px + root.knob-row) + 3 * Theme.s2 + (36px + root.knob-row) + 2 * Theme.s2 + 2px + 180px;
    property <bool> strip-tall: root.avail-h >= root.fixed-h + root.tall-need;
    property <bool> strips: root.strip-w >= 54px + 32px + 12px + 4 * Theme.s2 + 2 * Theme.s3 && root.avail-h >= root.fixed-h + root.strip-need;
    // Rows: in two columns when wide; with their knobs when they fit,
    // else the essentials; short, the crossfader on one line.
    property <int> row-cols: root.avail-w >= 560px || (root.ultra && root.four) ? 2 : 1;
    // (Budgets use the width's column count; `row-cols` may add a column
    // for the shortest windows.)
    property <int> row-lines: root.n / (root.avail-w >= 560px ? 2 : 1);
    property <length> xf-short: 44px;
    property <bool> row-knobs: root.avail-h >= root.top-h + root.gap + root.row-lines * (132px + root.gap) + root.under-row + root.xf-h;
    property <bool> show-top: root.strips || root.row-knobs || root.avail-h >= root.top-h + root.gap + root.row-lines * (64px + root.gap) + root.under-row + root.xf-h;
    property <bool> xf-compact: !root.strips && !root.row-knobs && root.avail-h < root.row-lines * (74px + root.gap) + root.under-row + root.xf-h;
    property <bool> row-slim: root.xf-compact && root.avail-h < root.row-lines * (74px + root.gap) + root.under-row + root.xf-short;
    // Still too short: Beat FX and PFL on a line each (side by side when
    // wide), the rows in two columns. (Decided from the one-column count so
    // the choice cannot depend on itself.)
    property <bool> ultra: root.row-slim && root.avail-h < root.row-lines * (52px + root.gap) + root.under-row + root.xf-short;
    property <bool> ultra-pair: root.avail-w >= 760px;
    // The law takes height the faders do not need.
    property <length> spare: root.avail-h - root.fixed-h - root.strip-need;
    property <length> law-h: root.strips && root.spare >= 160px ? (root.spare >= 400px ? 64px : 40px) : 0px;
    init => { keys.focus(); }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (!DjState.key-guard(e.text)) { return reject; }
            if (e.text == "4" && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift) { DjState.mixer-decks-toggle(); return accept; }
            if (e.text == "f") { DjState.fx-toggle(); return accept; }
            if (DjState.key("dj-mixer", DjState.key-name(e.text), e.modifiers.shift, e.modifiers.control, e.modifiers.alt, true)) { return accept; }
            return reject;
        }
        VerticalLayout {
            padding: root.pad;
            spacing: root.gap;
            if root.centre: HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.gap;
                if root.four: XStrip { width: root.c-strip-w; deck: "c"; knob: root.c-tall ? Math.min(root.c-knob, 28px) : root.c-knob; scale: false; tall: root.c-tall; }
                XStrip { width: root.c-strip-w; deck: "a"; knob: root.c-tall ? Math.min(root.c-knob, 28px) : root.c-knob; scale: false; tall: root.c-tall; }
                VerticalLayout {
                    width: root.c-centre-w;
                    spacing: root.gap;
                    // Each panel at its own height; the master meter takes
                    // what is left (they stretched into empty boxes).
                    BeatPanel { vertical-stretch: 0; four: root.four; stacked: true; }
                    NextPanel { vertical-stretch: 0; }
                    FxPanel { vertical-stretch: 0; one-row: root.c-centre-w >= 420px; }
                    PflPanel { vertical-stretch: 0; stacked: true; }
                    MasterColumn { vertical-stretch: 1; booth: true; }
                }
                XStrip { width: root.c-strip-w; deck: "b"; knob: root.c-tall ? Math.min(root.c-knob, 28px) : root.c-knob; scale: false; tall: root.c-tall; }
                if root.four: XStrip { width: root.c-strip-w; deck: "d"; knob: root.c-tall ? Math.min(root.c-knob, 28px) : root.c-knob; scale: false; tall: root.c-tall; }
            }
            if !root.centre && root.show-top: HorizontalLayout {
                spacing: root.gap;
                height: root.top-h;
                MasterPanel { horizontal-stretch: 2; booth: true; }
                BeatPanel { horizontal-stretch: 3; four: root.four; stacked: !root.four; }
                if DjState.set-on: NextPanel { horizontal-stretch: 2; }
            }
            // The decks: upright strips (C A B D), or rows.
            if !root.centre && root.strips: HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.gap;
                if root.four: XStrip { width: root.strip-w; deck: "c"; knob: root.strip-tall ? Math.min(root.knob, 28px) : root.knob; scale: root.strip-scale; tall: root.strip-tall; }
                XStrip { width: root.strip-w; deck: "a"; knob: root.strip-tall ? Math.min(root.knob, 28px) : root.knob; scale: root.strip-scale; tall: root.strip-tall; }
                XStrip { width: root.strip-w; deck: "b"; knob: root.strip-tall ? Math.min(root.knob, 28px) : root.knob; scale: root.strip-scale; tall: root.strip-tall; }
                if root.four: XStrip { width: root.strip-w; deck: "d"; knob: root.strip-tall ? Math.min(root.knob, 28px) : root.knob; scale: root.strip-scale; tall: root.strip-tall; }
            }
            if !root.centre && !root.strips && root.row-cols == 1: VerticalLayout {
                vertical-stretch: 1;
                spacing: root.gap;
                alignment: start;
                XRow { deck: "a"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                XRow { deck: "b"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                if root.four: XRow { deck: "c"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                if root.four: XRow { deck: "d"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
            }
            // Two columns: the A side's decks left, the B side's right, A
            // and B on the top line, C and D under them (C over A and B
            // over D put the pairs on different lines).
            if !root.centre && !root.strips && root.row-cols == 2: HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.gap;
                VerticalLayout {
                    spacing: root.gap;
                    alignment: start;
                    XRow { deck: "a"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                    if root.four: XRow { deck: "c"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                }
                VerticalLayout {
                    spacing: root.gap;
                    alignment: start;
                    XRow { deck: "b"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                    if root.four: XRow { deck: "d"; knobs: root.row-knobs; slim: root.row-slim; tiny: root.avail-w < 560px; }
                }
            }
            if !root.centre && root.ultra && root.ultra-pair: HorizontalLayout {
                spacing: root.gap;
                FxPanel { line: true; horizontal-stretch: 1; }
                PflPanel { line: true; booth: !root.show-top; horizontal-stretch: 1; }
            }
            if !root.centre && root.ultra && !root.ultra-pair: FxPanel { line: true; }
            if !root.centre && root.ultra && !root.ultra-pair: PflPanel { line: true; booth: !root.show-top && root.avail-w >= 520px; }
            if !root.centre && !root.ultra && !(root.strips && root.side) && root.fx-wide: HorizontalLayout {
                spacing: root.gap;
                FxPanel { horizontal-stretch: 3; one-row: (root.avail-w - 2 * root.gap) / 2 >= 420px; }
                PflPanel { horizontal-stretch: 2; }
                if !root.show-top: BoothPanel { horizontal-stretch: 1; }
            }
            if !root.centre && !root.ultra && !(root.strips && root.side) && root.fx-mid: HorizontalLayout {
                spacing: root.gap;
                FxPanel { horizontal-stretch: 1; one-row: false; }
                PflPanel { width: 220px; stacked: true; booth: !root.show-top; }
            }
            if !root.centre && !root.ultra && !(root.strips && root.side) && !root.fx-wide && !root.fx-mid: FxPanel { one-row: root.avail-w >= 420px; }
            // Too narrow for three inline knobs (BOOTH's value was cut off):
            // upright, as beside Beat FX.
            if !root.centre && !root.ultra && !(root.strips && root.side) && !root.fx-wide && !root.fx-mid: PflPanel { booth: !root.show-top; stacked: root.avail-w < 440px; }
            XfPanel { law-h: root.centre ? 0px : root.law-h; compact: root.centre || root.xf-compact || (root.strips && root.law-h == 0); }
        }
    }
}

// A row's own action: quiet until its row is chosen, so a list of
// hundreds reads as tracks, not as hundreds of buttons.
component RowAction inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    callback clicked();
    height: Theme.row-h - 4px;
    background: ta.pressed ? Theme.selection : ta.has-hover ? Theme.hover : root.strong ? Theme.raised : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.text-faint : root.strong ? Theme.border-strong : Theme.border;
    Text {
        text: root.text;
        color: root.strong || ta.has-hover ? Theme.text : Theme.text-faint;
        font-family: Theme.font;
        font-size: Theme.fs-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// What a deck holds, in one line: its letter lit while it plays.
component DeckLine inherits HorizontalLayout {
    in property <string> letter;
    in property <bool> loaded;
    in property <bool> playing;
    in property <string> title;
    spacing: Theme.s3;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: Theme.fs + Theme.s2 * 2;
            height: self.width;
            border-width: 1px;
            border-color: root.playing ? Theme.accent : Theme.border-strong;
            background: root.playing ? Theme.accent-soft : transparent;
            Text { text: root.letter; color: root.playing ? Theme.accent : Theme.text-dim; font-family: Theme.font; font-size: Theme.fs-small; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    in property <bool> compact;
    Label { text: root.loaded ? root.title : "empty"; tone: root.playing ? "bright" : root.loaded ? "normal" : "faint"; small: true; min-width: 0px; overflow: elide; horizontal-stretch: 0; }
    if !root.compact: Label { text: !root.loaded ? "" : root.playing ? "▶ playing" : "cued"; tone: root.playing ? "accent" : "faint"; small: true; horizontal-stretch: 0; }
    Rectangle { horizontal-stretch: 1; }
}

// One sidebar row. The name is a word, in the UI face; the count is its
// own column on the right. A note such as "5 ready" sits under the name,
// so it is not mistaken for the count. The arrow opens and closes a place.
component CrateRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> detail-tone: "dim";
    in property <string> count;
    in property <bool> selected;
    in property <bool> active;
    in property <bool> markable: false;
    in property <bool> disclosure: false;
    in property <bool> open: false;
    // Keeps the name aligned with rows that do have an arrow.
    in property <bool> gutter: false;
    in property <length> indent: 0px;
    callback clicked();
    callback toggle();
    callback mark();
    height: root.detail == "" ? Theme.row-h : Theme.row-h + Theme.fs-small;
    background: root.selected ? Theme.selection : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Rectangle { x: 0px; width: 2px; background: root.selected ? Theme.accent : transparent; }
    HorizontalLayout {
        padding-left: Theme.s3 + root.indent;
        padding-right: Theme.s2;
        spacing: Theme.s2;
        cross-axis-alignment: center;
        if root.disclosure || root.gutter: Rectangle {
            width: 14px;
            if root.disclosure: Text {
                text: root.open ? "▾" : "▸";
                color: root.open ? Theme.text-bright : Theme.text-dim;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            if root.disclosure: TouchArea { mouse-cursor: pointer; clicked => { root.toggle(); } }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0px;
            Text {
                text: root.name;
                color: root.selected ? Theme.text-bright : root.active ? Theme.text : Theme.text-dim;
                font-family: Theme.font-ui;
                font-size: Theme.fs-small;
                font-weight: root.selected ? Theme.ui-weight : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: root.detail-tone == "warn" ? Theme.warn : Theme.text-dim;
                font-family: Theme.font-ui;
                font-size: Theme.fs-tiny;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.count != "": Text {
            text: root.count;
            color: root.selected ? Theme.text : Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.fs-tiny;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 28px;
            overflow: elide;
        }
        // The dot shows on hover and on the selected row, so a long list
        // reads as names, not controls. The column stays so the counts line up.
        if root.markable: Rectangle {
            width: 16px;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                border-width: 1px;
                property <bool> shown: ta.has-hover || dot.has-hover || root.selected;
                border-color: !self.shown ? transparent : dot.has-hover ? Theme.text-bright : root.active ? Theme.accent : Theme.text-dim;
                background: !self.shown ? transparent : dot.has-hover ? (root.active ? transparent : Theme.text-bright) : (root.active ? Theme.accent : transparent);
            }
            dot := TouchArea { mouse-cursor: pointer; clicked => { root.mark(); } }
        }
    }
}

// A section label: the word is the heading, the rule sets it off from the
// rows, and the arrow collapses the section.
component CrateHeading inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> foldable: true;
    in property <bool> open: true;
    callback clicked();
    height: Theme.row-h + Theme.s2;
    background: root.foldable && ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { enabled: root.foldable; mouse-cursor: root.foldable ? pointer : default; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        padding-top: Theme.s3;
        spacing: Theme.s2;
        cross-axis-alignment: center;
        Text {
            text: root.text;
            color: Theme.text-bright;
            font-family: Theme.font-ui;
            font-size: Theme.fs-small;
            font-weight: Theme.ui-weight;
            letter-spacing: 0.3px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.fs-tiny;
            vertical-alignment: center;
        }
        if root.foldable: Text {
            text: root.open ? "▾" : "▸";
            color: Theme.text-dim;
            font-size: Theme.fs-small;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 12px;
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
}

// A filter, named on the chip itself so the number belongs to that word.
component FilterChip inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    height: Theme.row-h - 2px;
    width: row.preferred-width;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    background: root.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover : Theme.raised;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    row := HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        spacing: Theme.s2;
        cross-axis-alignment: center;
        Text {
            text: root.name;
            color: root.selected ? Theme.text-bright : Theme.text;
            font-family: Theme.font-ui;
            font-size: Theme.fs-small;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            color: root.selected ? Theme.accent : Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.fs-tiny;
            vertical-alignment: center;
        }
    }
}

// The side bar and the narrow-window picker. Search and All tracks stay
// pinned. Filters are a well of chips above the catalogue, so they read as
// what to show, not as another place. Where is a tree; Collections is a list.
component CrateList inherits Rectangle {
    in-out property <bool> show-inactive;
    in-out property <string> query;
    // A place whose folders are hidden. Empty means the open path is shown.
    in-out property <string> folded;
    in-out property <bool> where-open: true;
    in-out property <bool> collections-open: true;
    in-out property <bool> sets-open: true;
    callback chosen();
    property <int> inactive: DjState.collections.length - DjState.collections-active;
    property <bool> inactive-open: root.show-inactive || DjState.collections-active == 0 || !DjState.collection-viewed-active;
    property <bool> history-any: DjState.lib-unplayed-n > 0 || DjState.lib-session-n > 0 || DjState.lib-hour-n > 0 || DjState.lib-earlier-n > 0 || DjState.lib-played != "";
    // Slint strings have no contains: dropping the query changes the name
    // only when the name holds it.
    function hit(name: string) -> bool {
        root.query == "" || name.to-lowercase().replace-all(root.query, "") != name.to-lowercase()
    }
    // A zero is noise until that filter is the one turned on.
    function tally(n: int, on: bool) -> string {
        (n > 0 || on) ? (n + "") : ""
    }
    // A folder under a place the user closed.
    function buried(path: string) -> bool {
        root.folded != "" && path.starts-with(root.folded + "/")
    }
    // The source's folders are on screen.
    function source-open(path: string) -> bool {
        DjState.lib-folder-root == path && root.folded != path
    }
    // Open a source, or close it when it is already open. Closing keeps the
    // tracks on screen; it only folds the tree.
    function toggle-source(path: string) {
        if (root.source-open(path)) {
            root.folded = path;
        } else {
            root.folded = "";
            if (DjState.lib-folder-root != path) {
                DjState.lib-browse(path);
                root.chosen();
            }
        }
    }
    // Open a folder, or close it when it is the one already shown.
    function toggle-folder(path: string) {
        if (DjState.lib-location == path && root.folded != path) {
            root.folded = path;
        } else {
            root.folded = "";
            if (DjState.lib-location != path) {
                DjState.lib-browse(path);
                root.chosen();
            }
        }
    }
    VerticalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        padding-top: Theme.s2;
        spacing: Theme.s2;
        SearchField {
            prompt: "";
            placeholder: "Filter crates";
            edited(t) => { root.query = t.to-lowercase(); }
            cancelled => { self.text = ""; root.query = ""; }
        }
        CrateRow {
            name: "All tracks";
            count: DjState.lib-total;
            selected: DjState.collection-viewed < 0 && DjState.lib-location == "";
            active: true;
            clicked => { root.folded = ""; DjState.collection-view(-1); root.chosen(); }
        }
        // A control, not a place. The well, the accent caption and the
        // wrapping chips are what separate a filter from a folder or a
        // collection, which stay as rows in the list below.
        Rectangle {
            background: Theme.bg-deep;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.r-panel;
            VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s2;
                Text {
                    text: "Show";
                    color: Theme.accent;
                    font-family: Theme.font-ui;
                    font-size: Theme.fs-tiny;
                    font-weight: Theme.ui-weight;
                    letter-spacing: 0.6px;
                }
                FlexboxLayout {
                    spacing: Theme.s2;
                    FilterChip { name: "Fits the deck"; count: root.tally(DjState.lib-fits-n, DjState.lib-smart-fits); selected: DjState.lib-smart-fits; clicked => { DjState.lib-smart-toggle("fits"); } }
                    FilterChip { name: "Favourites"; count: root.tally(DjState.lib-fav-n, DjState.lib-smart-fav); selected: DjState.lib-smart-fav; clicked => { DjState.lib-smart-toggle("fav"); } }
                    FilterChip { name: "Straight grid"; count: root.tally(DjState.lib-straight-n, DjState.lib-smart-straight); selected: DjState.lib-smart-straight; clicked => { DjState.lib-smart-toggle("straight"); } }
                }
                if !DjState.lib-fits-live: Text {
                    text: "Cue a deck to see what fits.";
                    color: Theme.text-dim;
                    font-family: Theme.font-ui;
                    font-size: Theme.fs-tiny;
                    wrap: word-wrap;
                }
                if root.history-any: Text {
                    text: "Played";
                    color: Theme.text-dim;
                    font-family: Theme.font-ui;
                    font-size: Theme.fs-tiny;
                    font-weight: Theme.ui-weight;
                    letter-spacing: 0.6px;
                }
                if root.history-any: FlexboxLayout {
                    spacing: Theme.s2;
                    if root.tally(DjState.lib-unplayed-n, DjState.lib-played == "unplayed") != "": FilterChip { name: "Unplayed"; count: root.tally(DjState.lib-unplayed-n, DjState.lib-played == "unplayed"); selected: DjState.lib-played == "unplayed"; clicked => { DjState.lib-smart-toggle("unplayed"); } }
                    if root.tally(DjState.lib-session-n, DjState.lib-played == "session") != "": FilterChip { name: "This session"; count: root.tally(DjState.lib-session-n, DjState.lib-played == "session"); selected: DjState.lib-played == "session"; clicked => { DjState.lib-smart-toggle("session"); } }
                    if root.tally(DjState.lib-hour-n, DjState.lib-played == "hour") != "": FilterChip { name: "Last hour"; count: root.tally(DjState.lib-hour-n, DjState.lib-played == "hour"); selected: DjState.lib-played == "hour"; clicked => { DjState.lib-smart-toggle("hour"); } }
                    if root.tally(DjState.lib-earlier-n, DjState.lib-played == "earlier") != "": FilterChip { name: "Earlier"; count: root.tally(DjState.lib-earlier-n, DjState.lib-played == "earlier"); selected: DjState.lib-played == "earlier"; clicked => { DjState.lib-smart-toggle("earlier"); } }
                }
            }
        }
        Scroll {
            vertical-stretch: 1;
            if DjState.lib-sources.length > 0: CrateHeading { text: "Where"; open: root.where-open; clicked => { root.where-open = !root.where-open; } }
            if root.where-open: VerticalLayout {
                for s in DjState.lib-sources: VerticalLayout {
                    if root.hit(s.name) || DjState.lib-folder-root == s.path: VerticalLayout {
                        CrateRow {
                            name: s.name;
                            detail: !s.connected ? "offline" : (s.ready == s.tracks ? "" : s.ready + " ready");
                            detail-tone: s.connected ? "dim" : "warn";
                            count: s.tracks;
                            selected: DjState.lib-location == s.path;
                            active: s.connected;
                            disclosure: true;
                            open: root.source-open(s.path);
                            clicked => {
                                if (DjState.lib-location == s.path) { root.toggle-source(s.path); }
                                else { root.folded = ""; DjState.lib-browse(s.path); root.chosen(); }
                            }
                            toggle => { root.toggle-source(s.path); }
                        }
                        if root.source-open(s.path): VerticalLayout {
                            for f in DjState.lib-folders: VerticalLayout {
                                if !root.buried(f.path) && root.hit(f.label): CrateRow {
                                    name: f.label;
                                    count: f.count;
                                    indent: (f.depth + 1) * 12px;
                                    selected: f.path == DjState.lib-location;
                                    active: true;
                                    disclosure: f.expandable;
                                    gutter: !f.expandable;
                                    open: f.expanded && root.folded != f.path;
                                    clicked => { root.toggle-folder(f.path); }
                                    toggle => { root.toggle-folder(f.path); }
                                }
                            }
                        }
                    }
                }
            }
            // Set preps first: the set being put together while listening.
            CrateHeading { text: "Set prep"; open: root.sets-open; clicked => { root.sets-open = !root.sets-open; } }
            if root.sets-open: VerticalLayout {
                for c in DjState.prep-sets: VerticalLayout {
                    if root.hit(c.name): CrateRow {
                        name: c.name;
                        detail: c.name == DjState.prep-target ? "s adds here" : "";
                        count: c.count;
                        selected: c.id == DjState.collection-viewed;
                        active: true;
                        clicked => { DjState.collection-select(c.id); DjState.collection-view(c.id); root.chosen(); }
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    padding-top: Theme.s1;
                    padding-bottom: Theme.s2;
                    alignment: start;
                    Button { text: "New set prep"; compact: true; clicked => { DjState.prep-new(); } }
                }
            }
            CrateHeading { text: "Collections"; open: root.collections-open; clicked => { root.collections-open = !root.collections-open; } }
            if root.collections-open: VerticalLayout {
                for c in DjState.collections: VerticalLayout {
                    if c.active && root.hit(c.name): CrateRow {
                        name: c.name;
                        count: c.count;
                        selected: c.id == DjState.collection-viewed;
                        active: true;
                        markable: true;
                        clicked => { DjState.collection-select(c.id); DjState.collection-view(c.id); root.chosen(); }
                        mark => { DjState.collection-activate(c.id, false); }
                    }
                }
                if root.inactive > 0: CrateHeading {
                    text: "Inactive";
                    detail: root.inactive;
                    foldable: DjState.collections-active > 0 && DjState.collection-viewed-active;
                    open: root.inactive-open;
                    clicked => { root.show-inactive = !root.show-inactive; }
                }
                if root.inactive-open: VerticalLayout {
                    for c in DjState.collections: VerticalLayout {
                        if !c.active && root.hit(c.name): CrateRow {
                            name: c.name;
                            count: c.count;
                            selected: c.id == DjState.collection-viewed;
                            active: false;
                            markable: true;
                            clicked => { DjState.collection-select(c.id); DjState.collection-view(c.id); root.chosen(); }
                            mark => { DjState.collection-activate(c.id, true); }
                        }
                    }
                }
                if DjState.collections.length > 0 && root.inactive == 0 && root.query == "": HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s2;
                    Text { text: "The dot sets a collection aside, under Inactive."; color: Theme.text-dim; font-family: Theme.font-ui; font-size: Theme.fs-tiny; wrap: word-wrap; }
                }
                if DjState.collections.length == 0: HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s2;
                    Text { text: "No collections yet. New collection makes one, from a folder or empty."; color: Theme.text-dim; font-family: Theme.font-ui; font-size: Theme.fs-tiny; wrap: word-wrap; }
                }
            }
        }
    }
}

// One collection in "Add to collection": ticked when the highlighted
// track is in it; a click puts it in or takes it out.
component TickRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <bool> ticked;
    callback clicked();
    min-height: Theme.row-h;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        padding-top: Theme.s2;
        padding-bottom: Theme.s2;
        spacing: Theme.s3;
        Label { text: root.ticked ? "✓" : ""; tone: "accent"; width: 12px; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Label { text: root.name; tone: root.ticked ? "bright" : "normal"; vertical-alignment: center; min-width: 0px; wrap: word-wrap; }
            if root.detail != "": Label { text: root.detail; tone: "faint"; small: true; min-width: 0px; wrap: word-wrap; }
        }
    }
}

// The collection shown, as a button that opens the list (windows too
// narrow for the side bar).
component CratePicker inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    callback clicked();
    height: Theme.row-h + 2px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.text-faint : Theme.border-strong;
    background: ta.has-hover ? Theme.hover : Theme.raised;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        spacing: Theme.s3;
        Label { text: root.text; tone: "bright"; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        Label { text: root.detail; tone: "faint"; small: true; vertical-alignment: center; }
        Label { text: "▾"; tone: "dim"; vertical-alignment: center; }
    }
}

export component LibrarySurface inherits Rectangle {
    property <bool> confirm-set-switch;
    init => { keys.focus(); }
    property <bool> narrow: self.width < 600px;
    property <bool> short: self.height < 480px;
    property <string> collection-name;
    // Wide windows keep the collections in a side bar; narrower ones pick
    // from the same list in a drop-down.
    property <bool> side: self.width >= Theme.wide-w;
    property <length> side-w: clamp(self.width * 0.28, 300px, 380px);
    // The track list's own width, for which columns fit.
    property <length> list-w: root.side ? root.width - root.side-w - 1px : root.width;
    in-out property <bool> show-inactive;
    // Naming the collection shown ("rename") or a new one ("new"), and
    // confirming a delete; another collection shown ends either.
    property <string> editing;
    property <bool> confirming;
    property <bool> confirming-where;
    property <string> where-now: DjState.lib-location;
    changed where-now => { root.confirming-where = false; }
    property <int> viewed: DjState.collection-viewed;
    changed viewed => { root.editing = ""; root.confirming = false; }
    // What the list is showing: a collection, a folder, or everything.
    property <string> list-title: DjState.collection-viewed < 0 ? (DjState.lib-location == "" ? "All tracks" : DjState.lib-location-label) : DjState.collection-viewed-name;
    property <string> list-note: DjState.collection-viewed >= 0 ? (DjState.collection-viewed-count + (DjState.collection-viewed-count == 1 ? " track" : " tracks") + (DjState.collection-viewed-place != "" ? " · " + DjState.collection-viewed-place : "") + (DjState.collection-viewed-active ? "" : " · inactive") + (DjState.collection-viewed-in-order ? " · plays in this order" : "")) : DjState.lib-location-note;
    // A where-column once the title still has room beside it.
    property <bool> place-col: !root.narrow && root.list-w > 980px;
    // "Add to collection": as tall as its list, inside the window.
    property <length> tc-h: min(root.height - Theme.s4 * 2, Theme.row-h * (DjState.track-collections.length + 4) + Theme.s4 * 2);
    // Wide enough for the longest kind ("radio", "opus", "flac").
    property <length> tag-w: Theme.fs-tiny * 3.2 + Theme.s3;
    // Shared by the headings and the rows, so the columns stay one grid.
    property <length> col-state: 58px;
    property <length> col-bpm: 52px;
    property <length> col-grid: 64px;
    property <length> col-key: 36px;
    property <length> col-year: 40px;
    property <length> col-genre: 132px;
    property <length> col-lufs: 68px;
    property <length> col-where: 148px;
    property <bool> grid-col: !root.narrow && root.list-w > 760px;
    property <bool> lufs-col: !root.narrow && root.list-w > 900px;
    property <bool> genre-col: !root.narrow && root.list-w > 1180px;
    // The row's load buttons: the deck letter, fixed, so the heading lines up.
    property <length> act-w: 36px;
    property <length> fav-w: 16px;
    // Any analysis chip or smart filter is on.
    property <bool> filters-on: DjState.lib-state != "all" || DjState.lib-smart-fits || DjState.lib-smart-fav || DjState.lib-smart-straight || DjState.lib-played != "";
    // Narrows the sidebar by crate name. Shared with the drop-down.
    in-out property <string> crate-query;
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (!DjState.key-guard(e.text)) { return reject; }
            if (DjState.lib-grid-editing) {
                if (e.text == Key.Escape) { DjState.lib-grid-editing = false; return accept; }
                if (e.text == Key.Return) { DjState.lib-grid-save(DjState.lib-grid-bpm, DjState.lib-grid-first-beat, DjState.lib-grid-downbeat); return accept; }
                if (e.text == Key.LeftArrow) { DjState.lib-grid-first-beat = max(0, DjState.lib-grid-first-beat - 0.01); return accept; }
                if (e.text == Key.RightArrow) { DjState.lib-grid-first-beat = DjState.lib-grid-first-beat + 0.01; return accept; }
                if (e.text == Key.UpArrow) { DjState.lib-grid-bpm = min(300, DjState.lib-grid-bpm + 0.1); return accept; }
                if (e.text == Key.DownArrow) { DjState.lib-grid-bpm = max(40, DjState.lib-grid-bpm - 0.1); return accept; }
                if (e.text == "b") { DjState.lib-grid-beat-here(); return accept; }
                if (e.text == "r") { DjState.lib-grid-reset(); return accept; }
                if (e.text == "-") { DjState.lib-grid-bpm = max(40, DjState.lib-grid-bpm / 2); return accept; }
                if (e.text == "+" || e.text == "=") { DjState.lib-grid-bpm = min(300, DjState.lib-grid-bpm * 2); return accept; }
                if (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4") { DjState.lib-grid-downbeat = e.text.to-float() - 1; return accept; }
                return reject;
            }
            if (e.text == "/") { search.start-edit(); return accept; }
            // Pre-listen: space plays and pauses; 1 start, 2 drop 1, 3 break,
            // 4 drop 2, 5 outro; ← → the parts, ⇧← ⇧→ eight bars; s puts the
            // track in the set prep (or takes it out); ⇧↑ ⇧↓ move it there.
            if (e.text == " ") { DjState.preview-toggle(); return accept; }
            if (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5") { DjState.preview-cue(e.text.to-float() - 1); return accept; }
            if (DjState.prev-title != "" && e.modifiers.shift && e.text == Key.LeftArrow) { DjState.preview-bars(-8); return accept; }
            if (DjState.prev-title != "" && e.modifiers.shift && e.text == Key.RightArrow) { DjState.preview-bars(8); return accept; }
            if (DjState.prev-title != "" && e.text == Key.LeftArrow) { DjState.preview-part(-1); return accept; }
            if (DjState.prev-title != "" && e.text == Key.RightArrow) { DjState.preview-part(1); return accept; }
            if (e.text == "h") { DjState.hud-open = !DjState.hud-open; DjState.hud-refresh(); return accept; }
            if (e.text == "g" && DjState.lib-cursor-title != "") { DjState.lib-grid-edit(); return accept; }
            if (e.text == "e" && DjState.lib-cursor-title != "") { DjState.lib-edit(); return accept; }
            if (e.text == Key.Escape && DjState.hud-open) { DjState.hud-open = false; return accept; }
            if (e.text == Key.Escape && DjState.prev-title != "") { DjState.preview-stop(); return accept; }
            if (e.text == "s") { DjState.prep-toggle(); return accept; }
            if (e.text == "o" && DjState.collection-viewed >= 0) { DjState.collection-play-order(!DjState.collection-viewed-in-order); return accept; }
            if (e.modifiers.shift && e.text == Key.UpArrow && DjState.prep-viewed) { DjState.prep-move(-1); return accept; }
            if (e.modifiers.shift && e.text == Key.DownArrow && DjState.prep-viewed) { DjState.prep-move(1); return accept; }
            if (e.text == Key.UpArrow || e.text == "k") { DjState.move-lib(-1); return accept; }
            if (e.text == Key.DownArrow || e.text == "j") { DjState.move-lib(1); return accept; }
            if (e.text == "a" || e.text == Key.Return) { DjState.load("a", DjState.lib-cursor); return accept; }
            if (e.text == "b") { DjState.load("b", DjState.lib-cursor); return accept; }
            if (e.text == "c" || e.text == "d") { DjState.load(e.text, DjState.lib-cursor); return accept; }
            if (e.text == "q") { DjState.queue-selected(); return accept; }
            // ⇧C: c (and d) load decks C and D (patch_core::keys).
            if (e.text == "C" && DjState.lib-cursor-title != "") { tc-popup.show(); return accept; }
            if (e.text == Key.Delete && DjState.collection-viewed >= 0 && DjState.lib-cursor-title != "") { DjState.track-collection(DjState.collection-viewed, false); return accept; }
            return reject;
        }
        crates-popup := PopupWindow {
            x: Theme.s4;
            y: (crates-bar.y + crates-bar.height - Theme.s2);
            width: min(root.width - Theme.s4 * 2, 440px);
            height: min(root.height - (crates-bar.y + crates-bar.height - Theme.s2) - Theme.s4, Theme.row-h * (DjState.collections.length + DjState.lib-sources.length + DjState.lib-folders.length + 20) + Theme.s4);
            close-policy: close-on-click-outside;
            Rectangle {
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding-top: Theme.s1;
                    padding-bottom: Theme.s2;
                    CrateList {
                        vertical-stretch: 1;
                        show-inactive <=> root.show-inactive;
                        query <=> root.crate-query;
                        chosen => { crates-popup.close(); keys.focus(); }
                    }
                }
            }
        }
        tc-popup := PopupWindow {
            x: root.width - self.width - Theme.s4;
            y: max(Theme.s4, min(track-bar.y + track-bar.height, root.height - root.tc-h - Theme.s4));
            width: min(root.width - Theme.s4 * 2, 380px);
            height: root.tc-h;
            close-policy: close-on-click-outside;
            Rectangle {
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s2;
                    HorizontalLayout {
                        padding-left: Theme.s4;
                        padding-right: Theme.s4;
                        padding-bottom: Theme.s2;
                        Label { text: "“" + DjState.lib-cursor-title + "” is in"; tone: "dim"; small: true; min-width: 0px; overflow: elide; }
                    }
                    Scroll {
                        vertical-stretch: 1;
                        for c in DjState.track-collections: TickRow {
                            name: c.name;
                            detail: c.place;
                            ticked: c.member;
                            clicked => { DjState.track-collection(c.id, !c.member); }
                        }
                        if DjState.track-collections.length == 0: HorizontalLayout {
                            padding-left: Theme.s4;
                            padding-right: Theme.s4;
                            Label { text: "No collections yet: name one below."; tone: "faint"; small: true; wrap: word-wrap; }
                        }
                    }
                    SearchField {
                        prompt: "+";
                        placeholder: "New collection with this track";
                        accepted => {
                            if (self.text != "") { DjState.track-new-collection(self.text); self.text = ""; }
                        }
                        cancelled => { tc-popup.close(); keys.focus(); }
                    }
                }
            }
        }
        HorizontalLayout {
        // The catalogue, in wide windows.
        if root.side: Rectangle {
            width: root.side-w;
            background: Theme.bg-deep;
            VerticalLayout {
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s3;
                    padding-top: Theme.s3;
                    padding-bottom: Theme.s2;
                    spacing: Theme.s2;
                    Label { text: "Library"; tone: "dim"; small: true; caps: true; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "New collection"; compact: true; primary: DjState.folder-picking; clicked => { DjState.collection-choose(!DjState.folder-picking); keys.focus(); } }
                }
                CrateList {
                    vertical-stretch: 1;
                    show-inactive <=> root.show-inactive;
                    query <=> root.crate-query;
                    chosen => { keys.focus(); }
                }
            }
        }
        if root.side: Rectangle { width: 1px; background: Theme.border; }
        // One edge for everything: 12 px (the rows' own), so every block
        // starts where the list does.
        VerticalLayout {
            horizontal-stretch: 1;
            // What's shown (the collection, a folder, or all tracks), and playing it.
            crates-bar := Rectangle {
                background: Theme.bg-deep;
                VerticalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    padding-top: Theme.s3;
                    padding-bottom: Theme.s3;
                    spacing: Theme.s2;
                    if DjState.lib-offers.length > 0: FlexboxLayout {
                        spacing: Theme.s2;
                        for o in DjState.lib-offers: Button { text: "Add drive " + o.label; compact: true; primary: true; clicked => { DjState.lib-add-drive(o.path, o.label); keys.focus(); } }
                    }
                    if root.editing != "rename": HorizontalLayout {
                        spacing: Theme.s3;
                        // Narrower windows: the collection is a drop-down.
                        if !root.side: CratePicker {
                            horizontal-stretch: 1;
                            text: root.list-title;
                            detail: DjState.collection-viewed < 0 && DjState.lib-location == "" ? (root.narrow ? "" : DjState.collections.length + " collections") : root.list-note;
                            clicked => { crates-popup.show(); }
                        }
                        if !root.side: VerticalLayout { alignment: center; Button { text: root.narrow ? "New" : "New collection"; compact: true; primary: DjState.folder-picking; clicked => { DjState.collection-choose(!DjState.folder-picking); keys.focus(); } } }
                        // Wide windows: its name, as the list's title.
                        if root.side: VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Label { text: root.list-title; tone: "bright"; font-size: Theme.fs-large; min-width: 0px; overflow: elide; }
                            Label { text: root.list-note; tone: "faint"; small: true; min-width: 0px; overflow: elide; }
                        }
                        // How the AI DJ plays it: in this order, or its own.
                        if DjState.collection-viewed >= 0 && !root.narrow: HorizontalLayout {
                            alignment: center;
                            spacing: Theme.s1;
                            VerticalLayout { alignment: center; Label { text: "Plays"; tone: "faint"; small: true; } }
                            VerticalLayout { alignment: center; Button { text: "In order"; compact: true; lit: DjState.collection-viewed-in-order; clicked => { DjState.collection-play-order(true); keys.focus(); } } }
                            VerticalLayout { alignment: center; Button { text: "DJ decides"; compact: true; lit: !DjState.collection-viewed-in-order; clicked => { DjState.collection-play-order(false); keys.focus(); } } }
                        }
                        if DjState.collection-viewed >= 0: VerticalLayout {
                            alignment: center;
                            Button { text: "Rename"; compact: true; clicked => { root.confirming = false; root.editing = "rename"; } }
                        }
                        if DjState.collection-viewed >= 0: VerticalLayout {
                            alignment: center;
                            Button { text: "Delete"; compact: true; lit: root.confirming; clicked => { root.editing = ""; root.confirming = !root.confirming; root.confirming-where = false; keys.focus(); } }
                        }
                        if DjState.collection-viewed < 0 && DjState.lib-location-kind == "folder": VerticalLayout {
                            alignment: center;
                            Button { text: root.narrow ? "Collect" : "Make collection"; compact: true; clicked => { DjState.lib-collect-folder(DjState.lib-location); keys.focus(); } }
                        }
                        if DjState.collection-viewed < 0 && DjState.lib-location-kind == "source": VerticalLayout {
                            alignment: center;
                            Button { text: root.narrow ? "Remove" : "Remove from library"; compact: true; lit: root.confirming-where; clicked => { root.confirming = false; root.confirming-where = !root.confirming-where; keys.focus(); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: DjState.set-on ? (root.confirm-set-switch ? "Confirm switch" : "Switch Auto Mix…") : root.narrow ? "▶ Auto Mix" : DjState.collection-viewed >= 0 ? "▶ Start Auto Mix from this collection · selected track first" : "▶ Start Auto Mix · selected track first";
                                enabled: DjState.lib-count > 0;
                                compact: true;
                                primary: true;
                                clicked => { if DjState.set-on && !root.confirm-set-switch { root.confirm-set-switch = true; } else { root.confirm-set-switch = false; DjState.collection-start-set(DjState.collection-viewed); } keys.focus(); }
                            }
                        }
                    }
                    if root.editing == "rename": HorizontalLayout {
                        spacing: Theme.s3;
                        rename-field := SearchField {
                            horizontal-stretch: 1;
                            prompt: "";
                            placeholder: "Name this collection";
                            init => { self.text = DjState.collection-viewed-name; self.start-edit(); }
                            accepted => { DjState.collection-rename(DjState.collection-viewed, self.text); root.editing = ""; keys.focus(); }
                            cancelled => { root.editing = ""; keys.focus(); }
                        }
                        VerticalLayout { alignment: center; Button { text: "Save"; compact: true; primary: true; clicked => { DjState.collection-rename(DjState.collection-viewed, rename-field.text); root.editing = ""; keys.focus(); } } }
                        VerticalLayout { alignment: center; Button { text: "Cancel"; compact: true; clicked => { root.editing = ""; keys.focus(); } } }
                    }
                    if root.confirming && DjState.collection-viewed >= 0: HorizontalLayout {
                        spacing: Theme.s3;
                        Label {
                            text: DjState.collection-viewed-folder != ""
                                ? "Delete “" + DjState.collection-viewed-name + "”? It is the library folder " + DjState.collection-viewed-folder + ": its tracks leave Patch (the files stay on disk)."
                                : "Delete “" + DjState.collection-viewed-name + "”? Its " + DjState.collection-viewed-count + " tracks stay in the library.";
                            tone: "warn";
                            small: true;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout { alignment: center; Button { text: "Delete"; compact: true; primary: true; clicked => { DjState.collection-delete(DjState.collection-viewed); root.confirming = false; keys.focus(); } } }
                        VerticalLayout { alignment: center; Button { text: "Cancel"; compact: true; clicked => { root.confirming = false; keys.focus(); } } }
                    }
                    if root.confirming-where && DjState.lib-location-kind == "source": HorizontalLayout {
                        spacing: Theme.s3;
                        Label {
                            text: "Remove “" + DjState.lib-location-label + "”? Its tracks leave Patch. The files stay on disk, and the analyses are kept.";
                            tone: "warn";
                            small: true;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout { alignment: center; Button { text: "Remove"; compact: true; primary: true; clicked => { DjState.lib-remove-source(DjState.lib-location); root.confirming-where = false; keys.focus(); } } }
                        VerticalLayout { alignment: center; Button { text: "Cancel"; compact: true; clicked => { root.confirming-where = false; keys.focus(); } } }
                    }
                    if root.editing == "new": HorizontalLayout {
                        spacing: Theme.s3;
                        new-field := SearchField {
                            horizontal-stretch: 1;
                            prompt: "";
                            placeholder: "Name the new collection";
                            init => { self.start-edit(); }
                            accepted => { if (self.text != "") { DjState.collection-create(self.text); } root.editing = ""; keys.focus(); }
                            cancelled => { root.editing = ""; keys.focus(); }
                        }
                        VerticalLayout { alignment: center; Button { text: "Create"; compact: true; primary: true; enabled: new-field.text != ""; clicked => { DjState.collection-create(new-field.text); root.editing = ""; keys.focus(); } } }
                        VerticalLayout { alignment: center; Button { text: "Cancel"; compact: true; clicked => { root.editing = ""; keys.focus(); } } }
                    }
                    if DjState.lib-edit-open: HorizontalLayout {
                        spacing: Theme.s2;
                        Label { text: "Patch tags"; tone: "accent"; vertical-alignment: center; }
                        title-field := SearchField { horizontal-stretch: 1; prompt: ""; placeholder: "Title"; text: DjState.lib-edit-title; init => { self.start-edit(); } }
                        artist-field := SearchField { horizontal-stretch: 1; prompt: ""; placeholder: "Artist"; text: DjState.lib-edit-artist; }
                        year-field := SearchField { width: 76px; prompt: ""; placeholder: "Year"; text: DjState.lib-edit-year; }
                        genre-field := SearchField { horizontal-stretch: 1; prompt: ""; placeholder: "Genre"; text: DjState.lib-edit-genre; }
                        Button { text: "Save"; compact: true; primary: true; clicked => { DjState.lib-edit-save(title-field.text, artist-field.text, year-field.text, genre-field.text); keys.focus(); } }
                        Button { text: "Cancel"; compact: true; clicked => { DjState.lib-edit-open = false; keys.focus(); } }
                    }
                    // A folder through the chooser, or an empty one. No list
                    // of folders: a library's folders run to dozens (user,
                    // 2026-11-12: "too complicated and messy").
                    if DjState.folder-picking: FlexboxLayout {
                        spacing: Theme.s2;
                        Label { text: "New collection:"; tone: "dim"; small: true; vertical-alignment: center; min-height: Theme.row-h; }
                        Button { text: "From a folder…"; compact: true; clicked => { DjState.collection-choose(false); DjState.collection-from-folder(); keys.focus(); } }
                        Button { text: "Empty collection…"; compact: true; clicked => { DjState.collection-choose(false); root.confirming = false; root.editing = "new"; } }
                        Button { text: "Cancel"; compact: true; clicked => { DjState.collection-choose(false); keys.focus(); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // Search, where tracks stand, and the library's own actions.
            HorizontalLayout {
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                padding-top: Theme.s2;
                padding-bottom: Theme.s2;
                spacing: Theme.s2;
                cross-axis-alignment: center;
                // Preferred width 0 so the field takes the row's leftover,
                // rather than the width of its placeholder.
                search := SearchField {
                    horizontal-stretch: 1;
                    min-width: 180px;
                    preferred-width: 0px;
                    placeholder: "Title, artist or folder";
                    edited(t) => { DjState.set-filter(t); }
                    accepted => { keys.focus(); }
                    cancelled => { self.text = ""; DjState.set-filter(""); keys.focus(); }
                    navigate(d) => { DjState.move-lib(d); }
                }
                Button { text: "All " + DjState.lib-state-counts[0]; compact: true; lit: DjState.lib-state == "all"; clicked => { DjState.lib-set-state("all"); keys.focus(); } }
                Button { text: "Ready " + DjState.lib-state-counts[1]; compact: true; lit: DjState.lib-state == "ready"; clicked => { DjState.lib-set-state("ready"); keys.focus(); } }
                if DjState.lib-state-counts[5] > 0 || DjState.lib-state == "soft": Button { text: (root.narrow ? "Soft " : "Soft beat ") + DjState.lib-state-counts[5]; compact: true; lit: DjState.lib-state == "soft"; clicked => { DjState.lib-set-state("soft"); keys.focus(); } }
                if DjState.lib-state-counts[2] > 0 || DjState.lib-state == "check": Button { text: "Check " + DjState.lib-state-counts[2]; compact: true; lit: DjState.lib-state == "check"; clicked => { DjState.lib-set-state("check"); keys.focus(); } }
                if DjState.lib-state-counts[3] > 0 || DjState.lib-state == "waiting": Button { text: "Waiting " + DjState.lib-state-counts[3]; compact: true; lit: DjState.lib-state == "waiting"; clicked => { DjState.lib-set-state("waiting"); keys.focus(); } }
                if DjState.lib-state-counts[4] > 0 || DjState.lib-state == "failed": Button { text: "Failed " + DjState.lib-state-counts[4]; compact: true; lit: DjState.lib-state == "failed"; clicked => { DjState.lib-set-state("failed"); keys.focus(); } }
                if root.filters-on: Button { text: "Clear"; compact: true; clicked => { DjState.lib-smart-toggle("clear"); keys.focus(); } }
                if root.narrow: Button { text: DjState.lib-favourites-first ? "♥ First" : "♥"; compact: true; lit: DjState.lib-favourites-first; clicked => { DjState.lib-favourites-first-toggle(); keys.focus(); } }
                Button { text: root.narrow ? "+ Files" : "+ Add files"; compact: true; clicked => { DjState.lib-add-files(); keys.focus(); } }
                Button { text: "↻ Rescan"; compact: true; clicked => { DjState.lib-rescan(); keys.focus(); } }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // AI DJ. Idle is one line; direction and the mix actions open
            // once it has a suggestion or is running.
            ai-bar := Rectangle {
                background: Theme.bg-deep;
                property <bool> ai-open: DjState.ai-on || DjState.ai-title != "";
                VerticalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s2;
                    spacing: Theme.s2;
                    HorizontalLayout {
                        spacing: Theme.s3;
                        cross-axis-alignment: center;
                        Tag { text: "Auto Mix · " + (DjState.ai-state == "" ? "idle" : DjState.ai-state == "prepared" ? "Prepare" : DjState.ai-state); strong: DjState.ai-on; }
                        Label {
                            text: DjState.ai-title != "" ? DjState.ai-title : (DjState.ai-on ? "listening for a playing deck with a beat grid" : "suggests the next track and how to mix it");
                            tone: DjState.ai-title != "" ? "bright" : "dim";
                            small: DjState.ai-title == "";
                            overflow: elide;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            vertical-alignment: center;
                        }
                        Button { text: DjState.ai-title != "" ? "Suggest again" : "Suggest"; compact: true; primary: DjState.ai-title == ""; clicked => { DjState.ai("suggest"); } }
                    }
                    if ai-bar.ai-open && !root.narrow: HorizontalLayout {
                        spacing: Theme.s2;
                        alignment: center;
                        Label { text: "DIRECTION"; tone: "faint"; small: true; caps: true; vertical-alignment: center; }
                        Button { text: "Build"; compact: true; lit: DjState.ai-direction == "build"; clicked => { DjState.ai-direct("build"); } }
                        Button { text: "Hold"; compact: true; lit: DjState.ai-direction == "hold"; clicked => { DjState.ai-direct("hold"); } }
                        Button { text: "Release"; compact: true; lit: DjState.ai-direction == "release"; clicked => { DjState.ai-direct("release"); } }
                    }
                    if ai-bar.ai-open && DjState.ai-detail != "": Label { text: DjState.ai-detail; tone: "accent"; small: true; overflow: elide; }
                    if ai-bar.ai-open && DjState.ai-reasons != "" && DjState.ai-on && !root.narrow && !root.short: Label { text: DjState.ai-reasons; tone: "faint"; small: true; wrap: word-wrap; }
                    if ai-bar.ai-open && DjState.ai-alternates.length > 0 && !root.narrow: HorizontalLayout {
                        spacing: Theme.s2;
                        VerticalLayout { alignment: center; Label { text: "or"; tone: "faint"; small: true; } }
                        for alt[i] in DjState.ai-alternates: Button {
                            text: alt;
                            compact: true;
                            horizontal-stretch: 1;
                            clicked => { DjState.ai-pick(i + 1); }
                        }
                    }
                    if ai-bar.ai-open: FlexboxLayout {
                        spacing: Theme.s2;
                        Button { text: "Prepare"; compact: true; enabled: DjState.ai-title != ""; clicked => { DjState.ai("prepare"); } }
                        Button { text: "Mix"; compact: true; primary: DjState.ai-state == "prepared"; enabled: DjState.ai-title != ""; clicked => { DjState.ai("run"); } }
                        Button { text: DjState.ai-auto ? "✓ Auto prep ON" : "Auto prep"; compact: true; lit: DjState.ai-auto; clicked => { DjState.ai-toggle-auto(); } }
                        if DjState.ai-on: Button { text: "Off"; compact: true; clicked => { DjState.ai("off"); } }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // The Library's AI suggestion is independent of what the service
            // currently has on its decks. Show the actual loaded deck state
            // here so a stale suggestion cannot look like a loaded track.
            HorizontalLayout {
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                padding-top: Theme.s2;
                padding-bottom: Theme.s2;
                spacing: Theme.s4;
                DeckLine { compact: root.narrow; letter: "A"; loaded: DjState.deck-a.loaded; playing: DjState.deck-a.playing; title: DjState.deck-a.title; horizontal-stretch: 1; }
                DeckLine { compact: root.narrow; letter: "B"; loaded: DjState.deck-b.loaded; playing: DjState.deck-b.playing; title: DjState.deck-b.title; horizontal-stretch: 1; }
            }
            if DjState.automix-on || DjState.automix-next != "" || DjState.automix-note != "": Rectangle {
                background: Theme.bg-deep;
                VerticalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    padding-top: Theme.s3;
                    padding-bottom: Theme.s3;
                    spacing: Theme.s1;
                    Label {
                        text: DjState.automix-on ? "AUTO-MIX ON · SERVICE CHOICE" : "AUTO-MIX · LAST SERVICE CHOICE";
                        tone: DjState.automix-on ? "accent" : "dim";
                        small: true;
                    }
                    Label {
                        text: DjState.automix-next != "" ? DjState.automix-next : DjState.automix-note != "" ? DjState.automix-note : "Waiting for a playing deck with a beat grid";
                        tone: "bright";
                        overflow: elide;
                    }
                    if DjState.plan-text != "": Label { text: DjState.plan-text; tone: "dim"; small: true; overflow: elide; }
                }
            }
            // The highlighted track: file name first, when it was played, and
            // which collections it belongs to.
            track-bar := Rectangle {
                height: DjState.lib-cursor-path != "" || DjState.lib-cursor-played != "" || DjState.lib-cursor-title != "" ? Theme.row-h : 0px;
                clip: true;
                background: Theme.bg-deep;
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    spacing: Theme.s3;
                    cross-axis-alignment: center;
                    if DjState.lib-cursor-place != "": Label { text: DjState.lib-cursor-place; tone: "dim"; small: true; vertical-alignment: center; horizontal-stretch: 0; }
                    Label { text: DjState.lib-cursor-path; tone: "faint"; small: true; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                    if DjState.lib-cursor-title != "" && DjState.collection-viewed >= 0: Button { text: "Remove"; compact: true; clicked => { DjState.track-collection(DjState.collection-viewed, false); keys.focus(); } }
                    if DjState.lib-cursor-title != "": Button { text: root.narrow ? "Add" : "Add to collection"; key: root.narrow ? "" : "⇧c"; compact: true; clicked => { tc-popup.show(); } }
                    // Where s puts the highlighted track (✓ when it is in).
                    if DjState.lib-cursor-title != "" && !root.narrow: Button {
                        text: DjState.prep-target == "" ? "New set prep" : (DjState.prep-has-cursor ? "✓ " : "") + DjState.prep-target + " · " + DjState.prep-target-count;
                        key: "s";
                        compact: true;
                        clicked => { DjState.prep-toggle(); keys.focus(); }
                    }
                    if DjState.lib-cursor-played != "": Label { text: DjState.lib-cursor-played; tone: "dim"; small: true; vertical-alignment: center; }
                }
            }
            // Asked once: may Patch look up release years online? Says what
            // is sent, to whom, and where to change it.
            if DjState.lookups-ask: Rectangle {
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-strong;
                border-radius: Theme.r-panel;
                VerticalLayout {
                    padding: Theme.s4;
                    spacing: Theme.s2;
                    Text {
                        text: "Look up release years and genres online?";
                        color: Theme.text-bright;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-small;
                        font-weight: Theme.ui-weight;
                    }
                    Label {
                        text: "Patch can ask MusicBrainz (musicbrainz.org), an open music encyclopedia, when each song first came out, so a re-release or remix shows the original year too, and its genre when the file's own tag names none. For each track it sends the artist and title, nothing about you, one request a second, and keeps the answer. What your files' own tags say is shown either way. Settings · DJ Booth changes this later.";
                        tone: "dim";
                        small: true;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.s2;
                        Button { text: "Allow"; compact: true; primary: true; clicked => { DjState.lookups-answer(true); keys.focus(); } }
                        Button { text: "Not now"; compact: true; clicked => { DjState.lookups-answer(false); keys.focus(); } }
                    }
                }
            }
            // The pre-listen moved off main to AUX 1: said once a run.
            if DjState.aux-notice != "": Rectangle {
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-strong;
                border-radius: Theme.r-panel;
                VerticalLayout {
                    padding: Theme.s4;
                    spacing: Theme.s2;
                    Text {
                        text: "Pre-listen plays on AUX 1";
                        color: Theme.text-bright;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-small;
                        font-weight: Theme.ui-weight;
                    }
                    Label { text: DjState.aux-notice; tone: "dim"; small: true; wrap: word-wrap; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.s2;
                        Button { text: "OK"; compact: true; primary: true; clicked => { DjState.aux-notice-answer(true); keys.focus(); } }
                        Button { text: "Don't tell me again"; compact: true; clicked => { DjState.aux-notice-answer(false); keys.focus(); } }
                    }
                }
            }
            // The pre-listen: what plays, the moment it is in, and where the
            // five cue keys land on the track (1 start … 5 outro).
            if DjState.prev-title != "" || DjState.prev-message != "": Rectangle {
                height: DjState.prev-title != "" ? Theme.row-h + 18px : Theme.row-h;
                background: Theme.bg-deep;
                Rectangle { x: 0px; y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    y: 0px;
                    height: Theme.row-h;
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    spacing: Theme.s3;
                    if DjState.prev-title != "": Text {
                        text: DjState.prev-playing ? "▶" : "❚❚";
                        color: DjState.prev-playing ? Theme.accent : Theme.text-dim;
                        font-size: Theme.fs-tiny;
                        vertical-alignment: center;
                    }
                    if DjState.prev-title != "": Text {
                        text: DjState.prev-title;
                        color: Theme.text-bright;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-small;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        vertical-alignment: center;
                    }
                    if DjState.prev-message != "": Label { text: DjState.prev-message; tone: "dim"; small: true; overflow: elide; min-width: 0px; horizontal-stretch: DjState.prev-title == "" ? 1 : 0; vertical-alignment: center; }
                    if DjState.prev-route != "" && DjState.prev-title != "": Text {
                        text: DjState.prev-route;
                        color: Theme.text-dim;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-tiny;
                        font-weight: Theme.ui-weight;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    if DjState.prev-at != "": Text {
                        text: DjState.prev-at;
                        color: Theme.accent;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-tiny;
                        font-weight: Theme.ui-weight;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }
                    if DjState.prev-title != "": Text {
                        text: DjState.prev-time;
                        color: Theme.text-dim;
                        font-family: Theme.font;
                        font-size: Theme.fs-tiny;
                        vertical-alignment: center;
                    }
                }
                // The track as a hairline: played part in the accent, and
                // where each cue key lands, numbered.
                if DjState.prev-title != "": Rectangle {
                    x: Theme.s4;
                    y: Theme.row-h;
                    width: parent.width - Theme.s4 * 2;
                    height: 16px;
                    Rectangle { x: 0px; y: 12px; width: parent.width; height: 1px; background: Theme.border-strong; }
                    Rectangle { x: 0px; y: 11px; width: parent.width * DjState.prev-progress; height: 3px; border-radius: 1px; background: Theme.accent; } // radius: anti-aliased, so it grows between pixels
                    for m[i] in DjState.prev-marks: Rectangle {
                        visible: m >= 0;
                        x: parent.width * max(0, m) - 1px;
                        y: 9px;
                        width: 2px;
                        height: 7px;
                        background: DjState.prev-progress >= m ? Theme.accent : Theme.text-dim;
                    }
                    for m[i] in DjState.prev-marks: Text {
                        visible: m >= 0;
                        x: min(parent.width - 8px, max(0, parent.width * m - 3px));
                        y: -2px;
                        text: i + 1;
                        color: DjState.prev-progress >= m ? Theme.text-dim : Theme.text-faint;
                        font-family: Theme.font;
                        font-size: Theme.fs-tiny;
                    }
                }
            }
            // Column headings, on the rows' own grid.
            if DjState.lib-count > 0: Rectangle {
                height: Theme.row-h - 4px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    spacing: Theme.s3;
                    Rectangle { width: root.tag-w; }
                    // Click: favourites to the top, click again: back.
                    Rectangle {
                        width: root.fav-w;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 11px;
                            name: DjState.lib-favourites-first ? "heart-on" : "heart";
                            ink: DjState.lib-favourites-first ? Theme.accent : fav-sort.has-hover ? Theme.text-bright : Theme.text-faint;
                        }
                        fav-sort := TouchArea { mouse-cursor: pointer; clicked => { DjState.lib-favourites-first-toggle(); keys.focus(); } }
                    }
                    HeaderCell { text: "TITLE"; horizontal-stretch: 1; }
                    if root.place-col: HeaderCell { text: "WHERE"; width: root.col-where; }
                    if root.genre-col: HeaderCell { text: "GENRE"; width: root.col-genre; }
                    if !root.narrow: HeaderCell { text: "STATE"; width: root.col-state; horizontal-alignment: right; }
                    if !root.narrow: HeaderCell { text: "BPM"; width: root.col-bpm; horizontal-alignment: right; }
                    if root.grid-col: HeaderCell { text: "GRID"; width: root.col-grid; horizontal-alignment: right; }
                    if !root.narrow: HeaderCell { text: "KEY"; width: root.col-key; horizontal-alignment: right; }
                    if !root.narrow: HeaderCell { text: "YEAR"; width: root.col-year; horizontal-alignment: right; }
                    if root.lufs-col: HeaderCell { text: "LUFS"; width: root.col-lufs; horizontal-alignment: right; }
                    HeaderCell { text: "LOAD"; width: root.act-w * 4 + Theme.s3 * 3; horizontal-alignment: center; }
                }
            }
            if DjState.lib-count == 0: VerticalLayout {
                alignment: center;
                spacing: Theme.s3;
                padding: Theme.s4;
                EmptyState {
                    title: DjState.lib-location != "" || DjState.collection-viewed >= 0 ? "Nothing in this list" : "Nothing to play yet";
                    detail: root.filters-on ? "The search and filters hide every track here." : DjState.lib-location != "" ? "This folder has no tracks in the library." : DjState.collection-viewed >= 0 ? "This collection is empty." : "Put audio files in ~/Music. Stations you played in cliamp show up here too.";
                }
                if root.filters-on: HorizontalLayout {
                    alignment: center;
                    Button { text: "Clear filters"; compact: true; clicked => { DjState.lib-smart-toggle("clear"); keys.focus(); } }
                }
            }
            // Only the rows in view exist (a stick holds thousands): Rust
            // hands over the slice starting at lib-first.
            lib-list := Rectangle {
                vertical-stretch: 1;
                clip: true;
                property <length> rh: Theme.row-h + Theme.fs-small + Theme.s1;
                property <int> cur: DjState.lib-cursor;
                function report() { DjState.lib-scrolled(Math.floor(-lfl.content-y / self.rh), Math.ceil(self.height / self.rh) + 2); }
                changed height => { self.report(); }
                changed rh => { self.report(); }
                init => { self.report(); }
                // The keyboard's cursor stays in view.
                changed cur => {
                    if (self.cur * self.rh < -lfl.content-y) {
                        lfl.content-y = -self.cur * self.rh;
                    } else if ((self.cur + 1) * self.rh > -lfl.content-y + self.height) {
                        lfl.content-y = -((self.cur + 1) * self.rh - self.height);
                    }
                }
                lfl := Flickable {
                    content-height: max(self.height, DjState.lib-count * lib-list.rh);
                    changed content-y => { lib-list.report(); }
                for it[j] in DjState.library: history-row := ListRow {
                    y: (DjState.lib-first + j) * lib-list.rh;
                    width: lfl.width;
                    selected: it.selected;
                    row-height: lib-list.rh;
                    clicked => { DjState.move-lib(DjState.lib-first + j - DjState.lib-cursor); keys.focus(); }
                    double-clicked => { DjState.load("a", DjState.lib-first + j); }
                    // Fixed tag column, so titles line up whatever the kind.
                    VerticalLayout { alignment: center; width: root.tag-w; HorizontalLayout { alignment: start; Tag { text: it.kind; } } }
                    // A favourite is a solid heart; the empty one shows only on the row at hand.
                    Rectangle {
                        width: root.fav-w;
                        if it.can-favourite && (it.favourite || row-fav.has-hover || history-row.hovered || it.selected): Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 11px;
                            name: it.favourite ? "heart-on" : "heart";
                            ink: it.favourite ? Theme.accent : row-fav.has-hover ? Theme.text-bright : Theme.text-faint;
                        }
                        row-fav := TouchArea {
                            enabled: it.can-favourite;
                            mouse-cursor: it.can-favourite ? pointer : default;
                            clicked => { DjState.lib-favourite(DjState.lib-first + j); keys.focus(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 0px;
                        Label { text: it.title; tone: it.selected ? "bright" : "normal"; min-width: 0px; overflow: elide; }
                        // Why wins for a track that needs a look; otherwise the
                        // artist, and the short place when Where has no column.
                        Label {
                            text: it.why != "" ? it.why : (!root.place-col && it.place != "" ? (it.detail != "" ? it.detail + " · " + it.place : it.place) : it.detail);
                            tone: it.state == "failed" ? "error" : it.state == "check" ? "warn" : "faint";
                            small: true;
                            min-width: 0px;
                            min-height: Theme.fs-small;
                            overflow: elide;
                        }
                    }
                    if root.place-col: VerticalLayout {
                        alignment: center;
                        width: root.col-where;
                        Label { text: it.place; tone: "faint"; small: true; min-width: 0px; overflow: elide; }
                    }
                    if root.genre-col: VerticalLayout {
                        alignment: center;
                        width: root.col-genre;
                        Label { text: it.genre; tone: "dim"; small: true; min-width: 0px; overflow: elide; }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        width: root.col-state;
                        Label {
                            text: it.state == "ready" ? "ready" : it.state == "soft" ? "soft" : it.state == "check" ? "check" : it.state == "failed" ? "failed" : it.state == "waiting" ? "waiting" : "";
                            tone: it.state == "ready" ? "dim" : it.state == "check" ? "warn" : it.state == "failed" ? "error" : "faint";
                            small: true;
                            horizontal-alignment: right;
                        }
                    }
                    // Key is accent when it fits the playing deck.
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        width: root.col-bpm;
                        Label { text: it.bpm; tone: "normal"; horizontal-alignment: right; }
                    }
                    if root.grid-col: VerticalLayout {
                        alignment: center;
                        width: root.col-grid;
                        Label { text: it.grid; tone: it.grid == "loose" ? "warn" : "faint"; small: true; horizontal-alignment: right; }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        width: root.col-key;
                        Label { text: it.key; tone: it.fits ? "accent" : "dim"; horizontal-alignment: right; font-weight: it.fits ? 700 : 400; }
                    }
                    // The song's year; under it, a later release's.
                    if !root.narrow: VerticalLayout {
                        alignment: center;
                        width: root.col-year;
                        Label { text: it.year; tone: "dim"; horizontal-alignment: right; }
                        if it.year-re != "": Label { text: it.year-re; tone: "faint"; small: true; horizontal-alignment: right; }
                    }
                    if root.lufs-col: VerticalLayout {
                        alignment: center;
                        width: root.col-lufs;
                        Label { text: it.lufs; tone: "faint"; small: true; horizontal-alignment: right; }
                    }
                    VerticalLayout { alignment: center; RowAction { width: root.act-w; text: "A"; strong: it.selected; clicked => { DjState.load("a", DjState.lib-first + j); } } }
                    for dk in ["b", "c", "d"]: VerticalLayout { alignment: center; RowAction { width: root.act-w; text: dk.to-uppercase(); strong: it.selected; clicked => { DjState.load(dk, DjState.lib-first + j); } } }
                }
                }
                if DjState.lib-count * lib-list.rh > lib-list.height: Rectangle {
                    x: lib-list.width - 3px;
                    width: 2px;
                    height: max(16px, lib-list.height * lib-list.height / (DjState.lib-count * lib-list.rh));
                    y: (lib-list.height - self.height) * (-lfl.content-y / max(1px, DjState.lib-count * lib-list.rh - lib-list.height));
                    background: Theme.border-strong;
                }
            }
            // This view, what the librarian is doing, and the whole library.
            Rectangle {
                height: Theme.footer-h;
                background: Theme.bg-deep;
                Rectangle { y: 0px; height: 1px; background: Theme.border; }
                // Three equal zones. An empty left zone still holds its third,
                // so the librarian stays centred and the library total stays
                // on the right edge. `alignment: start` (not stretch) keeps
                // that empty zone's maximum open; a stretch layout with no
                // children collapses.
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    spacing: Theme.s3;
                    cross-axis-alignment: center;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: start;
                        cross-axis-alignment: center;
                        if DjState.lib-view-line != "": Label { text: DjState.lib-view-line; tone: "accent"; small: true; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                    }
                    if DjState.lib-view-line != "": Rectangle { width: 1px; height: Theme.fs-small; background: Theme.border; }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        cross-axis-alignment: center;
                        Label { text: DjState.lib-activity; tone: DjState.lib-busy ? "accent" : "faint"; small: true; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; horizontal-alignment: center; }
                    }
                    if DjState.status != "" || DjState.lib-summary != "": Rectangle { width: 1px; height: Theme.fs-small; background: Theme.border; }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        spacing: Theme.s3;
                        cross-axis-alignment: center;
                        if DjState.status != "": Label { text: DjState.status; tone: "dim"; small: true; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; horizontal-alignment: right; }
                        if DjState.status != "" && DjState.lib-summary != "": Rectangle { width: 1px; height: Theme.fs-small; background: Theme.border; }
                        if DjState.lib-summary != "": Label { text: DjState.lib-summary; tone: "normal"; small: true; vertical-alignment: center; horizontal-alignment: right; }
                    }
                }
            }
        }
        }
        // The HUD (h): over the list, apart from it. What plays (or the
        // highlighted track), its waveform with the cue keys and parts, and
        // how it sits in the set prep. It only shows; h or esc hides it.
        if DjState.hud-open && DjState.hud-title != "": hud := Rectangle {
            // The playhead: moved on the display's frame while it plays
            // (glide_hud in app.rs), set as is otherwise.
            property <float> head: DjState.hud-progress;
            property <length> left: root.side ? root.side-w + 1px : 0px;
            property <length> room: root.width - self.left;
            width: min(self.room - Theme.s4 * 2, 1280px);
            x: self.left + (self.room - self.width) / 2;
            // Above the footer; in a short window, from the top down.
            y: max(Theme.s2, root.height - self.height - Theme.row-h - Theme.s4);
            height: min(hud-col.preferred-height, root.height - Theme.s2 * 2);
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.r-panel;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000090;
            clip: true;
            // The accent along the top: a HUD, not a list row.
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.accent; }
            hud-col := VerticalLayout {
                padding: Theme.s4;
                padding-top: Theme.s4 + 2px;
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.s3;
                    Text {
                        text: DjState.hud-state == "playing" ? "▶ PRE-LISTEN" : DjState.hud-state == "paused" ? "❚❚ PRE-LISTEN · PAUSED" : "HIGHLIGHTED · NOT PLAYING";
                        color: DjState.hud-state == "playing" ? Theme.accent : Theme.text-dim;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-tiny;
                        font-weight: Theme.ui-weight;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                    if DjState.prev-route != "" && DjState.hud-state != "": Text {
                        text: "· " + DjState.prev-route;
                        color: Theme.text-dim;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-tiny;
                        font-weight: Theme.ui-weight;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: DjState.hud-time; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.fs-small; vertical-alignment: center; }
                    Text { text: "h hides"; color: Theme.text-faint; font-family: Theme.font-ui; font-size: Theme.fs-tiny; vertical-alignment: center; }
                }
                Text {
                    text: DjState.hud-title;
                    color: Theme.text-bright;
                    font-family: Theme.font-ui;
                    font-size: Theme.fs-large;
                    font-weight: Theme.ui-weight;
                    overflow: elide;
                }
                if DjState.prev-meta != "": Label { text: DjState.prev-meta; tone: "dim"; overflow: elide; min-width: 0px; }
                if DjState.lib-grid-editing: Rectangle {
                    background: Theme.bg-deep;
                    border-width: 1px;
                    border-color: Theme.accent;
                    border-radius: Theme.r-panel;
                    VerticalLayout {
                        padding: Theme.s3;
                        spacing: Theme.s1;
                        Label { text: "GRID EDIT · " + (DjState.lib-grid-bpm + "") + " BPM · beat 1 at " + (DjState.lib-grid-first-beat + "") + " s · bar beat " + (DjState.lib-grid-downbeat + 1); tone: "accent"; }
                        Label { text: "← → offset 10 ms · ↑ ↓ tempo 0.1 · b beat 1 here · 1–4 bar beat · −/+ half/double · r reset · Enter save · Esc cancel"; tone: "faint"; small: true; wrap: word-wrap; }
                    }
                }
                // The cue keys: number and word where each lands, the one
                // used last in the accent.
                Rectangle {
                    height: 16px;
                    for m[i] in DjState.hud-marks: Text {
                        visible: m >= 0;
                        x: min(parent.width - self.preferred-width, max(0, parent.width * m - 3px));
                        y: 0px;
                        text: i == DjState.prev-cue ? (i + 1) + " " + DjState.prev-cue-word : i + 1;
                        color: i == DjState.prev-cue ? Theme.accent : Theme.text-dim;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-tiny;
                        font-weight: Theme.ui-weight;
                        letter-spacing: 0.6px;
                    }
                }
                // The waveform, large and clear: the track in the text
                // colour, the played part in the accent, the playhead white.
                wave := Rectangle {
                    height: root.short ? 56px : 96px;
                    background: Theme.bg-deep;
                    border-radius: 2px;
                    clip: true;
                    if DjState.prev-wave-rest.width > 0: Image {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        source: DjState.prev-wave-rest;
                        image-fit: fill;
                        colorize: Theme.text-dim;
                    }
                    if DjState.prev-wave-played.width > 0: Rectangle {
                        x: 0px; y: 0px; width: parent.width * hud.head; height: parent.height;
                        clip: true;
                        Image {
                            x: 0px; y: 0px; width: wave.width; height: parent.height;
                            source: DjState.prev-wave-played;
                            image-fit: fill;
                            colorize: Theme.accent;
                        }
                    }
                    if DjState.prev-wave-rest.width == 0: Text {
                        x: Theme.s3;
                        text: "Not analysed yet: no waveform";
                        color: Theme.text-faint;
                        font-family: Theme.font-ui;
                        font-size: Theme.fs-small;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    for part in DjState.prev-parts: Rectangle {
                        x: parent.width * part.from;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border-strong;
                    }
                    for m[i] in DjState.hud-marks: Rectangle {
                        visible: m >= 0;
                        x: parent.width * max(0, m) - 1px;
                        y: 0px;
                        width: i == DjState.prev-cue ? 2px : 1px;
                        height: parent.height;
                        background: i == DjState.prev-cue ? Theme.accent : Theme.text-dim;
                    }
                    // A soft line, not a hard one: it moves a few pixels a
                    // second, and an edge can only be drawn on whole pixels
                    // (femtovg: a plain Rectangle is not anti-aliased; a
                    // rounded one's anti-aliasing is uneven across a pixel,
                    // so it crept and stalled four times a second). The
                    // gradient is worked out at its exact place every frame
                    // and fades to nothing before its edges, so it glides.
                    if DjState.hud-state != "": Rectangle {
                        x: parent.width * hud.head - 4px;
                        y: 0px;
                        width: 8px;
                        height: parent.height;
                        background: @linear-gradient(90deg, Theme.text-bright.transparentize(1) 0%, Theme.text-bright 38%, Theme.text-bright 62%, Theme.text-bright.transparentize(1) 100%);
                    }
                }
                if DjState.prev-parts.length > 0: Rectangle {
                    height: 14px;
                    for part in DjState.prev-parts: Rectangle {
                        x: parent.width * part.from;
                        width: parent.width * (part.to - part.from);
                        height: parent.height;
                        clip: true;
                        if self.width > part.chars * 6.5px + 6px: Text {
                            x: 3px;
                            text: part.word;
                            color: hud.head >= part.from && hud.head < part.to && DjState.hud-state != "" ? Theme.text-bright : Theme.text-dim;
                            font-family: Theme.font-ui;
                            font-size: Theme.fs-tiny;
                            letter-spacing: 0.6px;
                        }
                    }
                }
                // The set prep: beside which tracks, and how each pair mixes.
                if DjState.prev-fit-title != "" && !root.short: Rectangle { height: 1px; background: Theme.border; }
                if DjState.prev-fit-title != "" && !root.short: Text {
                    text: "SET PREP · " + DjState.prev-fit-title;
                    color: Theme.text-dim;
                    font-family: Theme.font-ui;
                    font-size: Theme.fs-tiny;
                    font-weight: Theme.ui-weight;
                    letter-spacing: 0.8px;
                }
                if !root.short: VerticalLayout {
                    spacing: Theme.s1;
                    for f in DjState.prev-fits: HorizontalLayout {
                        spacing: Theme.s3;
                        VerticalLayout { alignment: center; Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            background: f.verdict == "good" ? Theme.accent : f.verdict == "ok" ? Theme.text-dim : transparent;
                            border-width: f.verdict == "far" ? 1px : 0px;
                            border-color: Theme.text-dim;
                        } }
                        Label { text: f.label; tone: "normal"; small: true; width: min(360px, parent.width * 0.4); overflow: elide; }
                        Label { text: f.detail; tone: f.verdict == "far" ? "dim" : "bright"; small: true; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                        Text {
                            text: f.verdict == "good" ? "mixes well" : f.verdict == "ok" ? "workable" : "hard mix";
                            color: f.verdict == "good" ? Theme.accent : Theme.text-dim;
                            font-family: Theme.font-ui;
                            font-size: Theme.fs-tiny;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// Light DJ: the everyday face of the DJ Booth. Same engine, same session,
// same decks: what plays, what comes next, the queue and auto-mix. Opening
// the Booth shows exactly this state; closing either changes nothing.
export component LightDjSurface inherits Rectangle {
    property <DeckItem> d: DjState.item(DjState.now-deck);
    property <bool> narrow: self.width < 460px;
    property <bool> short: self.height < 420px;
    init => { keys.focus(); }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (!DjState.key-guard(e.text)) { return reject; }
            if (e.text == " ") { DjState.light("play"); return accept; }
            if (e.text == "n") { DjState.light("next"); return accept; }
            if (e.text == "c") { DjState.light("cue"); return accept; }
            if (e.text == "o") { DjState.light("loop"); return accept; }
            if (e.text == "s") { DjState.light("sync"); return accept; }
            if (e.text == "m") { DjState.automix-toggle(); return accept; }
            if (e.text == "q") { DjState.queue-selected(); return accept; }
            if (e.text == "t" || e.text == "/") { say.start-edit(); return accept; }
            return reject;
        }
        VerticalLayout {
            padding: root.narrow ? Theme.s4 : Theme.s5;
            spacing: root.short ? Theme.s3 : Theme.s4;
            // Now playing
            HorizontalLayout {
                spacing: Theme.s4;
                VerticalLayout { alignment: start; DeckBadge { letter: DjState.now-deck == "b" ? "B" : "A"; lit: root.d.playing; } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Theme.s1;
                    Label { text: root.d.loaded ? root.d.title : "Nothing playing"; tone: "bright"; font-size: root.narrow || root.height < 820px ? Theme.fs-large * 1.2 : Theme.fs-title; overflow: elide; }
                    Label { text: root.d.loaded ? root.d.bpm + " BPM · " + root.d.key + " · " + root.d.time + " / " + root.d.length : "Queue tracks, or load one in the Library, and press play."; tone: "dim"; small: true; overflow: elide; }
                }
                if !root.narrow: VerticalLayout {
                    alignment: center;
                    Label { text: "−" + root.d.remaining; tone: "dim"; horizontal-alignment: right; }
                }
            }
            if root.d.loaded && !root.d.live: TapeRuler {
                has-wave: root.d.has-wave;
                wave-rest: root.d.wave-rest;
                wave-played: root.d.wave-played;
                phrases: root.d.phrases;
                cues: root.d.cues;
                loop-from: root.d.loop-from;
                loop-to: root.d.loop-to;
                loop-on: root.d.loop-on;
                progress: root.d.progress;
                duration-s: root.d.duration-s;
                labels: false;
                seek(f) => { DjState.seek-to(DjState.now-deck, f); }
            }
            // Transport
            HorizontalLayout {
                spacing: Theme.s2;
                Pad { height: Theme.row-h * 1.6; text: root.narrow ? (root.d.playing ? "Pause" : "Play") : (root.d.playing ? "Pause" : "Play"); icon: root.narrow ? "" : (root.d.playing ? "pause" : "play"); key: root.narrow ? "" : "space"; active: root.d.playing; show-label: true; horizontal-stretch: root.narrow ? 1 : 2; clicked => { DjState.light("play"); } }
                Pad { height: Theme.row-h * 1.6; text: "Cue"; icon: root.narrow ? "" : "cue"; key: root.narrow ? "" : "c"; show-label: true; clicked => { DjState.light("cue"); } }
                Pad { height: Theme.row-h * 1.6; text: root.narrow ? (root.d.loop-on ? "Loop on" : "Loop") : (root.d.loop-on ? "Loop on" : "Loop 4"); icon: ""; key: root.narrow ? "" : "o"; active: root.d.loop-on; show-label: true; clicked => { DjState.light("loop"); } }
                Pad { height: Theme.row-h * 1.6; text: root.d.synced ? "Synced" : "Sync"; icon: ""; key: root.narrow ? "" : "s"; active: root.d.synced; show-label: true; clicked => { DjState.light("sync"); } }
                Pad { height: Theme.row-h * 1.6; text: "Next"; icon: root.narrow ? "" : "fwd"; key: root.narrow ? "" : "n"; show-label: true; horizontal-stretch: root.narrow ? 1 : 2; clicked => { DjState.light("next"); } }
            }
            // Next and auto-mix
            HorizontalLayout {
                spacing: Theme.s3;
                Button { text: DjState.automix-on ? "Auto-mix ON" : "Auto-mix"; key: "m"; compact: true; primary: DjState.automix-on; clicked => { DjState.automix-toggle(); } }
                if !root.narrow: Button { text: "Build"; compact: true; lit: DjState.automix-dir == "build"; clicked => { DjState.automix-direct("build"); } }
                if !root.narrow: Button { text: "Hold"; compact: true; lit: DjState.automix-dir == "hold"; clicked => { DjState.automix-direct("hold"); } }
                if !root.narrow: Button { text: "Release"; compact: true; lit: DjState.automix-dir == "release"; clicked => { DjState.automix-direct("release"); } }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Label {
                        text: DjState.automix-next != "" ? DjState.automix-next : DjState.automix-note != "" ? DjState.automix-note : DjState.automix-on ? "Auto-mix waiting for a playing deck with a beat grid" : "";
                        tone: DjState.automix-next != "" ? "accent" : "faint";
                        small: true;
                        overflow: elide;
                        horizontal-alignment: right;
                    }
                    if DjState.plan-text != "": Label { text: DjState.plan-text; tone: "dim"; small: true; overflow: elide; horizontal-alignment: right; }
                }
            }
            // The AI DJ's set
            HorizontalLayout {
                spacing: Theme.s3;
                Button { text: DjState.set-on ? "Stop set" : "Start set"; compact: true; primary: DjState.set-on; clicked => { DjState.set-toggle(); } }
                VerticalLayout { alignment: center; horizontal-stretch: 1; Label { text: DjState.set-text; tone: DjState.set-on ? "bright" : "faint"; small: true; overflow: elide; } }
            }
            say := SearchField {
                prompt: "›";
                placeholder: "Tell the DJ: keep the energy up · more relaxed · around 126 · surprise me · next";
                accepted => { DjState.say(self.text); self.text = ""; keys.focus(); }
                cancelled => { self.text = ""; keys.focus(); }
            }
            if DjState.say-reply != "": Label { text: DjState.say-reply; tone: "accent"; small: true; overflow: elide; }
            if DjState.set-log.length > 0 && !root.short: VerticalLayout {
                spacing: Theme.s1;
                SectionHeading { text: "Set so far"; detail: DjState.set-log.length + " tracks"; pad: 0px; }
                for e in DjState.set-log: HorizontalLayout {
                    spacing: Theme.s3;
                    height: Theme.row-h - 4px;
                    Label { text: e.title; small: true; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    Label { text: e.detail; tone: "faint"; small: true; vertical-alignment: center; }
                }
            }
            // Queue
            if !root.short: SectionHeading { text: "Queue"; detail: DjState.queue.length == 0 ? "empty · q adds the Library's selected track" : DjState.queue.length + " tracks"; pad: 0px; }
            Scroll {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: Theme.s3;
                    padding-bottom: Theme.s2;
                    for it[i] in DjState.queue: HorizontalLayout {
                        spacing: Theme.s3;
                        height: Theme.row-h + 2px;
                        VerticalLayout { alignment: center; width: 22px; Label { text: i + 1; tone: "faint"; small: true; horizontal-alignment: right; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Label { text: it.title; tone: i == 0 ? "bright" : "normal"; overflow: elide; }
                        }
                        if !root.narrow: VerticalLayout { alignment: center; Label { text: it.detail; tone: "faint"; small: true; overflow: elide; } }
                        VerticalLayout { alignment: center; Button { text: "✕"; compact: true; clicked => { DjState.queue-remove(i); } } }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.s3;
                Button { text: "Queue selected"; key: "q"; compact: true; clicked => { DjState.queue-selected(); } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Label { text: "Booth"; tone: "dim"; small: true; } }
                VerticalLayout { alignment: center; width: root.narrow ? 90px : 160px; Slider { value: DjState.master; changed(v) => { DjState.set-master(v); } } }
                VerticalLayout { alignment: center; Label { text: DjState.master-text; tone: "dim"; small: true; width: 56px; horizontal-alignment: right; } }
            }
        }
    }
}
